---
import '../styles/global.css';
import NewsletterSignup from '../components/NewsletterSignup.astro';
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  mainClass?: string;
}
const { title, description, canonical, mainClass } = Astro.props;
const siteUrl = "https://backyardsaunapro.com";
const currentPath = Astro.url.pathname;
const navItems = [
  ["/reviews/", "Reviews"],
  ["/guides/", "Guides"],
  ["/brands/", "Brands"],
  ["/best-saunas/", "Best Picks"],
  ["/sauna-planner/", "Plan a Sauna"],
  ["/tools/sauna-electricity-cost-calculator/", "Cost Tool"],
  ["/about/", "About"],
];
const isCurrent = (href: string) => href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={`${siteUrl}${canonical.endsWith('/') ? canonical : canonical + '/'}`} />}
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Backyard Sauna Pro" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={`${siteUrl}${canonical.endsWith('/') ? canonical : canonical + '/'}`} />}
  <meta property="og:image" content={`${siteUrl}/og-default.jpg`} />
  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}/og-default.jpg`} />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="64x64" href="/favicon/favicon-64.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
  <!-- Amazon Associates disclosure required -->
  <meta name="amazon-associates-tag" content="backyardsauna-20" />
  <!-- Impact.com site verification -->
  <meta name="impact-site-verification" value="3e12ceae-af9e-40ba-b97d-b59f31175971" />
  <!-- Impact.com STAT Tag (Redwood Outdoors affiliate tracking) -->
  <script>(function(i,m,p,a,c,t){c.ire_o=p;c[p]=c[p]||function(){(c[p].a=c[p].a||[]).push(arguments)};t=a.createElement(m);var z=a.getElementsByTagName(m)[0];t.async=1;t.src=i;z.parentNode.insertBefore(t,z)})('https://utt.impactcdn.com/P-A7054478-bf47-4144-b607-61c6dfad44bf1.js','script','impactStat',document,window);impactStat('transformLinks');impactStat('trackImpression');</script>
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-0F814NTT5J"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function gtag(){window.dataLayer.push(arguments);};
    window.gtag('js', new Date());
    window.gtag('set', {
      site_name: 'backyard_sauna_pro',
      site_hostname: window.location.hostname,
    });
    window.gtag('config', 'G-0F814NTT5J', {
      page_location: window.location.href,
      page_path: window.location.pathname,
    });
    document.documentElement.dataset.analyticsReady = 'true';
  </script>
</head>
<body class="bg-stone-50 text-stone-800 font-sans">
  <!-- Header -->
  <header class="site-header sticky top-0 z-50 text-white px-5 md:px-8">
    <div class="max-w-7xl mx-auto h-[72px] flex justify-between items-center gap-8">
      <a href="/" class="site-brand flex items-center gap-2.5 transition-colors group" aria-label="Backyard Sauna Pro home">
        <img src="/images/brand/logo-icon.svg" alt="" class="w-10 h-10 rounded-full bg-white p-0.5" aria-hidden="true" />
        <span class="text-lg md:text-xl font-bold whitespace-nowrap">Backyard Sauna Pro</span>
      </a>
      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1 text-sm" aria-label="Primary navigation">
        {navItems.map(([href, label]) => (
          <a
            href={href}
            aria-current={isCurrent(href) ? "page" : undefined}
            class:list={["site-nav-link px-3 py-2 rounded-md transition-colors", label === "Plan a Sauna" && "site-nav-cta"]}
          >
            {label}
          </a>
        ))}
      </nav>
      <!-- Mobile hamburger -->
      <button id="menu-toggle" class="lg:hidden menu-toggle flex flex-col gap-1.5 p-2 rounded-md" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
        <span class="block w-6 h-0.5 bg-white"></span>
        <span class="block w-6 h-0.5 bg-white"></span>
        <span class="block w-6 h-0.5 bg-white"></span>
      </button>
    </div>
    <!-- Mobile nav drawer -->
    <nav id="mobile-menu" class="hidden lg:hidden flex-col max-w-7xl mx-auto border-t border-white/15 py-3" aria-label="Mobile navigation">
      {navItems.map(([href, label]) => (
        <a href={href} aria-current={isCurrent(href) ? "page" : undefined} class="site-mobile-link block py-3 text-sm transition-colors">
          {label}
        </a>
      ))}
    </nav>
  </header>
  <script>
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        menu.classList.toggle('hidden');
        menu.classList.toggle('flex');
        const isOpen = menu.classList.contains('flex');
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || menu.classList.contains('hidden')) return;
        menu.classList.add('hidden');
        menu.classList.remove('flex');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        toggle.focus();
      });
    }

    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
      if (!(link instanceof HTMLAnchorElement)) return;

      const destination = new URL(link.href, window.location.href);
      if (destination.hostname === window.location.hostname) return;

      const commerceHosts = {
        'amazon.com': { event: 'affiliate_click', partner: 'amazon' },
        'www.amazon.com': { event: 'affiliate_click', partner: 'amazon' },
        'sunhomesaunas.com': { event: 'affiliate_click', partner: 'sun_home' },
        'www.sunhomesaunas.com': { event: 'affiliate_click', partner: 'sun_home' },
        'selectsaunas.com': { event: 'affiliate_click', partner: 'select_saunas' },
        'www.selectsaunas.com': { event: 'affiliate_click', partner: 'select_saunas' },
        'redwoodoutdoors.com': { event: 'commerce_outbound_click', partner: 'redwood_outdoors' },
        'www.redwoodoutdoors.com': { event: 'commerce_outbound_click', partner: 'redwood_outdoors' },
        'finnishsaunabuilders.com': { event: 'dealer_outbound_click', partner: 'finnish_sauna_builders' },
        'www.finnishsaunabuilders.com': { event: 'dealer_outbound_click', partner: 'finnish_sauna_builders' },
      };
      const commerceLink = commerceHosts[destination.hostname];
      if (!commerceLink || typeof window.gtag !== 'function') return;

      window.gtag('event', commerceLink.event, {
        site_name: 'backyard_sauna_pro',
        site_hostname: window.location.hostname,
        partner: commerceLink.partner,
        link_url: destination.href,
        link_text: link.textContent?.trim().slice(0, 100) || '',
        page_path: window.location.pathname,
        page_type: window.location.pathname.includes('/guides/') ? 'guide' : window.location.pathname.includes('/reviews/') || window.location.pathname.includes('/brands/') ? 'commercial_review' : 'site_page',
        cta_position: link.dataset.ctaPosition || 'content',
        product_id: link.dataset.productId || '',
      });
    });

    document.addEventListener('submit', (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.matches('.kit-form')) return;

      const formLocation = form.dataset.formLocation || 'unknown';
      try {
        window.localStorage.setItem('bsp_newsletter_signup_pending', JSON.stringify({
          createdAt: Date.now(),
          formId: form.dataset.svForm || '',
        }));
      } catch {
        // Newsletter submission still works when browser storage is unavailable.
      }

      if (typeof window.gtag !== 'function') return;
      window.gtag('event', 'newsletter_signup', {
        site_name: 'backyard_sauna_pro',
        site_hostname: window.location.hostname,
        form_id: form.dataset.svForm || '',
        form_location: formLocation,
        page_path: window.location.pathname,
        signup_status: 'attempted',
      });
    });

    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest('a[data-track-event]') : null;
      if (!(link instanceof HTMLAnchorElement) || typeof window.gtag !== 'function') return;

      window.gtag('event', link.dataset.trackEvent, {
        site_name: 'backyard_sauna_pro',
        site_hostname: window.location.hostname,
        page_path: window.location.pathname,
        cta_position: link.dataset.ctaPosition || 'content',
        destination_type: link.protocol === 'mailto:' ? 'email' : 'link',
        link_url: link.href,
        link_text: link.textContent?.trim().slice(0, 100) || '',
        campaign: new URL(link.href, window.location.href).searchParams.get('utm_campaign') || '',
      });
    });
  </script>

  <!-- Main -->
  <main class={mainClass || "max-w-5xl mx-auto px-6 py-10"}>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer text-sm px-6 md:px-8 mt-16">
    <div class="max-w-7xl mx-auto py-10 md:py-14">
      <NewsletterSignup />
      <nav class="footer-nav flex flex-wrap gap-x-6 gap-y-3 mb-7 text-stone-200">
        <a href="/reviews/" class="hover:text-white transition-colors">Reviews</a>
        <a href="/guides/" class="hover:text-white transition-colors">Guides</a>
        <a href="/brands/" class="hover:text-white transition-colors">Brands</a>
        <a href="/best-saunas/" class="hover:text-white transition-colors">Best Picks</a>
        <a href="/guides/best-outdoor-sauna-of-2026/" class="hover:text-white transition-colors">Outdoor Saunas</a>
        <a href="/guides/best-infrared-sauna-of-2026/" class="hover:text-white transition-colors">Infrared Saunas</a>
        <a href="/about/" class="hover:text-white transition-colors">About</a>
        <a href="/how-we-review/" class="hover:text-white transition-colors">How We Review</a>
        <a href="/newsletter/" class="hover:text-white transition-colors">Newsletter</a>
        <a href="/partners/" class="hover:text-white transition-colors">Partners</a>
        <a href="/contact/" class="hover:text-white transition-colors">Contact</a>
      </nav>
      <p class="footer-disclosure mb-3 pt-6 border-t border-white/10">
        <strong class="text-stone-300">Affiliate Disclosure:</strong> BackyardSaunaPro.com is a participant in the Amazon Services LLC Associates Program, an affiliate advertising program designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.com. As an Amazon Associate I earn from qualifying purchases.
      </p>
      <p>© {new Date().getFullYear()} Backyard Sauna Pro · <a href="/privacy/" class="underline hover:text-white">Privacy Policy</a> · <a href="/affiliate-disclosure/" class="underline hover:text-white">Affiliate Disclosure</a></p>
    </div>
  </footer>
</body>
</html>
