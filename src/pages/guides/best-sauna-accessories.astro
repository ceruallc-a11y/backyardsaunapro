---
import Base from '../../layouts/Base.astro';
import AmazonButton from '../../components/AmazonButton.astro';

const accessoryGroups = [
  {
    title: "Buy after you confirm compatibility",
    intro: "These can be useful, but your sauna type and manufacturer instructions decide whether they belong in your setup.",
    items: [
      {
        asin: "B07FKQB3LB",
        name: "Wooden bucket and ladle",
        desc: "Useful for a traditional heater that permits water on the stones. Skip this for infrared cabins and any heater whose manual says not to add water.",
        check: "Check the heater manual, bucket capacity, handle length, liner material, and return policy.",
      },
      {
        asin: "B0BC8QMSKG",
        name: "Separate thermometer and hygrometer",
        desc: "Helpful when the built-in controls do not show the information you want or when you want a second reference point inside the room.",
        check: "Follow the sauna or gauge maker's placement instructions. Do not treat a consumer gauge as a substitute for the heater's safety controls.",
      },
      {
        asin: "B01N9SE8SZ",
        name: "Mechanical sand timer",
        desc: "A simple visual reminder for people who prefer not to bring a phone into the sauna. It is a convenience item, not a prescription for session length.",
        check: "Mount only where the timer and sauna manufacturer allow. Leave if you feel unwell, regardless of the timer.",
      },
    ],
  },
  {
    title: "Comfort upgrades",
    intro: "Comfort is personal. Measure first, then choose one upgrade that solves a problem you have actually noticed.",
    items: [
      {
        asin: "B0DWTCK8X9",
        name: "Cedar sauna backrest",
        desc: "Creates a gap between your back and the wall. This can make upright seating more comfortable without adding a loose cushion.",
        check: "Compare width, height, curve, slat spacing, wood species, and the bench depth available in your sauna.",
        guide: "/guides/best-sauna-backrest/",
        guideLabel: "Read the sauna backrest guide",
      },
      {
        asin: "B07YCQ4TCZ",
        name: "Wooden headrest",
        desc: "Useful if you recline and need neck support. A headrest that is too tall or wide can be less comfortable than no headrest at all.",
        check: "Measure the intended position and check the maker's cleaning and heat-use instructions.",
      },
      {
        asin: "B079N9NXBH",
        name: "Washable bench textile",
        desc: "A towel or sauna-compatible textile can keep skin off a hot bench and simplify cleanup. Start with something easy to wash before buying a fitted set.",
        check: "Confirm the fabric, care instructions, dimensions, and temperature limits. Remove and dry it after use.",
      },
    ],
  },
  {
    title: "Optional ritual and care items",
    intro: "These are not day-one requirements. Add them only when the use instructions fit your sauna and your routine.",
    items: [
      {
        asin: "B07CZ4NN1P",
        name: "Sauna scent concentrate",
        desc: "Adds fragrance when both the product directions and your heater manual permit it.",
        check: "Follow the dilution instructions. Never put oil or concentrate directly on heating elements or stones unless the manufacturer explicitly allows that method.",
      },
      {
        asin: "B07PXGQC9T",
        name: "Birch sauna whisk (vihta or vasta)",
        desc: "A traditional optional accessory for people who want that specific sauna ritual. It is not necessary for ordinary sauna use.",
        check: "Follow the seller's soaking, storage, and disposal directions. Avoid irritated or broken skin.",
      },
      {
        asin: "B07MJDFHKG",
        name: "Sauna wood cleaner",
        desc: "Useful only when the cleaner is approved for your sauna's wood and finish. Routine drying and light cleaning may be all your manufacturer recommends.",
        check: "Use the sauna maker's care instructions first. Spot-test any approved product and never mix cleaners.",
      },
    ],
  },
];
---
<Base
  title="Best Sauna Accessories for Beginners (2026): Buy by Sauna Type"
  description="A practical sauna accessory guide for beginners: what every owner needs, what depends on sauna type, and what to skip until compatibility is confirmed."
  canonical="/guides/best-sauna-accessories"
>
  <article class="max-w-3xl mx-auto">
    <header class="mb-8">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Buying Guides</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-4">
        Sauna accessories for beginners: what you actually need
      </h1>
      <p class="text-stone-500 text-sm">Reviewed August 15, 2026 &middot; 8 min read</p>
      <p class="text-lg text-stone-600 mt-4">
        Most new owners need fewer accessories than a shopping list suggests. Start with the items required by your sauna manual, then add one comfort or ritual item at a time. A traditional heater, infrared cabin, and portable steam tent do not use the same gear.
      </p>
    </header>

    <div class="rounded-xl overflow-hidden mb-8">
      <img src="/images/lifestyle/sauna-rocks-bucket.jpg" alt="Wooden sauna bucket and ladle beside heater stones" class="w-full object-cover max-h-80" loading="eager" width="1200" height="800" />
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8 text-sm text-stone-700">
      <strong>Research scope:</strong> This is a desk-researched buying guide, not a hands-on product test. We checked current commerce routes on August 15, 2026. Listings, sellers, and availability can change. Confirm every accessory against the instructions for your exact sauna, heater, and controller.
    </div>

    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4 text-stone-900">Buy in this order</h2>
      <div class="overflow-x-auto border border-stone-200 rounded-xl">
        <table class="w-full text-left text-sm min-w-[620px]">
          <thead class="bg-stone-100 text-stone-900">
            <tr>
              <th class="px-4 py-3 font-semibold">Priority</th>
              <th class="px-4 py-3 font-semibold">What belongs here</th>
              <th class="px-4 py-3 font-semibold">Why</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-200 text-stone-700">
            <tr>
              <td class="px-4 py-3 font-semibold text-stone-900">1. Required</td>
              <td class="px-4 py-3">The manual, clean drinking water, and a clean towel or bench cover</td>
              <td class="px-4 py-3">These support correct operation, hydration, and basic hygiene without assuming a sauna type.</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-semibold text-stone-900">2. Conditional</td>
              <td class="px-4 py-3">Bucket, gauge, timer, backrest, or headrest</td>
              <td class="px-4 py-3">Buy only after checking the heater rules, controls, dimensions, and your actual comfort needs.</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-semibold text-stone-900">3. Later</td>
              <td class="px-4 py-3">Scents, specialty textiles, vihta, lighting, and decorative accessories</td>
              <td class="px-4 py-3">These can improve a routine, but none should delay safe setup or replace required equipment.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <div class="bg-stone-50 border border-stone-200 rounded-xl p-5 mb-10 text-sm text-stone-700">
      <strong>Affiliate disclosure:</strong> As an Amazon Associate I earn from qualifying purchases. Exact-product buttons open a listing we found available during the latest review. Comparison buttons open a category search because individual sellers and products change.
    </div>

    {accessoryGroups.map((group) => (
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-2 text-stone-900">{group.title}</h2>
        <p class="text-stone-600 mb-5">{group.intro}</p>
        <div class="space-y-5">
          {group.items.map((item) => (
            <div class="bg-white border border-stone-200 rounded-xl p-5 shadow-sm">
              <h3 class="text-lg font-semibold text-stone-900 mb-2">{item.name}</h3>
              <p class="text-stone-600 text-sm mb-2">{item.desc}</p>
              <p class="text-stone-700 text-sm mb-4"><strong>Before buying:</strong> {item.check}</p>
              <div class="flex flex-wrap gap-3 items-center">
                <AmazonButton asin={item.asin} variant="small" ctaPosition="accessory_guide" />
                {item.guide && (
                  <a href={item.guide} class="text-sm font-semibold text-amber-800 hover:text-amber-900 underline underline-offset-4">
                    {item.guideLabel} &rarr;
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="bg-red-50 border border-red-200 rounded-xl p-6 mt-4">
      <h2 class="text-2xl font-bold mb-4 text-stone-900">What not to buy yet</h2>
      <ul class="text-stone-700 text-sm space-y-3">
        <li><strong>A consumer smart plug or timer for the heater:</strong> Never use one unless the exact heater or controller manufacturer explicitly supports it. High-load or hardwired controls belong with the specified equipment and a qualified electrician.</li>
        <li><strong>Random replacement stones:</strong> Use only the type and size approved for your heater. Incorrect stones can block airflow or damage equipment.</li>
        <li><strong>Generic oils for the heater:</strong> Do not pour oils directly on elements or stones. Follow both the fragrance and heater instructions.</li>
        <li><strong>Unverified lights, coatings, or hardware:</strong> Sauna heat and moisture change what is suitable. Use the sauna maker's specifications and applicable electrical requirements.</li>
      </ul>
      <a href="/guides/best-sauna-lighting/" class="inline-block mt-5 text-sm font-semibold text-amber-800 hover:text-amber-900 underline underline-offset-4">
        Plan sauna lighting safely &rarr;
      </a>
    </section>

    <div class="bg-stone-800 text-white rounded-xl p-6 text-center mt-12">
      <h2 class="text-xl font-bold mb-2">Still choosing the sauna itself?</h2>
      <p class="text-stone-300 mb-4">Compare the main sauna formats before buying accessories that may not fit.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/best-saunas/" class="inline-flex min-h-11 items-center bg-amber-400 hover:bg-amber-500 text-stone-900 font-semibold px-6 py-3 rounded-lg transition-colors">Compare sauna types &rarr;</a>
        <a href="/guides/sauna-gift-ideas/" class="inline-flex min-h-11 items-center border border-stone-500 px-6 py-3 rounded-lg font-semibold text-white hover:border-stone-300">Browse sauna gift ideas</a>
      </div>
    </div>
  </article>
</Base>
