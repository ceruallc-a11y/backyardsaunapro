    bestFor: "Renters, travelers, athletes using it as a supplemental tool, or buyers in tight spaces who want to try infrared before spending four figures.",
    avoidIf: "You want a real sauna experience, sitting upright with the door closed and the heat surrounding your whole body.",
    specs: {
      type: "Portable tent-style infrared",
      capacity: "1 person",
      heatSource: "Far-infrared panels inside a fabric enclosure",
      maxTemp: "Around 150 °F",
      electrical: "120V standard outlet",
      dimensions: "Approximately 31 x 27 x 38 in seated",
      warranty: "1 yr limited",
