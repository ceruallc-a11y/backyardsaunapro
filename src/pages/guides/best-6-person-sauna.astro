---
import Base from '../../layouts/Base.astro';
import AdvertiserDisclosure from '../../components/AdvertiserDisclosure.astro';
import PlannerCTA from '../../components/PlannerCTA.astro';
import SelectSaunasButton from '../../components/SelectSaunasButton.astro';

const reviewedAt = 'August 15, 2026';

const picks = [
  {
    label: 'Indoor traditional path',
    name: 'Almost Heaven Bridgeport 6-Person Indoor Sauna',
    reviewedPrice: '$5,993',
    href: 'https://selectsaunas.com/products/almost-heaven-bridgeport-braxton-6-person-indoor-traditional-sauna',
    fit: 'A buyer with an indoor room, a suitable finished floor, and a path for an 850-pound shipment plus the specified hardwired heater service.',
    facts: ['Up to six people (published)', '86 x 63 x 78-inch exterior', '81 x 58 x 77-inch interior', '81 x 22-inch upper bench', '8kW heater; 240V / 40A hardwired service'],
    questions: ['Will six intended users fit the published bench layout?', 'Can the floor, room, doorway, and delivery route handle the package?', 'Which lumber, heater, lead time, assembly scope, and warranty terms are in the final order?'],
  },
  {
    label: 'Outdoor barrel path',
    name: 'SaunaLife E8 6-Person Barrel Sauna',
    reviewedPrice: '$6,940',
    href: 'https://selectsaunas.com/products/saunalife-model-e8-sauna-barrel-6-person-ergo-series-sauna-barrel-87x-81-ready-to-ship',
    fit: 'An outdoor buyer who wants a current six-person barrel listing and is ready to define the heater, base, power or chimney, freight, and assembly as a complete project.',
    facts: ['Up to six bathers (published)', '87-inch length and 81-inch diameter', '78.5-inch interior length and 77-inch interior diameter', 'Thermo-Spruce shell and Thermo-Aspen seating', 'Shingle roof kit and dual floor drains listed'],
    questions: ['Which heater, controls, stones, and guard are included in the selected package?', 'What unloading equipment and assembly help are required?', 'What base, roof details, drainage, clearances, power, and permits apply to the site?'],
  },
  {
    label: 'Outdoor cabin path',
    name: 'Almost Heaven Timberline 6-Person Outdoor Cabin Sauna',
    reviewedPrice: '$10,199',
    href: 'https://selectsaunas.com/products/almost-heaven-timberline-6-person-outdoor-cabin-sauna',
    fit: 'A buyer who values a cabin layout, multi-level benches, and a covered porch enough to accept a larger site, shipment, and project scope.',
    facts: ['Four to six people (published)', '75 x 70 x 88-inch interior', '75 x 36-inch upper bench and 75 x 18-inch lower bench', 'Standard KIP80B listing: 8kW, 240V / 40A hardwired', 'Roofing shingles are not included'],
    questions: ['Does the four-to-six-person bench layout work for the intended group?', 'Who supplies roofing, base work, unloading, assembly, and electrical service?', 'Is the electric or wood-burning configuration documented in the final quote?'],
  },
  {
    label: 'Made-to-order cedar path',
    name: 'Dundalk Leisurecraft Tranquility MP 2-6 Person Barrel Sauna',
    reviewedPrice: '$8,220',
    href: 'https://selectsaunas.com/products/dundalk-leisurecraft-tranquility-mp-barrel-sauna',
    fit: 'A buyer who wants an Eastern White Cedar barrel with panoramic windows and is comfortable confirming a made-to-order package with the dealer.',
    facts: ['Two to six people (published)', 'Eastern White Cedar construction', 'Panoramic bronze-tempered-glass windows and door', 'Front porch and removable cedar floor listed', 'Heater and rocks are not included in the base kit'],
    questions: ['Which exact heater, controls, rocks, roof, and accessories should be quoted?', 'What dimensions and bench lengths apply to the selected configuration?', 'Which warranty, freight, installation, and service terms will be written into the order?'],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How big is a 6-person sauna?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'There is no single six-person footprint. Current examples range from the Bridgeport indoor room at 86 by 63 inches outside to the Timberline outdoor cabin at 128 by 112 inches with its porch. Compare interior and bench dimensions, not capacity alone.',
      },
    },
    {
      '@type': 'Question',
      name: 'What heater does a 6-person sauna need?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Use the exact room and heater manuals. The current Bridgeport and Timberline listings specify an 8kW heater with 240V and 40A hardwired service. Other six-person models and glass-heavy or cold-climate configurations may differ.',
      },
    },
    {
      '@type': 'Question',
      name: 'Will six adults be comfortable in a 6-person sauna?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A six-person label is a published maximum, not a comfort guarantee. Compare usable bench length, bench depth, seating levels, door clearance, and the intended users before ordering.',
      },
    },
  ],
};
---
<Base
  title="Best 6-Person Saunas (2026): Current Model Shortlist"
  description="Compare current 6-person indoor rooms, outdoor barrels, and outdoor cabins using exact listings, published dimensions, electrical requirements, and project-scope questions."
  canonical="/guides/best-6-person-sauna"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-4xl mx-auto">
    <header class="max-w-3xl mb-8">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Capacity Buying Guide</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-4">Best 6-Person Saunas</h1>
      <p class="text-stone-500 text-sm">Listings reviewed {reviewedAt} · 10 min read</p>
      <p class="text-lg text-stone-700 mt-4">At six-person scale, the product is only one part of the purchase. Bench geometry, heater configuration, freight, unloading, base work, power or chimney scope, and assembly can decide whether the project works.</p>
    </header>

    <AdvertiserDisclosure />

    <div class="rounded-lg overflow-hidden mb-8">
      <img src="/images/lifestyle/sauna-cabins-outdoor.jpg" alt="Representative large outdoor cabin sauna" class="w-full object-cover max-h-80" loading="lazy" width="1200" height="800" />
    </div>

    <aside class="border-y border-stone-200 py-6 mb-8">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">Six people is a bench question</h2>
      <p class="text-stone-700 mb-3">Capacity labels usually describe maximum seated occupancy. They do not promise elbow room, lie-down space, equal access to the upper bench, or a comfortable door path.</p>
      <p class="text-sm text-stone-600">Prices below are retailer snapshots from {reviewedAt}. Confirm stock, configuration, freight, tax, lead time, and final price before ordering.</p>
    </aside>

    <PlannerCTA source="best_6_person_sauna_above_fold" heading="Scope the six-person project before requesting quotes" />

    <section class="mt-12" aria-labelledby="six-person-shortlist">
      <h2 id="six-person-shortlist" class="text-3xl font-bold text-stone-900 mb-3">Four current model paths</h2>
      <p class="text-stone-600 max-w-3xl mb-8">These are not arbitrary rankings. Each model represents a different location, construction, and delivery decision.</p>

      <div class="space-y-10">
        {picks.map((pick) => (
          <section class="border-t border-stone-300 pt-7" aria-label={pick.name}>
            <div class="md:flex md:items-start md:justify-between gap-6 mb-4">
              <div>
                <p class="text-xs font-bold uppercase tracking-wide text-amber-700 mb-2">{pick.label}</p>
                <h3 class="text-2xl font-bold text-stone-900">{pick.name}</h3>
              </div>
              <p class="text-sm text-stone-600 mt-2 md:mt-1 shrink-0">Listed at review: <strong class="text-stone-900">{pick.reviewedPrice}</strong></p>
            </div>

            <p class="text-stone-700 mb-5"><strong>Who it may fit:</strong> {pick.fit}</p>

            <div class="grid md:grid-cols-2 gap-6 mb-5">
              <div>
                <h4 class="font-semibold text-stone-900 mb-2">Documented listing details</h4>
                <ul class="space-y-2 text-sm text-stone-700">
                  {pick.facts.map((fact) => <li class="flex gap-2"><span aria-hidden="true">+</span><span>{fact}</span></li>)}
                </ul>
              </div>
              <div>
                <h4 class="font-semibold text-stone-900 mb-2">Resolve before buying</h4>
                <ul class="space-y-2 text-sm text-stone-700">
                  {pick.questions.map((item) => <li class="flex gap-2"><span aria-hidden="true">-</span><span>{item}</span></li>)}
                </ul>
              </div>
            </div>

            <SelectSaunasButton href={pick.href} label="Check current listing" ctaPosition="best_6_person_shortlist" />
          </section>
        ))}
      </div>
    </section>

    <div class="border-t border-stone-300 pt-7 mt-10">
      <div class="border border-stone-200 rounded-xl p-5 bg-white">
        <div class="flex items-start justify-between mb-2">
          <div>
            <span class="text-xs font-semibold text-stone-600 bg-stone-100 px-2 py-0.5 rounded-full uppercase tracking-wide">Infrared</span>
            <h3 class="text-xl font-bold text-stone-900 mt-1">Sun Home Equinox (large infrared cabin)</h3>
          </div>
        </div>
        <p class="text-stone-600 mb-4">Honest caveat: infrared scales poorly past four people. To genuinely heat six bodies, you need a wall of emitters on every panel, which pushes the price into traditional-sauna territory without delivering traditional-sauna heat. That said, if a 240V circuit is impossible (apartment, basement, rental), large infrared cabins like the Sun Home Equinox are the practical workaround. Pros: easier electrical, faster warmup, indoor-friendly. Cons: no real loyly, lower top temperature (120-140°F vs 170-195°F traditional), expensive at this capacity, and the heater count starts to feel excessive.</p>
        <p class="text-stone-400 text-xs italic">Available direct from Sun Home Saunas</p>
      </div>
    </div>

    <section class="mt-14 border-t border-stone-300 pt-8">
      <h2 class="text-2xl font-bold text-stone-900 mb-4">The project checks that matter most</h2>
      <div class="grid md:grid-cols-2 gap-6 text-sm text-stone-700">
        <div>
          <h3 class="font-bold text-stone-900 mb-2">Bench and entry</h3>
          <p>Compare usable bench lengths, depths, levels, heater clearances, door width, and the actual body sizes and seating positions you expect.</p>
        </div>
        <div>
          <h3 class="font-bold text-stone-900 mb-2">Heater and ventilation</h3>
          <p>Use the selected room and heater manuals. Glass area, room volume, construction, clearances, ventilation, and climate can change the requirement.</p>
        </div>
        <div>
          <h3 class="font-bold text-stone-900 mb-2">Freight and site access</h3>
          <p>Get the package dimensions, shipment weight, unloading method, carry path, damage process, and assembly scope in writing.</p>
        </div>
        <div>
          <h3 class="font-bold text-stone-900 mb-2">Base, power, and approvals</h3>
          <p>Confirm the final base plan, drainage, roofing, electrical or chimney work, property clearances, and local permit or inspection requirements.</p>
        </div>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-stone-900 mb-5">Frequently asked questions</h2>
      <div class="divide-y divide-stone-200 border-y border-stone-200">
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">How big is a 6-person sauna?</h3><p class="text-stone-700 text-sm">There is no universal size. The Bridgeport indoor room is listed at 86 by 63 inches outside. The Timberline cabin reaches 128 by 112 inches with its porch. Compare the exact model and bench layout.</p></div>
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">What heater does a 6-person sauna need?</h3><p class="text-stone-700 text-sm">The manual decides. The current Bridgeport and Timberline listings specify an 8kW heater with 240V / 40A hardwired service. Do not transfer that requirement to another model without checking its room and heater documents.</p></div>
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">Will six adults be comfortable?</h3><p class="text-stone-700 text-sm">A published six-person maximum does not guarantee comfort. Compare bench length, depth, levels, door clearance, and the intended users before buying.</p></div>
      </div>
    </section>

    <div class="bg-stone-900 text-white rounded-lg p-6 md:p-8 mt-12">
      <h2 class="text-2xl font-bold mb-2">Estimate the installed project</h2>
      <p class="text-stone-300 mb-5">Separate the sauna price from freight, unloading, foundation, electrical or chimney work, assembly, roofing, permits, and accessories.</p>
      <a href="/tools/sauna-cost-calculator/?ref=best_6_person&campaign=project_budget&placement=best_6_person_project_budget" class="inline-flex min-h-12 items-center justify-center bg-amber-400 hover:bg-amber-500 text-stone-900 font-semibold px-6 py-3 rounded-md transition-colors" data-track-event="calculator_cta_clicked" data-cta-position="best_6_person_project_budget">Open the project calculator</a>
    </div>

    <div class="bg-stone-50 border border-stone-200 rounded-lg p-6 mt-10">
      <h2 class="text-lg font-bold text-stone-900 mb-2">Related guides</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/guides/best-5-person-sauna/" class="text-amber-700 hover:underline">Best 5-Person Sauna</a></li>
        <li><a href="/guides/best-4-person-sauna/" class="text-amber-700 hover:underline">Best 4-Person Sauna</a></li>
        <li><a href="/guides/sauna-heater-sizing-guide/" class="text-amber-700 hover:underline">Sauna Heater Sizing Guide</a></li>
        <li><a href="/guides/sauna-foundation-guide/" class="text-amber-700 hover:underline">Sauna Foundation Guide</a></li>
      </ul>
    </div>
  </article>
</Base>
