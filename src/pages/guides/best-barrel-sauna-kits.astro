---
import Base from '../../layouts/Base.astro';
import AdvertiserDisclosure from '../../components/AdvertiserDisclosure.astro';
import PlannerCTA from '../../components/PlannerCTA.astro';
import SelectSaunasButton from '../../components/SelectSaunasButton.astro';

const reviewedAt = 'August 15, 2026';

const options = [
  {
    label: 'Shorter Thermo-Spruce barrel',
    name: 'SaunaLife E6 3-Person Barrel Sauna',
    retailerHref: 'https://selectsaunas.com/products/saunalife-model-e6-sauna-barrel-ergo-series-sauna-barrel-59x81?sca_ref=10752576.S2huPg7gFg',
    manufacturerHref: 'https://saunalife.com/saunas/ergo-series-model-e6/',
    fit: 'A buyer who wants a shorter room length, contoured seating, a listed shingle kit, and a manufacturer-published installation system.',
    facts: [
      'Published capacity: up to three people',
      'Manufacturer dimensions: 81-inch diameter by 59-inch length',
      'Thermo-Spruce staves with Thermo-Aspen benches and backrests',
      'Published bench depth: 17.8 inches',
      'Manufacturer-listed shipment weight: 1,103 pounds',
      'Dual floor drains, intake and exhaust vents, roof-shingle kit, and heater guard are listed with the room',
    ],
    questions: [
      'Which heater, controls, stones, guard, power, and commissioning work are included in the selected configuration?',
      'Can the delivery path, unloading equipment, base, and crew support the listed shipment and assembly sequence?',
      'Does the complete exterior envelope fit after local setbacks, drainage, clearances, roof access, and door approach?',
    ],
  },
  {
    label: 'Longer Eastern White Cedar barrel',
    name: 'Dundalk LeisureCraft Harmony CTC22W',
    retailerHref: 'https://selectsaunas.com/products/canadian-timber-harmony-barrel-sauna?sca_ref=10752576.S2huPg7gFg',
    manufacturerHref: 'https://leisurecraft.com/ct-barrel-sauna',
    fit: 'A buyer who values two 71-inch benches, a 79-inch room length, and a Canadian-made Eastern White Cedar kit with multiple heater paths.',
    facts: [
      'Manufacturer model: CTC22W Harmony',
      'Published capacity: two to four people',
      'Official drawing shows a 79-inch room length and 86.25-inch outside diameter',
      'Official drawing shows two benches measuring 71 inches long by 20 inches deep',
      'Eastern White Cedar room with aluminum bands and stainless-steel tightening hardware',
      'The product documentation lists heater selection as a required configuration choice',
    ],
    questions: [
      'Which electric or wood-heater package is permitted for the site, and what components remain outside the room quote?',
      'What freight access, appointment, unloading, crate handling, and damage-inspection duties belong to the buyer?',
      'Which base, roof, drainage, finish, maintenance, and warranty requirements apply to the ordered configuration?',
    ],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does a barrel sauna kit include?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Contents vary by model and configuration. Confirm the room structure, benches, door, bands, fasteners, vents, roof system, drains, lighting, heater, controls, stones, guard, electrical or chimney components, freight, and installation scope in the written quote.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long does a barrel sauna kit take to assemble?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Use the manufacturer estimate and installation manual for the exact model. Assembly time does not include every project task, such as delivery, unloading, base preparation, electrical or chimney work, permits, inspection, weather finishing, and commissioning.',
      },
    },
    {
      '@type': 'Question',
      name: 'How should I size a barrel sauna heater?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Follow the room and heater manufacturers. Account for the actual interior volume, glass and other uninsulated surfaces, climate, power or chimney requirements, and the exact approved heater range. Do not size a heater from the advertised seating capacity alone.',
      },
    },
  ],
};
---
<Base
  title="Best Barrel Sauna Kits: Two Current Formats"
  description="Compare two current barrel sauna kits using exact dimensions, bench layout, materials, shipment details, and the project scope each buyer must confirm."
  canonical="/guides/best-barrel-sauna-kits"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-4xl mx-auto">
    <header class="max-w-3xl mb-8">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Barrel sauna buying guide</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-4">Best Barrel Sauna Kits</h1>
      <p class="text-stone-500 text-sm">Manufacturer and retailer information reviewed {reviewedAt} · 10 min read</p>
      <p class="text-lg text-stone-700 mt-4">A barrel kit is not one standardized package. Dimensions, bench depth, roof protection, drains, heater scope, freight, unloading, and required site work change by model. Compare the written bill of materials and complete project scope before comparing sticker prices.</p>
    </header>

    <AdvertiserDisclosure />

    <figure class="rounded-lg overflow-hidden mb-8">
      <img src="/images/lifestyle/barrel-sauna-field.jpg" alt="Representative outdoor barrel sauna on a prepared site" class="w-full object-cover max-h-80" loading="eager" width="1200" height="800" />
      <figcaption class="text-xs text-stone-500 mt-2">Representative barrel sauna setting. It is not a photo of either exact model compared below.</figcaption>
    </figure>

    <aside class="border-y border-stone-200 py-6 mb-8">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">Start with comfort and scope</h2>
      <p class="text-stone-700 mb-3">Length affects usable bench room. Diameter affects headroom, door height, and seating geometry. The model with the larger capacity label is not automatically more comfortable, and the lower room price is not automatically the lower installed cost.</p>
      <p class="text-sm text-stone-600">We have not personally tested these kits. Specifications are manufacturer-published. Confirm the exact configuration, current price, stock or lead time, warranty, freight, and installation requirements before ordering.</p>
    </aside>

    <PlannerCTA source="barrel_kits_above_fold" heading="Turn the kit into a real project scope" description="Build a free project brief with the site, delivery access, base, heater preference, utilities, budget, and timeline before requesting quotes." />

    <section class="mt-12" aria-labelledby="barrel-options">
      <h2 id="barrel-options" class="text-3xl font-bold text-stone-900 mb-3">Two useful current formats</h2>
      <p class="text-stone-600 max-w-3xl mb-8">These are comparison starting points, not arbitrary rankings. One prioritizes shorter length and a bundled roof system. The other prioritizes longer benches and a cedar-room format.</p>

      <div class="space-y-10">
        {options.map((option) => (
          <section class="border-t border-stone-300 pt-7" aria-label={option.name}>
            <p class="text-xs font-bold uppercase tracking-wide text-amber-700 mb-2">{option.label}</p>
            <h3 class="text-2xl font-bold text-stone-900 mb-3">{option.name}</h3>
            <p class="text-stone-700 mb-5"><strong>Who it may fit:</strong> {option.fit}</p>

            <div class="grid md:grid-cols-2 gap-7">
              <div>
                <h4 class="font-bold text-stone-900 mb-3">Documented kit details</h4>
                <ul class="space-y-2 text-sm text-stone-700">
                  {option.facts.map((fact) => <li class="flex items-start gap-2"><span class="text-emerald-700" aria-hidden="true">+</span><span>{fact}</span></li>)}
                </ul>
              </div>
              <div>
                <h4 class="font-bold text-stone-900 mb-3">Resolve before buying</h4>
                <ul class="space-y-2 text-sm text-stone-700">
                  {option.questions.map((question) => <li class="flex items-start gap-2"><span class="text-amber-700" aria-hidden="true">-</span><span>{question}</span></li>)}
                </ul>
              </div>
            </div>

            <div class="mt-5 flex flex-wrap items-center gap-4">
              <SelectSaunasButton href={option.retailerHref} label={`Check the current ${option.name.includes('E6') ? 'E6' : 'Harmony'} listing`} ctaPosition="barrel_kit_shortlist" />
              <a href={option.manufacturerHref} target="_blank" rel="noopener" class="text-sm font-semibold text-amber-700 hover:underline">Review manufacturer information</a>
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="mt-12 border-t border-stone-300 pt-8" aria-labelledby="quote-checklist">
      <h2 id="quote-checklist" class="text-3xl font-bold text-stone-900 mb-6">What the written quote should answer</h2>
      <div class="grid md:grid-cols-2 gap-x-8 gap-y-7 text-stone-700">
        <div>
          <h3 class="font-bold text-stone-900 mb-2">Room and weather package</h3>
          <p>Confirm every wall, stave, cradle, band, fastener, door, bench, backrest, floor grid, vent, drain, roof component, exterior finish, lighting part, and maintenance item.</p>
        </div>
        <div>
          <h3 class="font-bold text-stone-900 mb-2">Heater and controls</h3>
          <p>Record the exact heater model, output, controls, stones, guard, sensor, power or chimney system, approved clearances, and who supplies and installs each piece.</p>
        </div>
        <div>
          <h3 class="font-bold text-stone-900 mb-2">Freight and unloading</h3>
          <p>Ask for crate dimensions and weight, carrier service level, delivery appointment, road and driveway limits, liftgate availability, unloading responsibility, inspection procedure, and damage deadline.</p>
        </div>
        <div>
          <h3 class="font-bold text-stone-900 mb-2">Site and assembly</h3>
          <p>Price the base, drainage, setbacks, access, permits, assembly crew, tools, electrical or chimney work, weather treatment, inspections, and startup. A room-only quote is not a project budget.</p>
        </div>
      </div>
    </section>

    <section class="mt-12 border-t border-stone-300 pt-8">
      <h2 class="text-3xl font-bold text-stone-900 mb-3">Choose the base from the manual and site</h2>
      <p class="text-stone-700 mb-4">There is no universal gravel depth or foundation recipe for every barrel and property. The Dundalk Harmony instructions list crushed stone, patio stone or pavers, concrete, and a wood deck as possible solid-base categories, with drainage considered. The final design still depends on model loads, soil, frost, slope, water, deck capacity, anchoring, and local requirements.</p>
      <p class="text-stone-700">Obtain the configured shipment and operating weights, the cradle footprint, and the exact installation manual. Then have the base confirmed for the property before delivery.</p>
    </section>

    <section class="mt-12 border-t border-stone-300 pt-8">
      <h2 class="text-3xl font-bold text-stone-900 mb-3">Price the complete barrel project</h2>
      <p class="text-stone-700 mb-5">Include the room, options, freight, unloading, base, heater and controls, electrical or chimney work, roof and exterior treatment, assembly, permits, tax, accessories, and maintenance. Keep allowances visible when a quote does not define them.</p>
      <a href="/tools/sauna-cost-calculator/?utm_source=barrel_kits&utm_medium=onsite&utm_campaign=project_budget" class="inline-block bg-stone-900 hover:bg-stone-800 text-white font-semibold px-5 py-3 rounded-md" data-cta-position="barrel_kits_project_budget">Build the full project budget</a>
    </section>

    <section class="mt-12 border-t border-stone-300 pt-8" aria-labelledby="barrel-faq">
      <h2 id="barrel-faq" class="text-3xl font-bold text-stone-900 mb-6">Frequently asked questions</h2>
      <div class="divide-y divide-stone-200 border-y border-stone-200">
        <div class="py-5">
          <h3 class="font-bold text-stone-900 mb-2">What does a barrel sauna kit include?</h3>
          <p class="text-stone-700">It depends on the model and options. Use the bill of materials and written quote. Do not assume the heater, controls, stones, roof, lighting, drains, delivery, unloading, base, electrical work, chimney, or assembly are included.</p>
        </div>
        <div class="py-5">
          <h3 class="font-bold text-stone-900 mb-2">Can two people assemble one in a day?</h3>
          <p class="text-stone-700">Some manufacturers publish a one-day room-assembly estimate for specific models. That estimate does not replace the installation manual and usually does not include site preparation, unloading, electrical or chimney work, permitting, weather finishing, inspection, or commissioning.</p>
        </div>
        <div class="py-5">
          <h3 class="font-bold text-stone-900 mb-2">How many people will fit comfortably?</h3>
          <p class="text-stone-700">Use the capacity label only as a starting point. Compare actual bench length and depth, door location, heater guard, backrests, interior height, intended posture, and the size and mobility of the people who will use it.</p>
        </div>
      </div>
    </section>

    <aside class="mt-12 border border-stone-200 rounded-lg p-6">
      <h2 class="text-xl font-bold text-stone-900 mb-3">Primary sources used</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="https://saunalife.com/saunas/ergo-series-model-e6/" target="_blank" rel="noopener" class="text-amber-700 hover:underline">SaunaLife E6 product specifications</a></li>
        <li><a href="https://saunalife.com/technical-information/" target="_blank" rel="noopener" class="text-amber-700 hover:underline">SaunaLife installation and technical-information library</a></li>
        <li><a href="https://leisurecraft.com/ct-barrel-sauna" target="_blank" rel="noopener" class="text-amber-700 hover:underline">LeisureCraft Canadian Timber barrel collection</a></li>
        <li><a href="https://leisurecraft.com/wp-content/uploads/2022/01/CTC22W-Product-Drawing.pdf" target="_blank" rel="noopener" class="text-amber-700 hover:underline">LeisureCraft Harmony CTC22W product drawing</a></li>
        <li><a href="https://dealers.leisurecraft.com/store/PDF?id=CTC22E&pdfnumber=3" target="_blank" rel="noopener" class="text-amber-700 hover:underline">LeisureCraft Harmony assembly instructions</a></li>
      </ul>
    </aside>

    <aside class="mt-8 border border-stone-200 rounded-lg p-6">
      <h2 class="text-xl font-bold text-stone-900 mb-3">Continue planning</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/guides/barrel-sauna-costco/" class="text-amber-700 hover:underline">Compare the current Costco barrel bundle</a></li>
        <li><a href="/guides/sauna-heater-sizing-guide/" class="text-amber-700 hover:underline">Sauna Heater Sizing Guide</a></li>
        <li><a href="/guides/gravel-pad-for-barrel-sauna/" class="text-amber-700 hover:underline">Gravel Pad Planning Guide</a></li>
        <li><a href="/guides/how-to-assemble-barrel-sauna/" class="text-amber-700 hover:underline">Barrel Sauna Assembly Guide</a></li>
        <li><a href="/guides/outdoor-sauna-winter/" class="text-amber-700 hover:underline">Using a Sauna in Winter</a></li>
      </ul>
    </aside>
  </article>
</Base>
