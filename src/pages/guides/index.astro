      { href: "/guides/sauna-for-weight-loss/", title: "Sauna for Weight Loss: What Actually Works", desc: "Honest look at the research: what helps and what doesn't." },
      { href: "/guides/sauna-cold-plunge/", title: "Sauna and Cold Plunge: Contrast Therapy Guide", desc: "How to combine heat and cold for maximum benefit." },
