    ]
  },
  {
    category: "More Buying Guides",
    
    items: [
      { href: "/guides/best-saunas-under-5000/", title: "Best Saunas Under $5,000", desc: "Top picks at the sweet-spot price range." },
      { href: "/guides/best-4-person-outdoor-sauna/", title: "Best 4-Person Outdoor Saunas", desc: "What '4-person' actually means and the best options." },
