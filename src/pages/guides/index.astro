      { href: "/guides/best-sauna-bucket-ladle/", title: "Best Sauna Bucket and Ladle Sets", desc: "The simple accessory that defines the steam experience." },
      { href: "/guides/best-sauna-backrest/", title: "Best Sauna Backrest (2025)", desc: "Ergonomic picks that make long sessions comfortable." },
      { href: "/guides/best-sauna-essential-oils/", title: "Best Sauna Essential Oils and Essences", desc: "Eucalyptus, birch, pine. What works and how to use it." },
    ]
