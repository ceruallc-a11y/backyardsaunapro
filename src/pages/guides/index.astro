      { href: "/guides/best-indoor-sauna-kits/", title: "Best Indoor Sauna Kits (2025)", desc: "Plug-in infrared and traditional steam kits compared for every budget and space." },
      { href: "/guides/best-portable-sauna/", title: "Best Portable Sauna (2025)", desc: "Tent and steam options for renters and tight budgets." },
      { href: "/guides/best-wood-burning-sauna-heaters/", title: "Best Wood-Burning Sauna Heaters", desc: "Harvia, HUUM, and the top stoves reviewed." },
      { href: "/guides/sauna-heater-sizing-guide/", title: "Sauna Heater Sizing Guide", desc: "How to calculate the right kW for your room." },
    ]
  },
  {
    category: "Site Prep & Installation",

    items: [
      { href: "/guides/gravel-pad-for-barrel-sauna/", title: "Gravel Pad for a Barrel Sauna", desc: "How to build the right base before your sauna arrives." },
      { href: "/guides/outdoor-sauna-winter/", title: "Outdoor Sauna in Winter", desc: "Heat-up times, weatherproofing, and why winter is the best season." },
      { href: "/guides/best-outdoor-sauna-cover/", title: "Best Outdoor Sauna Cover (2025)", desc: "Waterproof picks that protect cedar through winter." },
    ]
  },
