---
import Base from '../../layouts/Base.astro';

const sections = [
  {
    title: "Property and approvals",
    checks: [
      ["The exact site is marked on a survey or reliable site plan.", "Confirm lot lines, easements, utilities, septic components, drainage, and protected areas."],
      ["The local authority has answered the project-specific permit and setback questions.", "Give them the sauna dimensions, foundation, fuel source, electrical plan, and property address."],
      ["HOA or design-review approval is documented if applicable.", "Do not rely on a neighbor's project or a retailer's general statement."]
    ]
  },
  {
    title: "Site and foundation",
    checks: [
      ["The base is designed for the structure and site.", "Account for soil, frost, drainage, runoff, anchoring, and manufacturer requirements."],
      ["Water moves away from the sauna and entry.", "Check the site after rain and plan roof runoff, snow, and a stable approach."],
      ["Required service clearances remain accessible.", "Leave room for exterior care, heater service, tightening, roof work, and inspection."]
    ]
  },
  {
    title: "Heater and utilities",
    checks: [
      ["The sauna manufacturer approves the exact heater model.", "Match the heater's rated room-volume method and any adjustment for glass, masonry, or uninsulated surfaces."],
      ["A qualified electrician has reviewed the actual installation.", "Confirm service capacity, circuit, controls, disconnects, routing, trenching, bonding, permits, and inspection."],
      ["A wood-fired plan has been reviewed locally if applicable.", "Confirm appliance listing, chimney system, clearances, ember protection, insurance, and fuel storage requirements."]
    ]
  },
  {
    title: "Space and comfort",
    checks: [
      ["The interior bench dimensions fit the people who will use it.", "Do not rely only on a marketing capacity label; compare usable bench length, width, and levels."],
      ["The door, changing route, and cooling area work in real use.", "Plan privacy, lighting, slip resistance, winter access, and where towels and footwear go."],
      ["The chosen format fits the goal.", "Compare barrel, cabin, indoor, infrared, and kit options by comfort, maintenance, weather protection, and installation rather than appearance alone."]
    ]
  },
  {
    title: "Freight and assembly",
    checks: [
      ["The freight plan reaches the property.", "Verify package size and weight, truck access, lift-gate service, unloading, gate width, overhead obstacles, and temporary storage."],
      ["The assembly plan matches the product.", "Confirm crew size, tools, lifting needs, weather window, installer scope, and what is excluded."],
      ["Damage and missing-part procedures are understood.", "Know the inspection deadline, photo requirements, return terms, and who pays for replacement freight."]
    ]
  },
  {
    title: "Full budget and ownership",
    checks: [
      ["The budget includes more than the sauna price.", "Add freight, tax, base, electrical or chimney work, permits, assembly, weather protection, access path, accessories, and contingency."],
      ["Warranty requirements are saved before purchase.", "Keep copies of the listing, manual, warranty, approved heater, receipts, installer details, and maintenance records."],
      ["Ongoing care is realistic.", "Price exterior treatment, cleaning, heater stones or parts, inspections, energy or fuel, and snow or roof maintenance."]
    ]
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What should I confirm before buying an outdoor sauna?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Confirm the legal site, foundation and drainage, approved heater, electrical or chimney plan, usable interior dimensions, freight access, assembly scope, complete installed budget, warranty, and maintenance requirements before ordering."
      }
    },
    {
      "@type": "Question",
      "name": "How much does an outdoor sauna cost to install?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "There is no dependable universal installed price. The total depends on the product, freight, site work, foundation, electrical or chimney work, permits, assembly, access, taxes, weather protection, and local labor. Build a project-specific budget from quotes."
      }
    }
  ]
};
---
<Base
  title="Outdoor Sauna Buying Checklist: Verify Before You Order"
  description="A practical outdoor sauna checklist covering site, permits, foundation, heater, electrical, freight, assembly, warranty, and full project cost."
  canonical="/guides/outdoor-sauna-buying-checklist"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-3xl mx-auto">
    <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Pre-purchase checklist</p>
    <h1 class="text-4xl font-bold text-stone-900 mb-3">Outdoor Sauna Buying Checklist: Verify Before You Order</h1>
    <p class="text-stone-500 mb-8">Reviewed August 2026 | Use product-specific quotes and local requirements</p>

    <div class="rounded-xl overflow-hidden mb-8">
      <img src="/images/lifestyle/barrel-sauna-field.jpg" alt="Outdoor barrel sauna in a grassy setting" class="w-full object-cover max-h-80" loading="lazy" width="1200" height="800" />
    </div>

    <p class="text-lg text-stone-700 mb-4">The unit price is often the easiest number to find and the least complete. This checklist is designed to uncover the site work, approvals, utilities, freight, and ownership costs that determine whether a sauna is actually a good fit.</p>
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-10 text-sm text-stone-700">
      <strong>How to use it:</strong> Do not check an item because it seems likely. Save the written answer, drawing, quote, manual page, or approval that proves it.
    </div>

    {sections.map(section => (
      <section class="mb-10">
        <h2 class="text-2xl font-bold text-stone-900 mb-5">{section.title}</h2>
        <div class="space-y-4">
          {section.checks.map(([item, detail]) => (
            <div class="flex gap-3 p-4 bg-white border border-stone-200 rounded-xl">
              <span class="text-xl mt-0.5" aria-hidden="true">&#9744;</span>
              <div>
                <p class="font-semibold text-stone-900 text-sm">{item}</p>
                <p class="text-stone-600 text-sm mt-1">{detail}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <h2 class="text-2xl font-bold text-stone-900 mt-12 mb-4">Build the installed-cost worksheet</h2>
    <p class="text-stone-700 mb-4">Collect real quotes or written allowances for every applicable line. Mark unknowns instead of replacing them with broad internet averages.</p>
    <div class="grid sm:grid-cols-2 gap-3 mb-8 text-sm text-stone-700">
      {["Sauna and heater package", "Freight, unloading, and storage", "Tax and permit fees", "Survey or site planning", "Foundation and drainage", "Electrical or chimney work", "Assembly or contractor labor", "Roof and weather protection", "Path, lighting, and privacy", "Accessories and safety items", "Initial exterior finish", "Contingency for unknowns"].map(item => (
        <div class="flex gap-2 border-b border-stone-200 py-2"><span aria-hidden="true">&#9744;</span><span>{item}</span></div>
      ))}
    </div>

    <div class="bg-stone-800 text-white rounded-xl p-6 mt-12">
      <h2 class="text-xl font-bold mb-2">Calculate before checkout</h2>
      <p class="text-stone-300 mb-4">Use the project calculator to total the quotes you collect and expose missing costs.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/tools/sauna-cost-calculator/" class="inline-block bg-amber-400 hover:bg-amber-500 text-stone-900 font-semibold px-5 py-3 rounded-lg">Open the cost calculator</a>
        <a href="/lead-magnets/outdoor-sauna-checklist.html" class="inline-block border border-stone-500 hover:border-stone-300 text-white font-semibold px-5 py-3 rounded-lg">Open the printable checklist</a>
      </div>
    </div>

    <div class="bg-stone-50 border border-stone-200 rounded-xl p-6 mt-10">
      <h2 class="text-lg font-bold text-stone-900 mb-2">Related planning guides</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/guides/best-location-backyard-sauna/" class="text-amber-700 hover:underline">Choose and verify the location</a></li>
        <li><a href="/guides/sauna-electrical-requirements/" class="text-amber-700 hover:underline">Plan the electrical scope</a></li>
        <li><a href="/guides/outdoor-sauna-permits/" class="text-amber-700 hover:underline">Prepare permit questions</a></li>
        <li><a href="/guides/how-to-build-a-sauna/" class="text-amber-700 hover:underline">Plan a kit or custom build</a></li>
      </ul>
    </div>
  </article>
</Base>
