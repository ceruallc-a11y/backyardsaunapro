---
import Base from '../../layouts/Base.astro';
import AdvertiserDisclosure from '../../components/AdvertiserDisclosure.astro';
import PlannerCTA from '../../components/PlannerCTA.astro';

const reviewedAt = 'August 15, 2026';

const products = [
  {
    label: 'Compact thermowood format',
    name: 'SaunaLife CL5G Cube Sauna',
    href: 'https://saunalife.com/saunas/cube-series-model-cl5g/',
    productId: 'saunalife_cl5g',
    fit: 'A buyer comparing a compact four-person listing, full-glass front, curved seating, and a manufacturer-supplied roofing system.',
    facts: [
      'Published capacity: up to four people',
      'Exterior: 63 inches deep by 80.7 inches wide by 82.7 inches high',
      'Interior: 55.1 inches deep by 77.2 inches wide by 74.8 inches high',
      'Thermo-Spruce exterior with Thermo-Aspen seating',
      '8 mm bronze-tempered-glass front and listed shingle roof kit',
      'Manufacturer-listed weight: 1,680 pounds',
    ],
    questions: [
      'Which heater and control package matches the documented room, glass area, climate, and local electrical requirements?',
      'Can the delivery route, unloading plan, base, and assembly crew handle the listed weight?',
      'Do the two bench levels fit the people who will use the sauna, rather than only the published capacity?',
    ],
  },
  {
    label: 'Clear-cedar dealer format',
    name: 'LeisureCraft CU580 Pure Cube Sauna',
    href: 'https://leisurecraft.com/cu580-outdoor-pure-cube-sauna-clear-red-cedar',
    productId: 'leisurecraft_cu580',
    fit: 'A buyer who wants a clear-red-cedar cube and prefers to resolve the product, heater, delivery, and installation scope through a local dealer.',
    facts: [
      'Published seating range: three to four people',
      'Manufacturer-listed room volume: 272 cubic feet',
      'Clear red cedar construction',
      'Current price available by request rather than published on the product page',
      'Local-dealer quote and buying path',
    ],
    questions: [
      'What are the final exterior dimensions, shipment weight, crate size, lead time, and unloading requirements for the chosen configuration?',
      'Which room, door, glass, heater, controls, stones, guard, and roofing items are included in the written quote?',
      'What site, foundation, electrical or chimney, assembly, weather, and warranty work remains outside the quote?',
    ],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What should I compare when buying a cube sauna?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Compare usable bench dimensions, documented room volume, glass and uninsulated surfaces, heater requirements, shipment weight, unloading, foundation, weather protection, assembly, permits, and the complete written quote.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I size a heater for a cube sauna?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Use the room manufacturer and heater manufacturer instructions for the exact configuration. Glass, log construction, insulation, room volume, and other uninsulated surfaces can change the effective volume and heater range.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does a cube sauna need a permit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Permit, zoning, setback, electrical, and solid-fuel requirements vary by location and project. Ask the local authority having jurisdiction about the selected sauna and site before ordering.',
      },
    },
  ],
};
---
<Base
  title="Best Cube Saunas: Two Current Formats to Compare"
  description="Compare two current outdoor cube sauna formats using documented capacity, dimensions, materials, weight, and the project questions to resolve before ordering."
  canonical="/guides/best-cube-sauna"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-4xl mx-auto">
    <header class="max-w-3xl mb-8">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Outdoor buying guide</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-4">Best Cube Saunas: Two Current Formats to Compare</h1>
      <p class="text-stone-500 text-sm">Manufacturer information reviewed {reviewedAt} · 9 min read</p>
      <p class="text-lg text-stone-700 mt-4">A cube can give you upright walls, full-height seating space, and a modern outdoor profile. Those benefits do not make every cube a good project. The useful comparison is between a documented room, a buildable site, and a complete quote.</p>
    </header>

    <AdvertiserDisclosure />

    <figure class="rounded-lg overflow-hidden mb-8">
      <img src="/images/lifestyle/sauna-cabins-outdoor.jpg" alt="Representative modern outdoor sauna cabins" class="w-full object-cover max-h-80" loading="eager" width="1200" height="800" />
      <figcaption class="text-xs text-stone-500 mt-2">Representative outdoor sauna setting. It is not a photo of either model compared below.</figcaption>
    </figure>

    <aside class="border-y border-stone-200 py-6 mb-8">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">The short answer</h2>
      <p class="text-stone-700 mb-3">Start with the SaunaLife CL5G if published dimensions, weight, and technical documents are important to your early planning. Start with the LeisureCraft CU580 if clear cedar and a local-dealer quote path matter more.</p>
      <p class="text-sm text-stone-600">That is a buyer-fit distinction, not a performance ranking. We have not personally tested either sauna. Confirm the exact configuration, current availability, price, freight, and installation scope with the manufacturer or dealer.</p>
    </aside>

    <PlannerCTA source="best_cube_sauna_above_fold" heading="Check whether a cube fits the whole project" description="Build a brief around your site, capacity, budget, utilities, and timeline before requesting dealer quotes." />

    <section class="mt-12" aria-labelledby="cube-shortlist">
      <h2 id="cube-shortlist" class="text-3xl font-bold text-stone-900 mb-3">Two documented cube formats</h2>
      <p class="text-stone-600 max-w-3xl mb-8">We included these models because their manufacturers publish meaningful room details. We did not assign numeric ratings or pretend that one configuration fits every yard.</p>

      <div class="space-y-10">
        {products.map((product) => (
          <section class="border-t border-stone-300 pt-7" aria-label={product.name}>
            <p class="text-xs font-bold uppercase tracking-wide text-amber-700 mb-2">{product.label}</p>
            <h3 class="text-2xl font-bold text-stone-900 mb-4">{product.name}</h3>
            <p class="text-stone-700 mb-5"><strong>Who it may fit:</strong> {product.fit}</p>

            <div class="grid md:grid-cols-2 gap-6 mb-6">
              <div>
                <h4 class="font-semibold text-stone-900 mb-2">Documented manufacturer details</h4>
                <ul class="space-y-2 text-sm text-stone-700">
                  {product.facts.map((fact) => <li class="flex gap-2"><span aria-hidden="true">+</span><span>{fact}</span></li>)}
                </ul>
              </div>
              <div>
                <h4 class="font-semibold text-stone-900 mb-2">Resolve before paying</h4>
                <ul class="space-y-2 text-sm text-stone-700">
                  {product.questions.map((question) => <li class="flex gap-2"><span aria-hidden="true">-</span><span>{question}</span></li>)}
                </ul>
              </div>
            </div>

            <a
              href={product.href}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center justify-center rounded-md bg-amber-400 px-5 py-3 font-semibold text-stone-900 hover:bg-amber-500"
              data-track-event="brand_outbound_click"
              data-cta-position={`best_cube_${product.productId}`}
              data-product-id={product.productId}
              data-partner={product.productId.startsWith('saunalife') ? 'saunalife' : 'leisurecraft'}
            >
              Review the manufacturer page
            </a>
          </section>
        ))}
      </div>
    </section>

    <section class="mt-14 border-t border-stone-300 pt-8" aria-labelledby="cube-comparison">
      <h2 id="cube-comparison" class="text-2xl font-bold text-stone-900 mb-5">What the shape changes, and what it does not</h2>
      <div class="grid md:grid-cols-2 gap-6 text-sm text-stone-700">
        <div><h3 class="font-bold text-stone-900 mb-2">Usable wall height</h3><p>Straight walls can make upper and lower benches easier to arrange than in a curved barrel. The bench drawings still matter more than the outside silhouette.</p></div>
        <div><h3 class="font-bold text-stone-900 mb-2">Glass and heater sizing</h3><p>A large glass front changes the effective heating load. Do not choose a heater from floor area or a universal watts-per-volume shortcut.</p></div>
        <div><h3 class="font-bold text-stone-900 mb-2">Roof and weather scope</h3><p>A cube still needs the roof, flashing, drainage, finish, wind, snow, and maintenance details required by its manual and site.</p></div>
        <div><h3 class="font-bold text-stone-900 mb-2">Foundation and delivery</h3><p>The exterior footprint is only one constraint. Account for the loaded structure, level support, water movement, crate, unloading equipment, carry path, and assembly access.</p></div>
      </div>
    </section>

    <section class="mt-14 border-t border-stone-300 pt-8" aria-labelledby="cube-heater">
      <h2 id="cube-heater" class="text-2xl font-bold text-stone-900 mb-3">Size the heater from the exact room</h2>
      <p class="text-stone-700 mb-4">Use the selected room manual and the heater manufacturer's sizing method. Harvia's official calculator asks for room dimensions and adjusts for log construction, a glass door, and other non-insulated surfaces. That is more useful than a blanket kilowatt rule.</p>
      <div class="flex flex-wrap gap-3">
        <a href="https://www.harvia.com/en-US/sauna/saunas/sauna-calculator/" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center justify-center rounded-md border border-stone-300 bg-white px-5 py-3 font-semibold text-amber-700 hover:border-stone-500" data-track-event="brand_outbound_click" data-cta-position="best_cube_heater_calculator" data-product-id="harvia_sauna_calculator" data-partner="harvia">Use Harvia's sauna calculator</a>
        <a href="/guides/sauna-heater-sizing-guide/" class="inline-flex min-h-11 items-center justify-center rounded-md border border-stone-300 bg-white px-5 py-3 font-semibold text-amber-700 hover:border-stone-500">Read the heater-sizing guide</a>
      </div>
    </section>

    <section class="mt-14 border-t border-stone-300 pt-8" aria-labelledby="cube-quote">
      <h2 id="cube-quote" class="text-2xl font-bold text-stone-900 mb-3">Get one complete written quote</h2>
      <p class="text-stone-700 mb-5">Ask the seller to name every included room, heater, control, stone, guard, lighting, roofing, delivery, and warranty item. Put the remaining site work beside that quote: base, drainage, unloading, assembly, electrical or chimney work, permits, tax, and contingency.</p>
      <a href="/tools/sauna-cost-calculator/?ref=best_cube_sauna&campaign=project_budget&placement=best_cube_project_budget" class="inline-flex min-h-11 items-center justify-center rounded-md bg-stone-900 px-5 py-3 font-semibold text-white hover:bg-stone-800" data-track-event="calculator_cta_clicked" data-cta-position="best_cube_project_budget">Build the full project budget</a>
    </section>

    <section class="mt-14 border-t border-stone-300 pt-8" aria-labelledby="cube-faq">
      <h2 id="cube-faq" class="text-2xl font-bold text-stone-900 mb-5">Frequently asked questions</h2>
      <div class="divide-y divide-stone-200 border-y border-stone-200">
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">Is a cube better than a barrel?</h3><p class="text-stone-700 text-sm">Not automatically. A cube may offer more usable height near the walls. A barrel may use less material and have a different assembly path. Compare bench geometry, room volume, weather scope, site fit, and the complete quote.</p></div>
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">How large should the cube be?</h3><p class="text-stone-700 text-sm">Start with the people and how they will sit or recline. Then compare usable bench dimensions, heater clearances, doorway space, and exterior site constraints. Treat the manufacturer's capacity as a maximum until the seating plan works for your group.</p></div>
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">Will I need permits?</h3><p class="text-stone-700 text-sm">Possibly. Building, zoning, setback, electrical, and solid-fuel rules vary by location and project. Ask the local authority having jurisdiction about the selected sauna, heater, and site before ordering.</p></div>
      </div>
    </section>

    <section class="mt-12 bg-stone-50 border border-stone-200 rounded-lg p-6" aria-labelledby="cube-sources">
      <h2 id="cube-sources" class="text-lg font-bold text-stone-900 mb-3">Primary sources used</h2>
      <ul class="space-y-2 text-sm text-stone-700">
        <li><a href="https://saunalife.com/saunas/cube-series-model-cl5g/" target="_blank" rel="noopener" class="text-amber-700 hover:underline">SaunaLife CL5G product specifications</a></li>
        <li><a href="https://saunalife.com/technical-information/" target="_blank" rel="noopener" class="text-amber-700 hover:underline">SaunaLife technical information and installation documents</a></li>
        <li><a href="https://leisurecraft.com/cu580-outdoor-pure-cube-sauna-clear-red-cedar" target="_blank" rel="noopener" class="text-amber-700 hover:underline">LeisureCraft CU580 product information</a></li>
        <li><a href="https://www.harvia.com/en-US/sauna/saunas/sauna-calculator/" target="_blank" rel="noopener" class="text-amber-700 hover:underline">Harvia sauna calculator</a></li>
      </ul>
    </section>

    <div class="bg-stone-50 border border-stone-200 rounded-lg p-6 mt-10">
      <h2 class="text-lg font-bold text-stone-900 mb-2">Continue planning</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/guides/barrel-sauna-vs-cabin-sauna/" class="text-amber-700 hover:underline">Barrel Sauna vs Cabin Sauna</a></li>
        <li><a href="/guides/best-4-person-outdoor-sauna/" class="text-amber-700 hover:underline">Best 4-Person Outdoor Saunas</a></li>
        <li><a href="/guides/best-sauna-for-small-backyard/" class="text-amber-700 hover:underline">Best Sauna for a Small Backyard</a></li>
        <li><a href="/guides/sauna-foundation-guide/" class="text-amber-700 hover:underline">Sauna Foundation Guide</a></li>
        <li><a href="/guides/sauna-electrical-requirements/" class="text-amber-700 hover:underline">Sauna Electrical Requirements</a></li>
        <li><a href="/guides/outdoor-sauna-permits/" class="text-amber-700 hover:underline">Outdoor Sauna Permits</a></li>
      </ul>
    </div>
  </article>
</Base>
