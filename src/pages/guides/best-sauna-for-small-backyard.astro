---
import Base from '../../layouts/Base.astro';
import AdvertiserDisclosure from '../../components/AdvertiserDisclosure.astro';
import PlannerCTA from '../../components/PlannerCTA.astro';
import SelectSaunasButton from '../../components/SelectSaunasButton.astro';

const reviewedAt = 'August 15, 2026';

const options = [
  {
    label: 'Short barrel footprint',
    name: 'SaunaLife E6 3-Person Barrel Sauna',
    retailerHref: 'https://selectsaunas.com/products/saunalife-model-e6-sauna-barrel-ergo-series-sauna-barrel-59x81',
    manufacturerHref: 'https://saunalife.com/saunas/ergo-series-model-e6/',
    fit: 'A buyer who can accommodate an 81-inch-diameter barrel but wants to limit the room length to 59 inches.',
    facts: [
      'Published capacity: up to three people',
      'Manufacturer dimensions: 81-inch diameter by 59-inch length',
      'Thermo-Spruce staves with Thermo-Aspen benches and backrests',
      '17.8-inch published bench depth',
      'Manufacturer-listed shipment weight: 1,103 pounds',
      'Black roof-shingle kit and lighting system listed with the room kit',
    ],
    questions: [
      'Does the full exterior envelope fit after local setbacks, heater or chimney clearances, drainage, and maintenance access?',
      'Can the delivery route, unloading equipment, base, and assembly crew support the listed shipment?',
      'Which heater, controls, stones, guard, power or chimney components, and final weather work are included?',
    ],
  },
  {
    label: 'Rectangular full-glass footprint',
    name: 'SaunaLife CL5G 4-Person Cube Sauna',
    retailerHref: 'https://selectsaunas.com/products/saunalife-model-cl5g-cube-series-outdoor-home-sauna-kit-up-to-4-persons',
    manufacturerHref: 'https://saunalife.com/saunas/cube-series-model-cl5g/',
    fit: 'A buyer who prefers straight walls and two bench levels, and can fit a 63-by-80.7-inch exterior plus the site-specific access and clearance envelope.',
    facts: [
      'Published capacity: up to four people',
      'Exterior: 63 inches deep by 80.7 inches wide by 82.7 inches high',
      'Interior: 55.1 inches deep by 77.2 inches wide by 74.8 inches high',
      'Thermo-Spruce exterior with Thermo-Aspen seating',
      '8 mm bronze-tempered-glass front and listed shingle roof kit',
      'Manufacturer-listed weight: 1,680 pounds',
    ],
    questions: [
      'Does the glass area change the heater range for the selected climate and room configuration?',
      'Do the published bench dimensions work for the intended users rather than only the capacity label?',
      'What freight, unloading, base, assembly, electrical, permit, and warranty scope remains outside the room quote?',
    ],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much space does a small backyard sauna need?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Start with the exact exterior dimensions, then add the manufacturer-required service and heater clearances, local setbacks, drainage, delivery and assembly access, and a safe approach to the door. There is no universal extra-clearance number that applies to every sauna and site.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is a barrel or cube better for a small backyard?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Neither shape wins automatically. Compare the full exterior envelope, usable bench layout, door approach, heater and weather requirements, shipment weight, and complete project cost for the specific models.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can a sauna go on an existing deck?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Do not assume an existing deck can support a sauna. Obtain the configured sauna weight and footprint, account for occupants and equipment, and have a qualified local professional evaluate the existing structure and applicable requirements.',
      },
    },
  ],
};
---
<Base
  title="Best Sauna for a Small Backyard: Two Compact Paths"
  description="Compare two current compact outdoor sauna formats using exact dimensions, listed weight, bench details, and the site checks that determine whether either one truly fits."
  canonical="/guides/best-sauna-for-small-backyard"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-4xl mx-auto">
    <header class="max-w-3xl mb-8">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Small-site buying guide</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-4">Best Sauna for a Small Backyard</h1>
      <p class="text-stone-500 text-sm">Manufacturer and retailer information reviewed {reviewedAt} · 9 min read</p>
      <p class="text-lg text-stone-700 mt-4">A compact shell is only the beginning. The sauna also needs a workable door approach, delivery path, base, drainage, utilities, clearances, setbacks, and maintenance access. Measure that whole site envelope before comparing finishes.</p>
    </header>

    <AdvertiserDisclosure />

    <figure class="rounded-lg overflow-hidden mb-8">
      <img src="/images/lifestyle/barrel-sauna-chimney.jpg" alt="Representative compact outdoor barrel sauna" class="w-full object-cover max-h-80" loading="eager" width="1200" height="800" />
      <figcaption class="text-xs text-stone-500 mt-2">Representative outdoor setting. It is not a photo of either exact configuration compared below.</figcaption>
    </figure>

    <aside class="border-y border-stone-200 py-6 mb-8">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">Two useful starting points</h2>
      <p class="text-stone-700 mb-3">The SaunaLife E6 limits barrel length to 59 inches, but its 81-inch diameter still controls the width and height. The CL5G uses a 63-by-80.7-inch rectangular exterior and publishes two bench levels. Neither is the universal small-yard winner.</p>
      <p class="text-sm text-stone-600">We have not personally tested these saunas. Capacity is manufacturer-published, not a comfort guarantee. Confirm the exact configuration, current price, stock, freight, and installation scope before ordering.</p>
    </aside>

    <PlannerCTA source="small_backyard_above_fold" heading="Map the sauna to the actual yard" description="Build a project brief with the site, capacity, budget, utilities, and timeline before you request a quote." />

    <section class="mt-12" aria-labelledby="small-yard-options">
      <h2 id="small-yard-options" class="text-3xl font-bold text-stone-900 mb-3">Two current compact formats</h2>
      <p class="text-stone-600 max-w-3xl mb-8">These options solve different layout problems. Compare the documented room first. Then ask the seller to complete the missing project scope in writing.</p>

      <div class="space-y-10">
        {options.map((option) => (
          <section class="border-t border-stone-300 pt-7" aria-label={option.name}>
            <p class="text-xs font-bold uppercase tracking-wide text-amber-700 mb-2">{option.label}</p>
            <h3 class="text-2xl font-bold text-stone-900 mb-4">{option.name}</h3>
            <p class="text-stone-700 mb-5"><strong>Who it may fit:</strong> {option.fit}</p>

            <div class="grid md:grid-cols-2 gap-6 mb-5">
              <div>
                <h4 class="font-semibold text-stone-900 mb-2">Documented listing details</h4>
                <ul class="space-y-2 text-sm text-stone-700">
                  {option.facts.map((fact) => <li class="flex gap-2"><span aria-hidden="true">+</span><span>{fact}</span></li>)}
                </ul>
              </div>
              <div>
                <h4 class="font-semibold text-stone-900 mb-2">Resolve before buying</h4>
                <ul class="space-y-2 text-sm text-stone-700">
                  {option.questions.map((question) => <li class="flex gap-2"><span aria-hidden="true">-</span><span>{question}</span></li>)}
                </ul>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <SelectSaunasButton href={option.retailerHref} label="Check current retailer listing" ctaPosition="small_backyard_shortlist" />
              <a href={option.manufacturerHref} target="_blank" rel="noopener" class="text-sm font-semibold text-amber-700 hover:underline" data-track-event="brand_outbound_click" data-cta-position="small_backyard_manufacturer" data-partner="saunalife">Review manufacturer specifications</a>
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="mt-14 border-t border-stone-300 pt-8" aria-labelledby="site-envelope">
      <h2 id="site-envelope" class="text-2xl font-bold text-stone-900 mb-3">Measure the site envelope, not just the shell</h2>
      <div class="grid md:grid-cols-2 gap-6 text-sm text-stone-700 mt-6">
        <div><h3 class="font-bold text-stone-900 mb-2">Property rules</h3><p>Confirm zoning, setbacks, lot coverage, building and trade permits, utility easements, HOA rules, and any wildfire, wind, snow, or flood requirements that apply to the address.</p></div>
        <div><h3 class="font-bold text-stone-900 mb-2">Product clearances</h3><p>Use the exact room, heater, control, and chimney manuals. Do not borrow a clearance number from another sauna, heater, or jurisdiction.</p></div>
        <div><h3 class="font-bold text-stone-900 mb-2">Delivery and assembly</h3><p>Measure gates, turns, slopes, overhead limits, staging space, crate access, unloading equipment, and the working room the assembly crew needs.</p></div>
        <div><h3 class="font-bold text-stone-900 mb-2">Daily use and service</h3><p>Leave a safe route to the outward-opening door. Plan drainage, lighting, weather exposure, cleaning, roof access, electrical or chimney service, and winter snow management.</p></div>
      </div>
    </section>

    <section class="mt-14 border-t border-stone-300 pt-8" aria-labelledby="small-yard-deck">
      <h2 id="small-yard-deck" class="text-2xl font-bold text-stone-900 mb-3">An existing deck is not automatically a foundation</h2>
      <p class="text-stone-700 mb-4">The room, heater, stones, occupants, and accessories create a concentrated load. Obtain the configured weight and bearing footprint. Then have a qualified local deck professional or structural engineer evaluate the existing framing, connections, footings, condition, and local requirements.</p>
      <p class="text-sm text-stone-600">Do not rely on a generic pounds-per-square-foot rule or add posts, pads, joists, or hardware from an online article without a site-specific design.</p>
    </section>

    <section class="mt-14 border-t border-stone-300 pt-8" aria-labelledby="small-yard-budget">
      <h2 id="small-yard-budget" class="text-2xl font-bold text-stone-900 mb-3">Price the space-saving project, not only the room</h2>
      <p class="text-stone-700 mb-5">A compact room can still require freight, unloading, site work, a foundation, electrical or chimney work, roofing, assembly, permits, tax, and weather protection. Put every line beside the room quote before deciding which footprint is cheaper.</p>
      <a href="/tools/sauna-cost-calculator/?utm_source=small_backyard&utm_medium=onsite&utm_campaign=project_budget" class="inline-flex min-h-11 items-center justify-center rounded-md bg-stone-900 px-5 py-3 font-semibold text-white hover:bg-stone-800" data-track-event="calculator_cta_clicked" data-cta-position="small_backyard_project_budget">Build the full project budget</a>
    </section>

    <section class="mt-14 border-t border-stone-300 pt-8" aria-labelledby="small-yard-faq">
      <h2 id="small-yard-faq" class="text-2xl font-bold text-stone-900 mb-5">Frequently asked questions</h2>
      <div class="divide-y divide-stone-200 border-y border-stone-200">
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">How much extra space should I leave?</h3><p class="text-stone-700 text-sm">There is no safe universal number. Combine the exact exterior dimensions with manufacturer-required clearances, local setbacks, drainage, delivery and assembly access, service access, and a safe path to the door.</p></div>
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">Is a smaller barrel always more space-efficient?</h3><p class="text-stone-700 text-sm">No. Barrel diameter can control the total width and height even when the room is short. Compare the complete exterior envelope and usable bench dimensions against a compact cube or cabin.</p></div>
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">Should I choose electric or wood heat?</h3><p class="text-stone-700 text-sm">Choose after checking the exact heater or stove manual, available utility service, chimney route, clearances, fuel storage, local permitting, and how you expect to use the sauna. A tight site does not make either heat source automatically correct.</p></div>
      </div>
    </section>

    <section class="mt-12 bg-stone-50 border border-stone-200 rounded-lg p-6" aria-labelledby="small-yard-sources">
      <h2 id="small-yard-sources" class="text-lg font-bold text-stone-900 mb-3">Primary sources used</h2>
      <ul class="space-y-2 text-sm text-stone-700">
        <li><a href="https://saunalife.com/saunas/ergo-series-model-e6/" target="_blank" rel="noopener" class="text-amber-700 hover:underline">SaunaLife E6 product specifications</a></li>
        <li><a href="https://saunalife.com/saunas/cube-series-model-cl5g/" target="_blank" rel="noopener" class="text-amber-700 hover:underline">SaunaLife CL5G product specifications</a></li>
        <li><a href="https://saunalife.com/technical-information/" target="_blank" rel="noopener" class="text-amber-700 hover:underline">SaunaLife technical information and installation documents</a></li>
      </ul>
    </section>

    <div class="bg-stone-50 border border-stone-200 rounded-lg p-6 mt-10">
      <h2 class="text-lg font-bold text-stone-900 mb-2">Continue planning</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/guides/best-cube-sauna/" class="text-amber-700 hover:underline">Compare Current Cube Sauna Formats</a></li>
        <li><a href="/guides/best-2-person-outdoor-sauna/" class="text-amber-700 hover:underline">Best 2-Person Outdoor Saunas</a></li>
        <li><a href="/guides/how-much-space-for-backyard-sauna/" class="text-amber-700 hover:underline">How Much Space Do You Need?</a></li>
        <li><a href="/guides/best-location-backyard-sauna/" class="text-amber-700 hover:underline">Best Location for a Backyard Sauna</a></li>
        <li><a href="/guides/sauna-foundation-guide/" class="text-amber-700 hover:underline">Sauna Foundation Guide</a></li>
        <li><a href="/guides/outdoor-sauna-permits/" class="text-amber-700 hover:underline">Outdoor Sauna Permits</a></li>
      </ul>
    </div>
  </article>
</Base>
