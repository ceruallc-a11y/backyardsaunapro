---
import Base from '../../layouts/Base.astro';
import AdvertiserDisclosure from '../../components/AdvertiserDisclosure.astro';
import PlannerCTA from '../../components/PlannerCTA.astro';
import SelectSaunasButton from '../../components/SelectSaunasButton.astro';
import SunHomeButton from '../../components/SunHomeButton.astro';

const reviewedAt = 'August 15, 2026';
const priceCheckedAt = 'September 2, 2026';

const picks = [
  {
    rank: 1,
    label: 'Compact barrel path',
    name: 'Almost Heaven Pinnacle 4-Person Barrel Sauna',
    reviewedPrice: '$5,303',
    href: 'https://selectsaunas.com/collections/traditional-saunas/products/almost-heaven-pinnacle-morgan-4-person-classic-barrel-sauna-6x6-ft',
    fit: 'A buyer who wants a familiar 6-by-6-foot barrel layout and can support the hardwired heater, freight, base, assembly, and outdoor weather details.',
    facts: ['Up to four people (published)', '72 x 72 x 77-inch assembled exterior', '71 x 64 x 71-inch interior', 'Two 64 x 18-inch opposing benches', '6kW heater; 240V / 30A hardwired service'],
    questions: ['Which lumber, door, window, heater, controls, and roof options are in the quote?', 'What unloading and assembly help are required at the property?', 'What base, weather protection, drainage, power, clearances, and permits apply?'],
  },
  {
    rank: 2,
    label: 'Lower-priced cabin path',
    name: 'SaunaLife G2 4-Person Outdoor Cabin Sauna',
    reviewedPrice: '$4,990',
    href: 'https://selectsaunas.com/products/saunalife-g2-4-person-outdoor-traditional-sauna',
    fit: 'A buyer who prefers a taller cabin room over a barrel and wants to choose the heater package after confirming room volume and local requirements.',
    facts: ['Four-person listing', '92 x 72 x 92-inch exterior envelope', '59 x 66 x 85-inch interior', 'Nordic Spruce room with knotless Aspen benches', 'Roofing felt and foundation beams listed with the room kit'],
    questions: ['Which heater, controls, stones, guard, and chimney or electrical equipment are included?', 'What finished roofing, foundation, drainage, and weather sealing remain?', 'Can the delivery route handle the published 1,200-pound shipment?'],
  },
  {
    rank: 3,
    label: 'Full-glass cube path',
    name: 'SaunaLife CL5G 4-Person Outdoor Cube Sauna',
    reviewedPrice: '$5,990',
    href: 'https://selectsaunas.com/products/saunalife-model-cl5g-cube-series-outdoor-home-sauna-kit-up-to-4-persons',
    fit: 'A design-focused buyer who values a full-glass front, contoured seating, and a complete shingle kit enough to accept the added glass and heater-sizing considerations.',
    facts: ['Up to four people (published)', 'Thermo-Spruce exterior and Thermo-Aspen seating', '76-inch back-wall bench and 73.2-inch lower bench', 'Bronze-tempered-glass front', 'Shingle roof kit and Wi-Fi-capable white LED system listed'],
    questions: ['Which heater size and control package matches the final room and climate?', 'How does the usable bench layout fit the intended four people?', 'What are the final freight, unloading, base, assembly, power, and warranty terms?'],
  },
  {
    rank: 4,
    sponsor: "sun-home",
    sunHomeProduct: "eclipse-4",
    image: "/images/sun-home/eclipse-4p.jpg",
    name: "Sun Home Eclipse 4-Person Red Light + Infrared",
    rating: "Premium",
    tag: "BEST 4-PERSON INDOOR WELLNESS",
    tagColor: "bg-stone-900 text-amber-100",
    type: "Indoor Infrared + Red Light",
    wood: "Canadian Red Cedar interior",
    summary: "The right pick for 4-person buyers who can place a sauna indoors (basement, garage, or wellness room) rather than outside. Factory-integrated dual-tower red light therapy at 630-850nm with 1,800W output, full-spectrum infrared, native Sun Home app with guided breathwork. Cabin arrives finished, plug-in 120V install in most cases. Not an outdoor product, so we list it as the indoor wellness alternative for buyers open to that path.",
    pros: ["Genuine 4-person capacity, finished cabin", "Factory-integrated red light therapy at 630-850nm", "Full-spectrum infrared with verified safety testing", "Plug-in install, no 240V circuit needed"],
    cons: ["Indoor product, not outdoor (placement constraint)", "Premium price tier", "Lower max temperature than traditional barrel (165 \u00b0F vs 195 \u00b0F)", "No rocks, no l\u00f6yly"],
    buyerFit: "Best for 4-person buyers who want a premium indoor wellness sauna and have basement, garage, or dedicated room space. Not the right pick if you specifically want an outdoor backyard sauna, want traditional Finnish steam, or are budget-focused.",
  },
  {
    rank: 5,
    label: 'Outdoor infrared path',
    name: 'SunRay Cayenne 4-Person Outdoor Infrared Sauna',
    reviewedPrice: '$4,290',
    href: 'https://selectsaunas.com/products/sunray-cayenne-hl400d',
    fit: 'A buyer who specifically wants infrared heat outdoors and can provide the dedicated electrical service required by the listing.',
    facts: ['Four-person outdoor infrared listing', '79 x 52 x 83-inch exterior', '65 x 48 x 68-inch interior', 'Eight ceramic heaters; published maximum of 140 deg F', '120V AC / 30A plug listed'],
    questions: ['Can a licensed electrician provide the specified dedicated receptacle and circuit?', 'Do the lower temperature and single-level bench match the intended use?', 'What weather-cover, siting, drainage, warranty, and winter-use terms apply?'],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Will four adults fit comfortably in a 4-person outdoor sauna?',
      acceptedAnswer: { '@type': 'Answer', text: 'A four-person label is a published maximum, not a comfort guarantee. Compare usable bench length and depth, heater clearances, door space, and the intended users before ordering.' },
    },
    {
      '@type': 'Question',
      name: 'Does a 4-person outdoor sauna need 240V power?',
      acceptedAnswer: { '@type': 'Answer', text: 'Many traditional four-person electric rooms do. The current Pinnacle listing specifies a 6kW heater with 240V and 30A hardwired service. Other rooms and infrared models differ, so use the selected room and heater manuals.' },
    },
    {
      '@type': 'Question',
      name: 'What should be included in an outdoor sauna quote?',
      acceptedAnswer: { '@type': 'Answer', text: 'Confirm the exact room, heater, controls, stones, guard, roofing, freight, unloading, base, assembly, electrical or chimney scope, permits, tax, lead time, and warranty terms.' },
    },
  ],
};
---
<Base
  title="Best 4-Person Outdoor Saunas (2026): Prices & Guide"
  description="Compare four current 4-person outdoor saunas by price, bench space, room shape, power, freight, foundation, and installation scope."
  canonical="/guides/best-4-person-outdoor-sauna"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-4xl mx-auto">
    <header class="max-w-3xl mb-8">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Outdoor Capacity Guide</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-4">Best 4-Person Outdoor Saunas</h1>
      <p class="text-stone-500 text-sm">Listings reviewed {reviewedAt} · 11 min read</p>
      <p class="text-lg text-stone-700 mt-4">The right four-person sauna starts with the bench and site, not the capacity label. Compare the room shape, usable seating, heater package, power, freight, base, and weather scope before comparing finishes.</p>
    </header>

    <AdvertiserDisclosure />

    <div class="rounded-lg overflow-hidden mb-8">
      <img src="/images/lifestyle/barrel-sauna-chimney.jpg" alt="Representative outdoor barrel sauna with a chimney" class="w-full object-cover max-h-80" loading="lazy" width="1200" height="800" />
    </div>

    <aside class="border-y border-stone-200 py-6 mb-8">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">Treat four people as a maximum until the bench proves otherwise</h2>
      <p class="text-stone-700 mb-3">Capacity labels do not tell you whether four adults can sit comfortably, whether anyone can recline, or whether the heater and doorway reduce usable space.</p>
      <p class="text-sm text-stone-600">Prices below are retailer snapshots checked {priceCheckedAt}. Confirm stock, configuration, freight, tax, lead time, and final price before ordering.</p>
    </aside>

    <PlannerCTA source="best_4_person_outdoor_above_fold" heading="Turn the shortlist into a site-ready project brief" />

    <section class="mt-12" aria-labelledby="outdoor-four-shortlist">
      <h2 id="outdoor-four-shortlist" class="text-3xl font-bold text-stone-900 mb-3">Four current outdoor paths</h2>
      <p class="text-stone-600 max-w-3xl mb-8">These are not arbitrary rankings. Each listing represents a distinct footprint, room shape, heat source, and installation path.</p>

      <div class="space-y-10">
        {picks.filter((pick) => !pick.sponsor).map((pick) => (
          <section class="border-t border-stone-300 pt-7" aria-label={pick.name}>
            <div class="md:flex md:items-start md:justify-between gap-6 mb-4">
              <div>
                <p class="text-xs font-bold uppercase tracking-wide text-amber-700 mb-2">{pick.label}</p>
                <h3 class="text-2xl font-bold text-stone-900">{pick.name}</h3>
              </div>
              <p class="text-sm text-stone-600 mt-2 md:mt-1 shrink-0">Listed at review: <strong class="text-stone-900">{pick.reviewedPrice}</strong></p>
            </div>

            <p class="text-stone-700 mb-5"><strong>Who it may fit:</strong> {pick.fit}</p>

            <div class="grid md:grid-cols-2 gap-6 mb-5">
              <div>
                <h4 class="font-semibold text-stone-900 mb-2">Documented listing details</h4>
                <ul class="space-y-2 text-sm text-stone-700">
                  {pick.facts.map((fact) => <li class="flex gap-2"><span aria-hidden="true">+</span><span>{fact}</span></li>)}
                </ul>
              </div>
              <div>
                <h4 class="font-semibold text-stone-900 mb-2">Resolve before buying</h4>
                <ul class="space-y-2 text-sm text-stone-700">
                  {pick.questions.map((item) => <li class="flex gap-2"><span aria-hidden="true">-</span><span>{item}</span></li>)}
                </ul>
              </div>
            </div>

            <SelectSaunasButton href={pick.href} label="Check current price and availability" ctaPosition="best_4_person_outdoor_shortlist" />
          </section>
        ))}
      </div>
    </section>

    <section class="mt-14 border-t border-stone-300 pt-8" aria-labelledby="indoor-alternative">
      <h2 id="indoor-alternative" class="text-2xl font-bold text-stone-900 mb-5">Indoor alternative</h2>
      {picks.filter((pick) => pick.sponsor === 'sun-home').map((pick) => (
        <div class="border border-stone-300 bg-stone-50 rounded-lg overflow-hidden">
          {pick.image && <img src={pick.image} alt={pick.name} class="w-full h-auto object-cover max-h-80" loading="lazy" width="1080" height="1080" />}
          <div class="p-6">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-700 mb-2">{pick.tag}</p>
            <h3 class="text-2xl font-bold text-stone-900 mb-4">{pick.name}</h3>
            <p class="text-stone-700 mb-4">{pick.summary}</p>
            <p class="text-sm text-stone-700 mb-5"><strong>Who this is for:</strong> {pick.buyerFit}</p>
            <div class="grid md:grid-cols-2 gap-6 text-sm mb-5">
              <div><h4 class="font-semibold text-stone-900 mb-2">Pros</h4><ul class="space-y-2 text-stone-700">{pick.pros.map((item) => <li>+ {item}</li>)}</ul></div>
              <div><h4 class="font-semibold text-stone-900 mb-2">Cons</h4><ul class="space-y-2 text-stone-700">{pick.cons.map((item) => <li>- {item}</li>)}</ul></div>
            </div>
            <SunHomeButton product={pick.sunHomeProduct} label="See Sun Home Eclipse 4-Person" />
          </div>
        </div>
      ))}
    </section>

    <section class="mt-14 border-t border-stone-300 pt-8">
      <h2 class="text-2xl font-bold text-stone-900 mb-4">The checks that prevent expensive surprises</h2>
      <div class="grid md:grid-cols-2 gap-6 text-sm text-stone-700">
        <div><h3 class="font-bold text-stone-900 mb-2">Bench and doorway</h3><p>Compare usable bench length and depth, heater clearances, door swing, and the actual users. A capacity label is not a seating plan.</p></div>
        <div><h3 class="font-bold text-stone-900 mb-2">Room and heater manuals</h3><p>Use the selected room and heater documents. Glass area, room volume, insulation, ventilation, climate, and clearances can change the final requirement.</p></div>
        <div><h3 class="font-bold text-stone-900 mb-2">Freight and assembly</h3><p>Get shipment dimensions, weight, liftgate or unloading needs, carry path, damage process, crew size, and assembly scope in writing.</p></div>
        <div><h3 class="font-bold text-stone-900 mb-2">Base and weather scope</h3><p>Confirm the foundation, drainage, finished roofing, flashing, staining or sealing, snow or wind conditions, and local setbacks or permits.</p></div>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-stone-900 mb-5">Frequently asked questions</h2>
      <div class="divide-y divide-stone-200 border-y border-stone-200">
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">Will four adults fit comfortably?</h3><p class="text-stone-700 text-sm">Maybe, but the label alone cannot answer that. Compare the bench geometry, heater and door clearance, and the intended users. Size up if four adults will use it regularly and the site allows it.</p></div>
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">Does a four-person outdoor sauna need 240V?</h3><p class="text-stone-700 text-sm">Many traditional electric rooms do. The current Pinnacle listing specifies 240V / 30A hardwired service. The Cayenne infrared listing specifies 120V / 30A. Follow the exact product manuals and a licensed electrician's plan.</p></div>
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">What belongs in the quote?</h3><p class="text-stone-700 text-sm">Room, heater, controls, stones, guard, roofing, freight, unloading, base, assembly, power or chimney work, permits, tax, lead time, and warranty terms.</p></div>
      </div>
    </section>

    <div class="bg-stone-900 text-white rounded-lg p-6 md:p-8 mt-12">
      <h2 class="text-2xl font-bold mb-2">Estimate the full installed project</h2>
      <p class="text-stone-300 mb-5">Keep the room price separate from freight, unloading, foundation, electrical or chimney work, roofing, assembly, permits, and accessories.</p>
      <a href="/tools/sauna-cost-calculator/?ref=best_4_person_outdoor&campaign=project_budget&placement=best_4_person_outdoor_project_budget" class="inline-flex min-h-12 items-center justify-center bg-amber-400 hover:bg-amber-500 text-stone-900 font-semibold px-6 py-3 rounded-md transition-colors" data-track-event="calculator_cta_clicked" data-cta-position="best_4_person_outdoor_project_budget">Open the project calculator</a>
    </div>

    <div class="bg-stone-50 border border-stone-200 rounded-lg p-6 mt-10">
      <h2 class="text-lg font-bold text-stone-900 mb-2">Related guides</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/guides/best-6-person-sauna/" class="text-amber-700 hover:underline">Best 6-Person Saunas</a></li>
        <li><a href="/guides/best-cube-sauna/" class="text-amber-700 hover:underline">Best Cube Saunas</a></li>
        <li><a href="/guides/barrel-sauna-vs-cabin-sauna/" class="text-amber-700 hover:underline">Barrel Sauna vs Cabin Sauna</a></li>
        <li><a href="/guides/sauna-foundation-guide/" class="text-amber-700 hover:underline">Sauna Foundation Guide</a></li>
        <li><a href="/guides/sauna-electrical-requirements/" class="text-amber-700 hover:underline">Sauna Electrical Requirements</a></li>
      </ul>
    </div>
  </article>
</Base>
