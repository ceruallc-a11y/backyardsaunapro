---
import Base from '../../layouts/Base.astro';
import AdvertiserDisclosure from '../../components/AdvertiserDisclosure.astro';
import PlannerCTA from '../../components/PlannerCTA.astro';
import SelectSaunasButton from '../../components/SelectSaunasButton.astro';
import SunHomeButton from '../../components/SunHomeButton.astro';

const reviewedAt = 'August 15, 2026';

const picks = [
  {
    rank: 1,
    tag: 'CURRENT VALUE PATH',
    tagColor: 'bg-amber-100 text-amber-800',
    name: 'Dynamic Saunas Lugano 3-Person Low EMF FAR Infrared Sauna',
    type: 'Indoor infrared',
    capacity: '3 people (published)',
    reviewedPrice: '$2,699',
    selectSaunasHref: 'https://selectsaunas.com/products/dynamic-saunas-dyn-6336-02-lugano-3-person-low-emf-far-infrared-sauna',
    buyerFit: 'An indoor buyer who wants a published three-person cabin and can provide the required 120V / 20A electrical service.',
    documented: ['60 x 45 x 75-inch exterior', '57 x 41 x 69-inch interior', '120V / 20A electrical service', 'Nine carbon heating panels'],
    questions: ['Will 57 inches of interior width work for the intended three users?', 'Is a dedicated 20A circuit already available?', 'Does the current model number, stock status, and warranty match the listing?'],
  },
  {
    rank: 2,
    tag: 'INDOOR TRADITIONAL PATH',
    tagColor: 'bg-emerald-100 text-emerald-800',
    name: 'Almost Heaven Auburn 2-3 Person Indoor Sauna',
    type: 'Indoor traditional',
    capacity: '2-3 people (published)',
    reviewedPrice: '$5,049',
    selectSaunasHref: 'https://selectsaunas.com/products/almost-heaven-auburn-2-3-person-indoor-sauna',
    buyerFit: 'A household that wants an indoor traditional room with rocks and water, plus a full-length upper bench.',
    documented: ['70 x 47 x 78-inch exterior', '65 x 42 x 77-inch interior', '65 x 22-inch upper bench', '6kW heater; 240V / 30A hardwired service'],
    questions: ['Will the 65-inch bench and shorter lower extension suit all three users?', 'Can the room, floor, delivery path, and electrical panel support the project?', 'Which lumber, door, heater, lead time, and warranty terms are in the final order?'],
  },
  {
    rank: 3,
    tag: 'OUTDOOR BARREL PATH',
    tagColor: 'bg-stone-900 text-amber-100',
    name: 'SaunaLife E6 3-Person Barrel Sauna',
    type: 'Outdoor traditional barrel',
    capacity: '3 people (published)',
    reviewedPrice: '$5,340',
    selectSaunasHref: 'https://selectsaunas.com/products/saunalife-model-e6-sauna-barrel-ergo-series-sauna-barrel-59x81',
    buyerFit: 'An outdoor buyer who wants a current three-person barrel listing and is prepared to scope the heater, base, freight, electrical or chimney work, and assembly separately.',
    documented: ['59 x 81-inch listed format', '6-foot-5-inch published interior height', 'Thermo-Spruce shell and Thermo-Aspen seating', 'Shingle roof kit and dual floor drains listed'],
    questions: ['Which heater and controls are included, if any?', 'What unloading and assembly help is needed at the site?', 'What base, clearances, roof details, power, and local approvals apply?'],
  },
  {
    rank: 4,
    sponsor: "sun-home",
    sunHomeProduct: "luminar",
    name: "Sun Home Luminar 2-Person Outdoor Infrared Sauna",
    rating: "Premium",
    tag: "BEST PREMIUM 2-PERSON INFRARED",
    tagColor: "bg-purple-100 text-purple-800",
    type: "Outdoor Infrared",
    capacity: "True 2-person",
    summary: "The Luminar is a true 2-person infrared cabin, not a 3-person sauna. It earns a spot here for a specific case: a three-person household where two adults are the primary daily users and the third joins occasionally. Trying to wedge three adults into the Luminar is not the right move, but trying to oversize to a 4-person barrel when only two people will actually use the sauna day to day is the opposite mistake. Full-spectrum infrared, chromotherapy, finished outdoor aesthetics, and no 240V install.",
    pros: ["Premium full-spectrum infrared (near, mid, far)", "No 240V install, no separate heater purchase", "Faster heat-up than a barrel plus electric heater", "Built and finished for outdoor placement"],
    cons: ["True 2-person layout, not for 3 adults at once", "Significantly higher price than any barrel kit", "Lower max temperature than traditional sauna", "No steam option"],
    buyerFit: "Best for a 3-person household where two adults will use the sauna regularly and the third uses it occasionally. The wrong pick if all three plan to sauna together as a routine.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Are there true 3-person saunas?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Current three-person options include infrared cabins, indoor traditional rooms, outdoor barrels, and outdoor cube cabins. Capacity is still a label, so compare interior and bench dimensions with the intended users.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can three adults use a 2-person sauna?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Do not assume they can. A two-person label is already a published maximum. Three-person households with only two regular users may still prefer a two-person sauna, but three routine users should compare true three-person models.',
      },
    },
    {
      '@type': 'Question',
      name: 'What electrical service does a 3-person sauna need?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'It depends on the exact heater and model. The Lugano listing specifies 120V and 20A. The Auburn traditional sauna listing specifies a 6kW heater with 240V and 30A hardwired service, plus separate lighting power. Follow the current manuals and local requirements.',
      },
    },
  ],
};
---
<Base
  title="Best 3-Person Saunas (2026): Current Buyer-Fit Shortlist"
  description="Compare current 3-person indoor infrared, indoor traditional, and outdoor barrel saunas using published dimensions, electrical requirements, and exact retailer listings."
  canonical="/guides/best-3-person-sauna"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-4xl mx-auto">
    <header class="mb-8 max-w-3xl">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Capacity Buying Guide</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-4">Best 3-Person Saunas</h1>
      <p class="text-stone-500 text-sm">Listings reviewed {reviewedAt} · 9 min read</p>
      <p class="text-lg text-stone-600 mt-4">Three-person saunas do exist. The useful question is whether the published interior and bench dimensions fit your three users, not whether a product card says “3 person.”</p>
    </header>

    <AdvertiserDisclosure />

    <div class="rounded-lg overflow-hidden mb-8">
      <img src="/images/lifestyle/barrel-sauna-field.jpg" alt="Representative outdoor barrel sauna on a prepared site" class="w-full object-cover max-h-80" loading="lazy" width="1200" height="800" />
    </div>

    <aside class="border-y border-stone-200 py-6 mb-8">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">Capacity labels are the starting point</h2>
      <p class="text-stone-700 mb-3">A published capacity does not tell you shoulder room, bench depth, usable bench length, door clearance, or whether all users can sit at the preferred height. Compare those details before price.</p>
      <p class="text-sm text-stone-600">Prices below are retailer snapshots from {reviewedAt}. Confirm stock, freight, tax, configuration, and final price before ordering.</p>
    </aside>

    <PlannerCTA source="best_3_person_sauna_above_fold" heading="Check the users, bench, power, and delivery path together" />

    <section class="mt-12" aria-labelledby="current-shortlist">
      <h2 id="current-shortlist" class="text-3xl font-bold mb-3 text-stone-900">Current paths for a three-person household</h2>
      <p class="text-stone-600 mb-8 max-w-3xl">The first three products are current exact-model listings for three simultaneous users. The protected Sun Home placement remains a separate two-regular-user case.</p>

      <div class="space-y-8">
        {picks.map((pick) => pick.sponsor === 'sun-home' ? (
          <div class="bg-white border border-stone-200 rounded-xl shadow-sm overflow-hidden">
            <div class="overflow-hidden">
              <img src="/images/sun-home/luminar.jpg" alt="Sun Home Luminar 2-Person Outdoor Infrared sauna in a backyard" class="w-full h-auto object-cover max-h-72" loading="lazy" width="1600" height="1067" />
            </div>
            <div class="p-6">
              <div class="flex items-start justify-between mb-3">
                <span class={`text-xs font-bold px-2 py-1 rounded ${pick.tagColor}`}>#{pick.rank} {pick.tag}</span>
                <span class="text-xs text-stone-400">{pick.type} · {pick.capacity}</span>
              </div>
              <h3 class="text-xl font-bold text-stone-900 mb-2">{pick.name}</h3>
              <p class="text-stone-600 text-sm mb-4">{pick.summary}</p>
              {pick.buyerFit && (
                <div class="bg-stone-50 border border-stone-200 rounded-lg p-4 mb-4 text-sm text-stone-700">
                  <strong class="block text-stone-900 mb-1">Who this is for</strong>
                  {pick.buyerFit}
                </div>
              )}
              <div class="grid md:grid-cols-2 gap-3 mb-4 text-sm">
                <div>
                  <p class="font-bold text-green-700 text-xs uppercase mb-1">Pros</p>
                  {pick.pros.map(p => <p class="text-stone-600"> {p}</p>)}
                </div>
                <div>
                  <p class="font-bold text-red-600 text-xs uppercase mb-1">Cons</p>
                  {pick.cons.map(c => <p class="text-stone-600"> {c}</p>)}
                </div>
              </div>
              <p class="text-xs text-stone-400 mb-2">Rating: {pick.rating}</p>
              <SunHomeButton product={pick.sunHomeProduct} label="See Sun Home Luminar" />
            </div>
          </div>
        ) : (
          <section class="border-t border-stone-300 pt-7" aria-label={pick.name}>
            <div class="md:flex md:items-start md:justify-between gap-6 mb-4">
              <div>
                <p class={`inline-block text-xs font-bold px-2 py-1 rounded mb-2 ${pick.tagColor}`}>#{pick.rank} {pick.tag}</p>
                <h3 class="text-2xl font-bold text-stone-900">{pick.name}</h3>
                <p class="text-sm text-stone-500 mt-1">{pick.type} · {pick.capacity}</p>
              </div>
              <p class="text-sm text-stone-600 mt-2 md:mt-1 shrink-0">Listed at review: <strong class="text-stone-900">{pick.reviewedPrice}</strong></p>
            </div>

            <p class="text-stone-700 mb-5"><strong>Who it may fit:</strong> {pick.buyerFit}</p>

            <div class="grid md:grid-cols-2 gap-6 mb-5">
              <div>
                <h4 class="font-semibold text-stone-900 mb-2">Documented listing details</h4>
                <ul class="space-y-2 text-sm text-stone-700">
                  {pick.documented.map((item) => <li class="flex gap-2"><span aria-hidden="true">+</span><span>{item}</span></li>)}
                </ul>
              </div>
              <div>
                <h4 class="font-semibold text-stone-900 mb-2">Resolve before buying</h4>
                <ul class="space-y-2 text-sm text-stone-700">
                  {pick.questions.map((item) => <li class="flex gap-2"><span aria-hidden="true">-</span><span>{item}</span></li>)}
                </ul>
              </div>
            </div>

            <SelectSaunasButton href={pick.selectSaunasHref} label="Check current listing" ctaPosition="best_3_person_shortlist" />
          </section>
        ))}
      </div>
    </section>

    <section class="mt-14 border-t border-stone-300 pt-8">
      <h2 class="text-2xl font-bold mb-4 text-stone-900">How to compare the formats</h2>
      <div class="grid md:grid-cols-3 gap-6 text-sm text-stone-700">
        <div><h3 class="font-bold text-stone-900 mb-2">Indoor infrared</h3><p>Check interior width, the dedicated circuit, room clearances, and whether three adults can sit as planned.</p></div>
        <div><h3 class="font-bold text-stone-900 mb-2">Indoor traditional</h3><p>Check bench lengths, heater manual, hardwired service, suitable floor, ventilation, and delivery weight.</p></div>
        <div><h3 class="font-bold text-stone-900 mb-2">Outdoor barrel</h3><p>Check the heater package, base, roof, drainage, freight access, assembly scope, clearances, and local approvals.</p></div>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold mb-5 text-stone-900">Frequently asked questions</h2>
      <div class="divide-y divide-stone-200 border-y border-stone-200">
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">Are there true 3-person saunas?</h3><p class="text-stone-700 text-sm">Yes. The shortlist includes current products explicitly published for three or two-to-three people. Capacity still needs a dimension check.</p></div>
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">Can three adults use a 2-person sauna?</h3><p class="text-stone-700 text-sm">Do not plan on it. A two-person label is already a published maximum. A two-person sauna can fit a three-person household only when no more than two people expect to use it together.</p></div>
        <div class="py-5"><h3 class="font-bold text-stone-900 mb-1">What power does a 3-person sauna need?</h3><p class="text-stone-700 text-sm">The exact model decides. The Lugano listing specifies 120V / 20A. The Auburn listing specifies a 6kW heater with 240V / 30A hardwired service plus separate lighting power. Follow the manuals and local requirements.</p></div>
      </div>
    </section>

    <div class="bg-stone-900 text-white rounded-lg p-6 md:p-8 mt-12">
      <h2 class="text-2xl font-bold mb-2">Compare the whole project, not one capacity label</h2>
      <p class="text-stone-300 mb-5">Use the cost calculator for the product, freight, base, electrical work, assembly, and accessories before asking a dealer for a final quote.</p>
      <a href="/tools/sauna-cost-calculator/" class="inline-flex min-h-12 items-center justify-center bg-amber-400 hover:bg-amber-500 text-stone-900 font-semibold px-6 py-3 rounded-md transition-colors">Estimate the project total</a>
    </div>

    <div class="bg-stone-50 border border-stone-200 rounded-lg p-6 mt-10">
      <h2 class="text-lg font-bold text-stone-900 mb-2">Related guides</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/guides/best-2-person-outdoor-sauna/" class="text-amber-700 hover:underline">Best 2-Person Outdoor Sauna</a></li>
        <li><a href="/guides/best-4-person-sauna/" class="text-amber-700 hover:underline">Best 4-Person Sauna</a></li>
        <li><a href="/guides/sauna-electrical-requirements/" class="text-amber-700 hover:underline">Sauna Electrical Requirements</a></li>
        <li><a href="/guides/sauna-foundation-guide/" class="text-amber-700 hover:underline">Sauna Foundation Guide</a></li>
      </ul>
    </div>
  </article>
</Base>
