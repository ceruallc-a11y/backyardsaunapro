---
import Base from '../../layouts/Base.astro';
import PlannerCTA from '../../components/PlannerCTA.astro';

const faqs = [
  {
    question: 'What is a wood-fired sauna tent?',
    answer: 'It is an outdoor portable enclosure designed around a compatible stove, chimney, chimney jack, ventilation opening, anchoring system, and operating instructions. It is not the same product category as an indoor portable steam enclosure.',
  },
  {
    question: 'Can I use a sauna tent indoors?',
    answer: 'Do not assume so. Sweat Tent currently says its wood-fired system is outdoor-only. CPSC warns not to use fuel-burning camping equipment inside a tent unless it is specifically designed for enclosed use and provides instructions for that use. Follow the complete system manual and local fire rules.',
  },
  {
    question: 'Can I pair any tent with any wood stove?',
    answer: 'No. Match the tent, stove, chimney, chimney jack, spark arrestor, floor protection, clearances, ventilation, and anchoring from written manufacturer instructions. Sweat Tent currently warns that a third-party stove may damage its tent and is not covered by its warranty.',
  },
  {
    question: 'Is a wood-fired sauna tent the same as a portable steam sauna?',
    answer: 'No. A wood-fired outdoor tent uses combustion and a vented chimney. A portable steam enclosure uses an electric steamer and has different temperatures, moisture, electrical requirements, cleaning, and risks. Compare them as separate formats.',
  },
];
---
<Base
  title="Wood-Fired Sauna Tent Guide: System, Safety, and Buyer Checks"
  description="Choose a portable wood-fired sauna tent by matched stove system, chimney, anchoring, ventilation, outdoor use, maintenance, local fire rules, and current documentation."
  canonical="/guides/sauna-tent"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  })} />

  <article class="max-w-4xl mx-auto">
    <header class="max-w-3xl mb-8">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Portable wood-fired sauna</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-4">A sauna tent is a matched combustion system, not just a hot shelter</h1>
      <p class="text-lg text-stone-700 mb-3">The useful comparison starts with the tent, stove, chimney, jack, ventilation, anchoring, surface, weather limits, and written instructions. A cheap tent and a familiar stove are not automatically compatible.</p>
      <p class="text-stone-500 text-sm">Reviewed August 16, 2026 &mdash; Backyard Sauna Pro</p>
    </header>

    <div class="bg-red-50 border border-red-200 rounded-lg p-5 mb-8 text-sm text-stone-700">
      <strong>Carbon-monoxide and fire boundary:</strong> CPSC says never to use fuel-burning camping equipment inside a tent unless the equipment is specifically designed for enclosed use and provides safe-use instructions for that setting. A sauna-tent claim does not replace the complete manufacturer manual, local fire rules, active supervision, or immediate evacuation if symptoms or an alarm occur.
    </div>

    <section class="bg-stone-900 text-white rounded-lg p-6 mb-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-amber-300 mb-2">Short answer</p>
      <h2 class="text-2xl font-bold mb-3">Buy the documented system or do not buy the setup.</h2>
      <p class="text-stone-200 mb-5">Start with a manufacturer that publishes the intended environment, included stove, chimney interface, ventilation, staking, weather limits, maintenance, storage, warranty, and replacement path. Check current availability only after those pieces match your site.</p>
      <a href="https://www.sweattent.com/products/sweattent" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center rounded-md bg-amber-400 px-5 py-3 font-semibold text-stone-900 hover:bg-amber-500" data-track-event="brand_outbound_click" data-partner="sweat_tent" data-cta-position="sauna_tent_above_fold">Check one current complete-system example</a>
    </section>

    <PlannerCTA
      source="sauna_tent_after_verdict"
      heading="Compare the portable system with the real site"
      description="Record the outdoor location, surface, setbacks, nearby combustibles, wind exposure, storage, users, local fire restrictions, budget, ZIP code, and timeline before buying."
    />

    <h2 class="text-2xl font-bold text-stone-900 mt-10 mb-4">First separate the product categories</h2>
    <div class="overflow-x-auto border border-stone-200 rounded-lg mb-10">
      <table class="w-full min-w-[760px] text-sm text-left">
        <thead class="bg-stone-100 text-stone-900"><tr><th class="px-4 py-3">Format</th><th class="px-4 py-3">Heat system</th><th class="px-4 py-3">Intended setting</th><th class="px-4 py-3">Main verification burden</th></tr></thead>
        <tbody class="divide-y divide-stone-200 text-stone-700">
          <tr class="align-top"><th scope="row" class="px-4 py-3 text-stone-900">Wood-fired sauna tent</th><td class="px-4 py-3">Matched stove, chimney, jack, ventilation, and sauna rocks</td><td class="px-4 py-3">Outdoor use under system-specific conditions</td><td class="px-4 py-3">Combustion, CO, fire clearance, anchoring, wind, fuel, ash, chimney, and storage</td></tr>
          <tr class="align-top"><th scope="row" class="px-4 py-3 text-stone-900">Portable steam enclosure</th><td class="px-4 py-3">Electric steam generator and hose</td><td class="px-4 py-3">Model-specific indoor setup</td><td class="px-4 py-3">Circuit, water, steam hose, timer, tip-over and low-water protection, cleaning, and drying</td></tr>
          <tr class="align-top"><th scope="row" class="px-4 py-3 text-stone-900">Trailer or cabin sauna</th><td class="px-4 py-3">Permanent or vehicle-mounted room and listed heater system</td><td class="px-4 py-3">Fixed site or road-going project</td><td class="px-4 py-3">Structure, foundation or trailer, utilities, permits, insurance, delivery, and installation</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-stone-900 mt-10 mb-4">Two current documentation paths</h2>
    <div class="grid md:grid-cols-2 gap-5 mb-10">
      <section class="border border-stone-200 rounded-lg p-5 bg-white">
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-700 mb-2">Complete bundle example</p>
        <h3 class="text-xl font-bold text-stone-900 mb-3">Sweat Tent L and XL</h3>
        <p class="text-sm text-stone-700 mb-4">The current manufacturer page describes 6-by-6-by-7-foot and 10-by-10-by-7-foot tents with a purpose-built stove, chimney, rocks and holder, cover, tools, manual, carry bags, stakes, and ropes. The manufacturer says outdoor-only, stable ground, and no third-party stove. Availability and bundle contents can change.</p>
        <a href="https://www.sweattent.com/pages/frequently-asked-questions" target="_blank" rel="noopener" class="text-sm font-semibold text-amber-700 hover:underline">Read the current system FAQ</a>
      </section>
      <section class="border border-stone-200 rounded-lg p-5 bg-white">
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-700 mb-2">Tent-document example</p>
        <h3 class="text-xl font-bold text-stone-900 mb-3">MORZH MAX</h3>
        <p class="text-sm text-stone-700 mb-4">The current technical certificate documents a 2.96-by-2.3-meter insulated tent with two 90 mm chimney openings, a combustion-air window, guy ropes, and specific wind, spark-arrestor, chimney-cleaning, drying, and storage instructions. The tent document does not make every stove compatible.</p>
        <a href="https://morzh.eu/wa-data/public/site/morzh/MORZH%20MAX%20.pdf" target="_blank" rel="noopener" class="text-sm font-semibold text-amber-700 hover:underline">Read the current technical certificate</a>
      </section>
    </div>

    <h2 class="text-2xl font-bold text-stone-900 mt-10 mb-4">Resolve these checks before purchase</h2>
    <ol class="list-decimal pl-5 space-y-4 text-stone-700 mb-10">
      <li><strong class="text-stone-900">Matched components:</strong> obtain the tent, stove, chimney, chimney jack, spark arrestor, rock basket, floor protection, and clearance instructions as one documented system.</li>
      <li><strong class="text-stone-900">Outdoor location:</strong> check local fire restrictions, burn bans, setbacks, overhead branches, dry vegetation, structures, public access, and emergency response.</li>
      <li><strong class="text-stone-900">Stable setup:</strong> follow the exact surface, stakes, ropes, skirts, ballast, and wind limits. Do not improvise anchoring where a hot stove could contact fabric.</li>
      <li><strong class="text-stone-900">Ventilation and chimney:</strong> keep the specified air opening clear, assemble every chimney section correctly, use the required spark control, and inspect and clean the flue on schedule.</li>
      <li><strong class="text-stone-900">Supervision:</strong> never sleep with the heater running, never leave it unattended, keep children and impaired users out, and establish an unobstructed exit.</li>
      <li><strong class="text-stone-900">Fuel and hot surfaces:</strong> use only allowed fuel, do not use accelerants, maintain clearances, control ash, and let the stove and chimney cool before handling or packing.</li>
      <li><strong class="text-stone-900">Dry storage:</strong> dry the tent after use, inspect seams and the chimney jack, protect parts during transport, and store the system as the manufacturer directs.</li>
      <li><strong class="text-stone-900">Commercial terms:</strong> verify the live bundle, stock, shipping, return window, warranty exclusions, replacement fabric, stove parts, and chimney parts before paying.</li>
    </ol>

    <div class="border-l-4 border-amber-600 bg-amber-50 p-5 mb-10 text-sm text-stone-700">
      <strong>Do not substitute a cabin stove by reputation alone.</strong> Harvia documents the M3 for a 212–459 ft³ sauna room and publishes model-specific clearances. That does not establish compatibility with a portable tent, chimney jack, floor, fabric, or anchoring system.
    </div>

    <h2 class="text-2xl font-bold text-stone-900 mt-10 mb-4">Primary sources checked</h2>
    <ul class="space-y-3 text-sm text-stone-700 mb-10">
      <li><a href="https://www.cpsc.gov/safety-education/safety-guides/carbon-monoxide/carbon-monoxide-fact-sheet" target="_blank" rel="noopener" class="font-semibold text-amber-700 hover:underline">CPSC: carbon-monoxide fact sheet and enclosed-tent warning</a></li>
      <li><a href="https://www.cpsc.gov/Safety-Education/Safety-Education-Centers/Carbon-Monoxide-Information-Center/Portable-Heaters--Camping-Equipment" target="_blank" rel="noopener" class="font-semibold text-amber-700 hover:underline">CPSC: portable heaters and camping equipment</a></li>
      <li><a href="https://www.sweattent.com/products/sweattent" target="_blank" rel="noopener" class="font-semibold text-amber-700 hover:underline">Sweat Tent: current product, bundle, and system specifications</a></li>
      <li><a href="https://www.sweattent.com/pages/frequently-asked-questions" target="_blank" rel="noopener" class="font-semibold text-amber-700 hover:underline">Sweat Tent: current operating, storage, and compatibility FAQ</a></li>
      <li><a href="https://morzh.eu/wa-data/public/site/morzh/MORZH%20MAX%20.pdf" target="_blank" rel="noopener" class="font-semibold text-amber-700 hover:underline">MORZH MAX: current technical certificate</a></li>
      <li><a href="https://www.harvia.com/en-US/products/WKM3/m3-black" target="_blank" rel="noopener" class="font-semibold text-amber-700 hover:underline">Harvia M3: current room range, clearances, and manual access</a></li>
    </ul>

    <h2 class="text-2xl font-bold text-stone-900 mt-10 mb-4">Frequently asked questions</h2>
    <div class="space-y-5 mb-10">
      {faqs.map((faq) => <div><h3 class="font-bold text-stone-900 mb-1">{faq.question}</h3><p class="text-stone-700">{faq.answer}</p></div>)}
    </div>

    <div class="bg-stone-50 border border-stone-200 rounded-lg p-6 mt-10">
      <h2 class="text-lg font-bold text-stone-900 mb-2">Continue comparing</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/guides/best-portable-sauna/" class="text-amber-700 hover:underline">Compare portable steam enclosures</a></li>
        <li><a href="/guides/mobile-sauna-for-sale/" class="text-amber-700 hover:underline">Compare trailer-mounted saunas</a></li>
        <li><a href="/guides/wood-burning-sauna/" class="text-amber-700 hover:underline">Plan a wood-fired sauna system</a></li>
        <li><a href="/guides/best-barrel-sauna-kits/" class="text-amber-700 hover:underline">Compare permanent barrel kits</a></li>
      </ul>
    </div>
  </article>
</Base>
