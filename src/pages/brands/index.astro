---
import Base from '../../layouts/Base.astro';

const brands = [
  {
    href: "/brands/sun-home-saunas-review/",
    name: "Sun Home Saunas",
    desc: "Premium infrared and red light sauna brand. Equinox, Luminar, Eclipse models with verified EMF, VOC, and temperature testing. (Featured partner.)",
    featured: true,
  },
  {
    href: "/brands/almost-heaven-sauna-review/",
    name: "Almost Heaven Saunas",
    desc: "The most popular US barrel sauna brand. Quality, value, and best models reviewed.",
  },
  {
    href: "/brands/dundalk-leisurecraft-review/",
    name: "Dundalk LeisureCraft",
    desc: "Premium Canadian-made barrel saunas. Thick clear cedar and 30+ year build quality reviewed.",
  },
  {
    href: "/brands/redwood-outdoors-sauna-review/",
    name: "Redwood Outdoors",
    desc: "Premium Thermowood barrel and cabin saunas. Better outdoor durability than cedar, is the premium worth it?",
  },
  {
    href: "/brands/finnleo-sauna-review/",
    name: "Finnleo Saunas",
    desc: "Premium Finnish brand with strong US dealer support. Who it's for and whether the price premium is worth it.",
  },
  {
    href: "/brands/harvia-sauna-heater-review/",
    name: "Harvia Sauna Heaters",
    desc: "The world's most popular sauna heater brand. KIP, M3, Cilindro reviewed and sized for your room.",
  },
  {
    href: "/brands/huum-sauna-heater-review/",
    name: "HUUM Sauna Heaters",
    desc: "Estonian heaters with exceptional design, and the UL listing issue US buyers need to know.",
  },
  {
    href: "/brands/dynamic-saunas-review/",
    name: "Dynamic Saunas",
    desc: "The top-rated plug-in infrared sauna brand. What they get right, where they cut corners, and which model to buy.",
  },
  {
    href: "/brands/finnish-sauna-builders-review/",
    name: "Finnish Sauna Builders",
    desc: "Specialty sauna retailer carrying Almost Heaven, Dundalk, and HUUM. Strong customer service, worth the slight premium?",
  },
];
---
<Base
  title="Sauna Brand Reviews | Backyard Sauna Pro"
  description="Honest brand overviews for the top outdoor and infrared sauna manufacturers: Sun Home, Almost Heaven, Dundalk, Harvia, Dynamic Saunas, and more."
  canonical="/brands"
>
  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold text-stone-900 mb-2">Sauna Brand Reviews</h1>
    <p class="text-stone-500 mb-10">Who makes a good sauna, and who to avoid. Brand-by-brand breakdowns.</p>

    <div class="grid md:grid-cols-2 gap-4">
      {brands.map(brand => (
        <a href={brand.href} class={`block rounded-xl p-4 hover:shadow transition-all ${brand.featured ? 'bg-stone-50 border border-stone-300 hover:border-stone-400' : 'bg-white border border-stone-200 hover:border-amber-400'}`}>
          {brand.featured && (
            <span class="text-xs italic text-stone-500 block mb-1">Paid partner</span>
          )}
          <h2 class="font-bold text-stone-900 mb-1">{brand.name}</h2>
          <p class="text-stone-500 text-sm">{brand.desc}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
