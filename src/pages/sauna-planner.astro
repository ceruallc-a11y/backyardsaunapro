---
import Base from '../layouts/Base.astro';
---
<Base
  title="Free Sauna Project Planner: Create a Buyer Brief"
  description="Create a private sauna project brief with your site, size, heater, budget, timing, utility, delivery, and installation requirements."
  canonical="/sauna-planner"
>
  <article class="max-w-3xl mx-auto">
    <header class="mb-8">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Free planning tool</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-4">Build a sauna project brief before you contact sellers</h1>
      <p class="text-lg text-stone-700">Turn the basic decisions into one summary you can use for quotes. Your planning answers stay in this browser unless you explicitly request a review.</p>
    </header>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8 text-sm text-stone-700">
      <strong>Privacy:</strong> Creating the brief does not submit or store it. If you request a review, Backyard Sauna Pro securely stores the contact and project information you choose to send. Partner sharing is separate and optional.
    </div>

    <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-5 mb-8 text-sm text-stone-700">
      <strong class="block text-stone-900 mb-1">First 10 complete briefs reviewed free</strong>
      During this pilot, we will manually review the first 10 complete project briefs and reply with practical questions to verify before you request quotes. We will not send your information to a seller or installer without separate consent.
    </div>

    <form id="sauna-planner" class="bg-white border border-stone-200 rounded-xl p-5 md:p-7 space-y-6">
      <div>
        <p class="text-xs font-bold uppercase tracking-wide text-amber-700 mb-1">Step 1 of 2</p>
        <h2 class="text-xl font-bold text-stone-900">Create the private project brief</h2>
        <p class="text-sm text-stone-600 mt-1">Complete the six required choices and ZIP code. Dimensions, utility status, installation help, and notes can stay unknown.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">Project location</span><select name="location" required class="w-full border border-stone-300 rounded-md px-3 py-3 bg-white"><option value="">Choose one</option><option>Outdoor</option><option>Indoor</option><option>Unsure</option></select></label>
        <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">Heat type</span><select name="heatType" required class="w-full border border-stone-300 rounded-md px-3 py-3 bg-white"><option value="">Choose one</option><option>Traditional electric</option><option>Wood-fired</option><option>Infrared</option><option>Steam</option><option>Undecided</option></select></label>
        <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">Expected users</span><select name="users" required class="w-full border border-stone-300 rounded-md px-3 py-3 bg-white"><option value="">Choose one</option><option>1-2 people</option><option>3-4 people</option><option>5-6 people</option><option>7+ people</option></select></label>
        <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">Target budget</span><select name="budget" required class="w-full border border-stone-300 rounded-md px-3 py-3 bg-white"><option value="">Choose one</option><option>Under $5,000 installed</option><option>$5,000-$10,000 installed</option><option>$10,000-$20,000 installed</option><option>$20,000+ installed</option><option>Not set</option></select></label>
        <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">Purchase timeline</span><select name="timeline" required class="w-full border border-stone-300 rounded-md px-3 py-3 bg-white"><option value="">Choose one</option><option>Within 30 days</option><option>1-3 months</option><option>3-6 months</option><option>6-12 months</option><option>Researching only</option></select></label>
        <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">Project type</span><select name="projectType" required class="w-full border border-stone-300 rounded-md px-3 py-3 bg-white"><option value="">Choose one</option><option>Existing space</option><option>New detached structure</option><option>New construction or remodel</option><option>Portable or plug-in unit</option><option>Undecided</option></select></label>
        <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">Available dimensions <span class="font-normal text-stone-500">(optional)</span></span><input name="dimensions" type="text" maxlength="80" placeholder="Example: 8 ft x 10 ft area" class="w-full border border-stone-300 rounded-md px-3 py-3" /></label>
        <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">Project ZIP code</span><input name="region" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" pattern="[0-9]{5}(-[0-9]{4})?" title="Enter a five-digit U.S. ZIP code or ZIP+4." placeholder="Example: 02139" required class="w-full border border-stone-300 rounded-md px-3 py-3" /></label>
        <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">Electrical status <span class="font-normal text-stone-500">(optional)</span></span><select name="electrical" class="w-full border border-stone-300 rounded-md px-3 py-3 bg-white"><option>Unknown</option><option>Electrician has reviewed the site</option><option>Panel capacity is known</option><option>Planning wood-fired, not electric</option></select></label>
        <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">Installation help <span class="font-normal text-stone-500">(optional)</span></span><select name="installation" class="w-full border border-stone-300 rounded-md px-3 py-3 bg-white"><option>Undecided</option><option>Need full installation help</option><option>Need electrical or chimney work only</option><option>Planning DIY kit assembly</option><option>Have a contractor</option></select></label>
      </div>

      <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">Delivery, access, or product preferences <span class="font-normal text-stone-500">(optional)</span></span><textarea name="notes" maxlength="500" rows="4" placeholder="Gate width, stairs, crane concerns, preferred brands, accessibility needs, or other constraints" class="w-full border border-stone-300 rounded-md px-3 py-3"></textarea></label>

      <button type="submit" class="w-full sm:w-auto bg-stone-900 hover:bg-stone-700 text-white font-semibold px-6 py-3 rounded-md">Create my project brief</button>
    </form>

    <section id="planner-result" class="hidden mt-8 bg-white border border-stone-200 rounded-xl p-5 md:p-7" aria-live="polite">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">Your project brief</h2>
      <p class="text-sm text-stone-600 mb-4">Review it before sharing. A seller or installer still needs to verify product, code, site, and trade requirements.</p>
      <textarea id="planner-summary" rows="16" readonly class="w-full border border-stone-300 rounded-md px-3 py-3 text-sm bg-stone-50"></textarea>
      <div class="flex flex-wrap gap-3 mt-4">
        <button id="copy-brief" type="button" class="bg-stone-200 hover:bg-stone-300 text-stone-900 font-semibold px-5 py-3 rounded-md">Copy brief</button>
      </div>
      <p id="copy-status" class="text-sm text-stone-600 mt-3" aria-live="polite"></p>

      <div class="border-t border-stone-200 mt-7 pt-7">
        <p class="text-xs font-bold uppercase tracking-wide text-amber-700 mb-1">Step 2 of 2 &middot; Optional</p>
        <h3 class="text-xl font-bold text-stone-900 mb-2">Request a free manual review</h3>
        <p class="text-sm text-stone-600 mb-5">Send the brief to Backyard Sauna Pro. We will review it before any possible introduction to a seller or installer.</p>
        <form id="lead-review-form" class="space-y-5" data-track-start-event="lead_form_started">
          <div class="grid sm:grid-cols-2 gap-5">
            <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">First name</span><input name="firstName" type="text" autocomplete="given-name" maxlength="60" required class="w-full border border-stone-300 rounded-md px-3 py-3" /></label>
            <label class="block"><span class="block text-sm font-semibold text-stone-900 mb-2">Email</span><input name="email" type="email" autocomplete="email" maxlength="160" required class="w-full border border-stone-300 rounded-md px-3 py-3" /></label>
            <label class="block sm:col-span-2"><span class="block text-sm font-semibold text-stone-900 mb-2">Phone <span class="font-normal text-stone-500">(optional)</span></span><input name="phone" type="tel" autocomplete="tel" maxlength="40" class="w-full border border-stone-300 rounded-md px-3 py-3" /></label>
          </div>
          <label class="hidden" aria-hidden="true">Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
          <label class="flex gap-3 text-sm text-stone-700">
            <input name="contactConsent" type="checkbox" required class="mt-1 h-4 w-4 shrink-0" />
            <span>I want Backyard Sauna Pro to review this project and contact me about it. <a href="/privacy/" class="text-amber-700 underline">Privacy details</a>.</span>
          </label>
          <label class="flex gap-3 text-sm text-stone-700">
            <input name="partnerConsent" type="checkbox" class="mt-1 h-4 w-4 shrink-0" />
            <span>After manual review, Backyard Sauna Pro may share this project and my contact details with one relevant seller or installer. This is optional.</span>
          </label>
          <button id="submit-review" type="submit" class="w-full sm:w-auto bg-amber-600 hover:bg-amber-700 disabled:bg-stone-400 text-white font-semibold px-6 py-3 rounded-md">Send for review</button>
          <p id="lead-status" class="text-sm text-stone-700" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <div class="mt-10 text-sm text-stone-600">
      <p>For immediate self-service planning, continue with the <a href="/tools/sauna-cost-calculator/" class="text-amber-700 hover:underline">project cost calculator</a> and <a href="/guides/outdoor-sauna-buying-checklist/" class="text-amber-700 hover:underline">outdoor sauna buying checklist</a>.</p>
    </div>
  </article>

  <script>
    const form = document.getElementById('sauna-planner');
    const result = document.getElementById('planner-result');
    const summary = document.getElementById('planner-summary');
    const copyButton = document.getElementById('copy-brief');
    const copyStatus = document.getElementById('copy-status');
    const leadForm = document.getElementById('lead-review-form');
    const leadStatus = document.getElementById('lead-status');
    const leadSubmit = document.getElementById('submit-review');
    const leadEndpoint = 'https://backyard-sauna-leads.adunyadeth.workers.dev/v1/leads';
    const campaignParams = new URLSearchParams(window.location.search);
    const acquisitionSource = campaignParams.get('ref') || campaignParams.get('utm_source') || 'direct';
    const acquisitionCampaign = campaignParams.get('campaign') || campaignParams.get('utm_campaign') || '';
    const acquisitionContent = campaignParams.get('placement') || campaignParams.get('utm_content') || 'direct';
    let started = false;
    let reviewStarted = false;
    let plannerValues = {};

    if (form instanceof HTMLFormElement) {
      form.addEventListener('input', () => {
        if (started) return;
        started = true;
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'sauna_planner_started', {
            site_name: 'backyard_sauna_pro',
            site_hostname: window.location.hostname,
            page_path: window.location.pathname,
            acquisition_source: acquisitionSource,
            acquisition_campaign: acquisitionCampaign,
            acquisition_content: acquisitionContent,
          });
        }
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const values = Object.fromEntries(new FormData(form).entries());
        plannerValues = values;
        const budgetScore = values.budget === '$20,000+ installed' ? 3 : values.budget === '$10,000-$20,000 installed' ? 2 : values.budget === '$5,000-$10,000 installed' ? 1 : 0;
        const timelineScore = values.timeline === 'Within 30 days' ? 3 : values.timeline === '1-3 months' ? 2 : values.timeline === '3-6 months' ? 1 : 0;
        const readinessScore = budgetScore + timelineScore
          + (values.dimensions ? 1 : 0)
          + (values.region ? 1 : 0)
          + (values.electrical === 'Electrician has reviewed the site' || values.electrical === 'Panel capacity is known' ? 2 : 0)
          + (values.installation !== 'Undecided' ? 1 : 0);
        const readiness = readinessScore >= 7 ? 'Ready for seller or installer review' : readinessScore >= 4 ? 'Needs a few project details' : 'Early planning stage';
        const nextStep = readinessScore >= 7
          ? 'Request written quotes that separate product, freight, site work, electrical or chimney work, permits, and installation.'
          : readinessScore >= 4
            ? 'Confirm dimensions, utility capacity, access, and the installed budget before requesting quotes.'
            : 'Use the buying checklist and cost calculator before choosing a model or seller.';
        const lines = [
          'BACKYARD SAUNA PRO - PROJECT BRIEF',
          '',
          `Planning readiness: ${readiness}`,
          `Recommended next step: ${nextStep}`,
          '',
          `Location: ${values.location}`,
          `Heat type: ${values.heatType}`,
          `Expected users: ${values.users}`,
          `Installed budget: ${values.budget}`,
          `Timeline: ${values.timeline}`,
          `Project type: ${values.projectType}`,
          `Available dimensions: ${values.dimensions || 'Not provided'}`,
          `Project ZIP code: ${values.region || 'Not provided'}`,
          `Electrical status: ${values.electrical}`,
          `Installation help: ${values.installation}`,
          `Other constraints: ${values.notes || 'None provided'}`,
          '',
          'Please help me identify the next verification steps. I understand that product specifications, site conditions, code, permits, and trade requirements must be confirmed before purchase or installation.'
        ];
        const text = lines.join('\n');

        if (summary instanceof HTMLTextAreaElement) summary.value = text;
        result?.classList.remove('hidden');
        result?.scrollIntoView({ behavior: 'smooth', block: 'start' });

        if (typeof window.gtag === 'function') {
          window.gtag('event', 'sauna_planner_completed', {
            site_name: 'backyard_sauna_pro',
            site_hostname: window.location.hostname,
            page_path: window.location.pathname,
            project_location: String(values.location),
            heat_type: String(values.heatType),
            budget_range: String(values.budget),
            timeline: String(values.timeline),
            lead_readiness: readinessScore >= 7 ? 'high' : readinessScore >= 4 ? 'medium' : 'early',
            acquisition_source: acquisitionSource,
            acquisition_campaign: acquisitionCampaign,
            acquisition_content: acquisitionContent,
          });
        }
      });
    }

    copyButton?.addEventListener('click', async () => {
      if (!(summary instanceof HTMLTextAreaElement)) return;
      try {
        await navigator.clipboard.writeText(summary.value);
        if (copyStatus) copyStatus.textContent = 'Brief copied.';
      } catch {
        summary.select();
        if (copyStatus) copyStatus.textContent = 'Select and copy the highlighted brief.';
      }
    });

    if (leadForm instanceof HTMLFormElement) {
      leadForm.addEventListener('input', () => {
        if (reviewStarted) return;
        reviewStarted = true;
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'lead_form_started', {
            site_name: 'backyard_sauna_pro',
            site_hostname: window.location.hostname,
            page_path: window.location.pathname,
            acquisition_source: acquisitionSource,
            acquisition_campaign: acquisitionCampaign,
            acquisition_content: acquisitionContent,
          });
        }
      });

      leadForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!leadForm.reportValidity() || !Object.keys(plannerValues).length) return;

        const contact = new FormData(leadForm);
        const payload = {
          ...plannerValues,
          firstName: String(contact.get('firstName') || ''),
          email: String(contact.get('email') || ''),
          phone: String(contact.get('phone') || ''),
          website: String(contact.get('website') || ''),
          contactConsent: contact.get('contactConsent') === 'on',
          partnerConsent: contact.get('partnerConsent') === 'on',
          sourcePath: `${window.location.pathname}${window.location.search}`,
          acquisitionSource,
        };

        if (leadSubmit instanceof HTMLButtonElement) {
          leadSubmit.disabled = true;
          leadSubmit.textContent = 'Sending...';
        }
        if (leadStatus) leadStatus.textContent = '';

        try {
          const response = await fetch(leadEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await response.json();
          if (!response.ok || !data.ok) throw new Error(data.error || 'We could not receive the request.');

          if (data.stored === false) {
            if (leadStatus) leadStatus.textContent = 'Received. We will review your request and email you if follow-up is needed.';
            leadForm.reset();
            return;
          }
          if (!data.receiptId) throw new Error('We could not confirm the request.');

          if (leadStatus) {
            const sharingStatus = payload.partnerConsent
              ? 'You allowed one relevant seller or installer to receive the project after our manual review.'
              : 'You did not request partner sharing, so we will keep the project with Backyard Sauna Pro.';
            leadStatus.textContent = data.duplicate
              ? `We already received this request. Your reference is ${data.receiptId}. ${sharingStatus}`
              : `Received. Your reference is ${data.receiptId}. We will review it and email you within 1-2 business days. ${sharingStatus}`;
          }
          leadForm.reset();
          if (typeof window.gtag === 'function') {
            window.gtag('event', data.duplicate ? 'lead_duplicate_detected' : 'lead_submitted', {
              site_name: 'backyard_sauna_pro',
              site_hostname: window.location.hostname,
              page_path: window.location.pathname,
              partner_sharing_consent: payload.partnerConsent ? 'yes' : 'no',
              acquisition_source: acquisitionSource,
              acquisition_campaign: acquisitionCampaign,
              acquisition_content: acquisitionContent,
            });
          }
        } catch (error) {
          if (leadStatus) leadStatus.textContent = error instanceof Error ? `${error.message} Please try again or contact info@backyardsaunapro.com.` : 'We could not receive the request. Please try again.';
        } finally {
          if (leadSubmit instanceof HTMLButtonElement) {
            leadSubmit.disabled = false;
            leadSubmit.textContent = 'Send for review';
          }
        }
      });
    }
  </script>
</Base>
