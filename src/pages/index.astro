---
import Base from '../layouts/Base.astro';
import AdvertiserDisclosure from '../components/AdvertiserDisclosure.astro';
import AmazonButton from '../components/AmazonButton.astro';
import SunHomeButton from '../components/SunHomeButton.astro';
import LeadMagnetSignup from '../components/LeadMagnetSignup.astro';

const featuredPicks = [
  {
    sponsor: "sun-home",
    sunHomeProduct: "equinox",
    image: "/images/sun-home/equinox.jpg",
    name: "Sun Home Equinox 2-Person Full-Spectrum Infrared",
    rating: "Premium",
    blurb: "Premium full-spectrum infrared cabin. Plug-in 120V install, integrated chromotherapy, and a finished design-forward build. Our pick for premium home sauna in 2026.",
    tag: "BEST OVERALL"
  },
  {
    asin: "B017WJV8SO",
    name: "Almost Heaven Pinnacle 4-Person Barrel Sauna",
    price: "",
    rating: "4.5/5",
    blurb: "The most popular outdoor barrel sauna on Amazon. Canadian red cedar, solid hardware, and a genuine Finnish experience with rocks and steam.",
    tag: "BEST TRADITIONAL"
  },
  {
    asin: "B00A2F99F0",
    name: "Dynamic Saunas Barcelona Far Infrared",
    price: "",
    rating: "4.4/5",
    blurb: "Plugs into a standard outlet. Heats in 15 minutes. Low-EMF carbon panels. The easiest budget path to a real sauna experience without the installation complexity.",
    tag: "BEST BUDGET"
  }
];
---
<Base
  title="Backyard Sauna Pro | Best Outdoor Saunas Reviewed (2026)"
  description="Sauna guides written by people who've actually built one. Reviews, cost breakdowns, and buying guides for backyard saunas."
  canonical="/"
>
  <!-- Hero -->
  <section class="text-center py-12">
    <h1 class="text-4xl md:text-5xl font-bold text-stone-900 mb-4 leading-tight">
      Find the Right Backyard Sauna
    </h1>

    <AdvertiserDisclosure />
    <p class="text-lg text-stone-600 max-w-2xl mx-auto mb-8">
      Sauna guides written by people who've actually built one.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/best-saunas/" class="inline-block bg-stone-900 hover:bg-stone-700 text-white font-semibold px-8 py-4 rounded-lg transition-colors text-lg">
        See Top Picks →
      </a>
      <a href="/guides/outdoor-sauna-cost/" class="inline-block bg-amber-50 hover:bg-amber-100 text-stone-900 border border-amber-300 font-semibold px-8 py-4 rounded-lg transition-colors text-lg">
        What Does It Cost?
      </a>
    </div>
  </section>

  <LeadMagnetSignup />

  <!-- Featured Picks -->
  <section class="mt-12">
    <h2 class="text-2xl font-bold mb-2 text-stone-900">Our Top Picks for 2026</h2>
    <p class="text-stone-500 text-sm mb-6">Quick overview. <a href="/best-saunas/" class="text-amber-700 hover:underline">Full reviews here.</a></p>
    <div class="grid md:grid-cols-3 gap-6">
      {featuredPicks.map(pick => (
        <div class={`rounded-xl shadow-sm p-6 border flex flex-col ${pick.sponsor === 'sun-home' ? 'bg-stone-50 border-stone-300' : 'bg-white border-stone-200'}`}>
          {pick.sponsor === 'sun-home' && pick.image && (
            <div class="bg-white rounded-lg overflow-hidden mb-4">
              <img src={pick.image} alt={pick.name} class="w-full h-32 object-contain mx-auto" loading="lazy" />
            </div>
          )}
          <span class={`text-xs font-bold px-2 py-1 rounded w-fit mb-3 ${pick.sponsor === 'sun-home' ? 'bg-stone-900 text-amber-100' : 'bg-amber-100 text-amber-800'}`}>{pick.tag}</span>
          <h3 class="font-semibold text-stone-900 mb-2 leading-snug">{pick.name}</h3>
          <p class="text-sm text-stone-600 flex-grow mb-3">{pick.blurb}</p>
          <p class="text-xs text-stone-400 mb-3">Rating: {pick.rating}</p>
          {pick.sponsor === 'sun-home' ? (
            <SunHomeButton product={pick.sunHomeProduct} label="See Sun Home Equinox" />
          ) : (
            <AmazonButton asin={pick.asin} price={pick.price} />
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- 2026 Featured Guides -->
  <section class="mt-16">
    <h2 class="text-2xl font-bold mb-6 text-stone-900">New for 2026</h2>
    <div class="grid md:grid-cols-2 gap-4">
      {[
        ["/guides/best-infrared-sauna-of-2026/", "Best Infrared Sauna of 2026", "Premium full-spectrum cabins, budget plug-ins, and red light combos. Honest picks for every price point."],
        ["/guides/best-outdoor-sauna-of-2026/", "Best Outdoor Sauna of 2026", "Barrel kits, wood-burning bundles, and premium outdoor infrared. The full landscape compared."],
      ].map(([href, title, desc]) => (
        <a href={href} class="block bg-amber-50 border border-amber-300 rounded-xl p-5 hover:border-amber-500 hover:shadow transition-all">
          <p class="font-semibold text-stone-900">{title}</p>
          <p class="text-sm text-stone-600 mt-1">{desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Buying Guides -->
  <section class="mt-12">
    <h2 class="text-2xl font-bold mb-6 text-stone-900">Buying Guides</h2>
    <div class="grid md:grid-cols-2 gap-4">
      {[
        ["/guides/best-home-sauna/", "Best Home Sauna", "Top picks across every setup and budget. Premium infrared, traditional barrel, and budget plug-in."],
        ["/guides/best-indoor-sauna-kits/", "Best Indoor Sauna Kits", "Plug-in infrared and traditional steam kits compared for every budget and space."],
        ["/guides/best-saunas-under-5000", "Best Saunas Under $5,000", "The price range where quality and value actually meet."],
        ["/guides/best-saunas-under-2000", "Best Saunas Under $2,000", "Decent saunas exist under $2k. Here's where to find them."],
        ["/guides/best-4-person-outdoor-sauna", "Best 4-Person Outdoor Saunas", "What '4-person' actually means and the best options."],
        ["/guides/best-2-person-outdoor-sauna", "Best 2-Person Outdoor Saunas", "Top picks for couples and smaller yards."],
        ["/guides/best-sauna-for-small-backyard", "Best Sauna for a Small Backyard", "Compact options and space-saving strategies."],
        ["/guides/best-electric-sauna-heaters", "Best Electric Sauna Heaters", "Budget to premium. Which one is actually worth it."],
        ["/guides/best-wood-burning-sauna-heaters", "Best Wood-Burning Sauna Heaters", "Harvia, HUUM, and the top stoves reviewed."],
        ["/guides/best-barrel-saunas-cold-climates", "Best Barrel Saunas for Cold Climates", "Winter-ready picks that handle extreme temps."],
        ["/guides/best-sauna-accessories", "Best Sauna Accessories", "Everything you need for day one."],
      ].map(([href, title, desc]) => (
        <a href={href} class="block bg-white border border-stone-200 rounded-xl p-4 hover:border-amber-400 hover:shadow transition-all">
          <p class="font-semibold text-stone-900 text-sm">{title}</p>
          <p class="text-xs text-stone-500 mt-1">{desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Planning & Installation -->
  <section class="mt-10">
    <h2 class="text-2xl font-bold mb-6 text-stone-900">Planning & Installation</h2>
    <div class="grid md:grid-cols-2 gap-4">
      {[
        ["/guides/outdoor-sauna-cost", "How Much Does an Outdoor Sauna Cost?", "Full cost breakdown including electrical, foundation, and accessories."],
        ["/guides/how-much-space-for-backyard-sauna", "How Much Space Do You Need?", "Dimensions, clearances, and footprint planning."],
        ["/guides/best-location-backyard-sauna", "Best Location for a Backyard Sauna", "Drainage, privacy, sun exposure, and codes."],
        ["/guides/sauna-foundation-guide", "Sauna Foundation Guide", "Concrete, gravel, or timber frames. All the options compared."],
        ["/guides/sauna-electrical-requirements", "Sauna Electrical Requirements", "Circuit sizes, costs, and permit requirements."],
        ["/guides/how-to-assemble-barrel-sauna", "How to Assemble a Barrel Sauna", "Step-by-step from unboxing to first heat."],
        ["/guides/sauna-maintenance-guide", "Sauna Maintenance Guide", "Keep your sauna lasting 20-40 years."],
      ].map(([href, title, desc]) => (
        <a href={href} class="block bg-white border border-stone-200 rounded-xl p-4 hover:border-amber-400 hover:shadow transition-all">
          <p class="font-semibold text-stone-900 text-sm">{title}</p>
          <p class="text-xs text-stone-500 mt-1">{desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Comparisons & Health -->
  <section class="mt-10">
    <h2 class="text-2xl font-bold mb-6 text-stone-900">Comparisons & Research</h2>
    <div class="grid md:grid-cols-2 gap-4">
      {[
        ["/guides/infrared-vs-traditional-sauna", "Infrared vs Traditional Sauna", "The real differences in heat, cost, and installation."],
        ["/guides/barrel-sauna-vs-cabin-sauna", "Barrel Sauna vs Cabin Sauna", "Heat efficiency, cost, and which to choose."],
        ["/guides/electric-vs-wood-fired-sauna", "Electric vs Wood-Fired Sauna", "Convenience vs. authenticity. The honest take."],
        ["/guides/sauna-health-benefits", "Sauna Health Benefits: What Science Says", "Cardiovascular gains, better sleep, faster recovery. Here's the evidence."],
      ].map(([href, title, desc]) => (
        <a href={href} class="block bg-white border border-stone-200 rounded-xl p-4 hover:border-amber-400 hover:shadow transition-all">
          <p class="font-semibold text-stone-900 text-sm">{title}</p>
          <p class="text-xs text-stone-500 mt-1">{desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Reviews -->
  <section class="mt-10">
    <h2 class="text-2xl font-bold mb-6 text-stone-900">In-Depth Reviews</h2>
    <div class="grid md:grid-cols-2 gap-4">
      {[
        ["/reviews/almost-heaven-pinnacle-review", "Almost Heaven Pinnacle Barrel Sauna Review", "The best-selling outdoor barrel sauna. Is it worth it?"],
        ["/reviews/harvia-kip-60b-review", "Harvia KIP 60B Electric Heater Review", "The most popular sauna heater in Finland, tested."],
      ].map(([href, title, desc]) => (
        <a href={href} class="block bg-white border border-stone-200 rounded-xl p-4 hover:border-amber-400 hover:shadow transition-all">
          <p class="font-semibold text-stone-900 text-sm">{title}</p>
          <p class="text-xs text-stone-500 mt-1">{desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Why trust us -->
  <section class="mt-16 bg-stone-100 rounded-xl p-8 text-center">
    <h2 class="text-xl font-bold mb-3 text-stone-900">How We Review Saunas</h2>
    <p class="text-stone-600 max-w-2xl mx-auto text-sm">
      We don't just read spec sheets. Every recommendation comes from digging into real owner experiences, verifying manufacturer claims, and mapping out the full cost. Not just the kit price. Affiliate links keep the site running at no extra cost to you.
    </p>
  </section>
</Base>
