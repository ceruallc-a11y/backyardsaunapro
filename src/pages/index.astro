---
import Base from '../layouts/Base.astro';
import AdvertiserDisclosure from '../components/AdvertiserDisclosure.astro';
import AmazonButton from '../components/AmazonButton.astro';
import SunHomeButton from '../components/SunHomeButton.astro';
import LeadMagnetSignup from '../components/LeadMagnetSignup.astro';

const featuredPicks = [
  {
    sponsor: "sun-home",
    sunHomeProduct: "equinox",
    image: "/images/sun-home/equinox.jpg",
    name: "Sun Home Equinox 2-Person Full-Spectrum Infrared",
    rating: "Premium",
    blurb: "Premium full-spectrum infrared cabin. Plug-in 120V install, integrated chromotherapy, and a finished design-forward build. Our pick for premium home sauna in 2026.",
    tag: "BEST OVERALL"
  },
  {
    asin: "B017WJV8SO",
    image: "/images/editorial/outdoor-barrel-sauna-representative.webp",
    imageAlt: "Representative outdoor barrel sauna on a gravel base",
    name: "Almost Heaven Pinnacle 4-Person Barrel Sauna",
    price: "",
    format: "Traditional outdoor barrel",
    blurb: "A traditional outdoor barrel with 63.25-inch benches, 240V heater configurations, and water-on-stones heat when the selected heater permits it.",
    tag: "BEST TRADITIONAL"
  },
  {
    asin: "B00A2F99F0",
    image: "/images/editorial/indoor-infrared-sauna-representative.webp",
    imageAlt: "Representative compact indoor infrared sauna cabin",
    name: "Dynamic Saunas Barcelona Far Infrared",
    price: "",
    format: "Compact 120V infrared cabin",
    blurb: "A compact indoor infrared cabin that uses a standard 120V receptacle. Check the room, dedicated-circuit guidance, delivery route, and current seller before ordering.",
    tag: "BEST BUDGET"
  }
];

const buyingGuides = [
  ["/guides/best-home-sauna/", "Best Home Sauna", "Top picks across every setup and budget."],
  ["/guides/best-indoor-sauna-kits/", "Best Indoor Sauna Kits", "Finished infrared cabins and traditional room kits."],
  ["/guides/best-saunas-under-5000/", "Best Saunas Under $5,000", "Where quality and value meet."],
  ["/guides/best-saunas-under-2000/", "Best Saunas Under $2,000", "The better options below $2,000."],
  ["/guides/best-4-person-outdoor-sauna/", "Best 4-Person Outdoor Saunas", "Real capacity, dimensions, and tradeoffs."],
  ["/guides/best-2-person-outdoor-sauna/", "Best 2-Person Outdoor Saunas", "Strong options for couples and smaller yards."],
  ["/guides/best-sauna-for-small-backyard/", "Best Sauna for a Small Backyard", "Compact formats and space-saving strategies."],
  ["/guides/best-electric-sauna-heaters/", "Best Electric Sauna Heaters", "Budget to premium heater comparisons."],
  ["/guides/best-wood-burning-sauna-heaters/", "Wood-Burning Sauna Heater Guide", "Compare current Harvia and HUUM formats by room, loading, and installation."],
  ["/guides/best-barrel-saunas-cold-climates/", "Barrel Saunas for Cold Climates", "Winter-ready models and planning limits."],
  ["/guides/best-sauna-accessories/", "Sauna Accessories", "What you need now, what depends on the heater, and what can wait."]
];

const planningGuides = [
  ["/guides/outdoor-sauna-cost/", "Outdoor Sauna Cost", "Build the complete installed budget."],
  ["/guides/outdoor-sauna-buying-checklist/", "Outdoor Buying Checklist", "Verify the site, utilities, permits, freight, warranty, and installed scope."],
  ["/guides/how-much-space-for-backyard-sauna/", "Space and Clearances", "Plan dimensions, access, and usable footprint."],
  ["/guides/best-location-backyard-sauna/", "Choose the Location", "Drainage, privacy, exposure, and local rules."],
  ["/guides/sauna-foundation-guide/", "Foundation Guide", "Compare concrete, gravel, and timber frames."],
  ["/guides/sauna-electrical-requirements/", "Electrical Requirements", "Circuit sizes, costs, and permits."],
  ["/guides/how-to-build-a-sauna/", "Build Sequence", "Scope the room, envelope, ventilation, heater, and qualified trade work."],
  ["/guides/how-to-assemble-barrel-sauna/", "Barrel Sauna Assembly", "From delivery to first heat."],
  ["/guides/sauna-maintenance-guide/", "Maintenance Guide", "Protect the wood, heater, and interior."]
];

const researchGuides = [
  ["/guides/infrared-vs-traditional-sauna/", "Infrared vs Traditional", "Heat, cost, feel, and installation compared."],
  ["/guides/barrel-sauna-vs-cabin-sauna/", "Barrel vs Cabin", "Space, heat efficiency, and ownership tradeoffs."],
  ["/guides/electric-vs-wood-fired-sauna/", "Electric vs Wood-Fired", "Convenience, atmosphere, and site requirements."],
  ["/guides/sauna-health-benefits/", "Health Benefits Research", "What the evidence supports and what it does not."]
];

const reviewGuides = [
  ["/reviews/almost-heaven-pinnacle-review/", "Almost Heaven Pinnacle Review", "A buyer-focused look at the popular barrel sauna."],
  ["/reviews/harvia-kip-60b-review/", "Harvia KIP 60B Review", "Specifications, installation, and buyer-fit limits."],
  ["/brands/huum-sauna-heater-review/?ref=homepage&campaign=huum_package&placement=homepage_reviews", "HUUM DROP vs HIVE Mini", "Compare exact room ranges, heater-only pricing, and a control-and-stones package.", "homepage_reviews_huum"]
];

const featuredPick = featuredPicks[0];
const secondaryPicks = featuredPicks.slice(1);
---

<Base
  title="Home Sauna Buying Advice | Backyard Sauna Pro"
  description="Practical sauna buying, planning, and installation guidance for homeowners comparing indoor and outdoor saunas."
  canonical="/"
  mainClass="home-page"
>
  <section class="home-hero">
    <div class="max-w-7xl w-full mx-auto px-6 md:px-8 py-12 md:py-16 flex items-center">
      <div class="max-w-2xl">
        <AdvertiserDisclosure variant="hero" />
        <h1 class="display-type text-4xl md:text-6xl leading-[1.05] mb-5">
          Plan the right sauna for your home.
        </h1>
        <p class="text-lg md:text-xl text-white/80 max-w-[52ch] leading-relaxed mb-7">
          Compare types, budget the full project, and prepare for installation before you buy.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/sauna-planner/?ref=homepage&campaign=planner_first_10&placement=homepage_hero" class="home-action home-action-primary" data-track-event="planner_cta_clicked" data-cta-position="homepage_hero">Build your project brief</a>
          <a href="/best-saunas/" class="home-action home-action-secondary">Compare saunas</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f8faf8]" aria-label="Sauna planning path">
    <div class="max-w-7xl mx-auto px-6 md:px-8 py-8 md:py-10 grid md:grid-cols-3 gap-7 md:gap-10">
      <a href="/best-saunas/" class="home-step pt-4 group">
        <span class="home-step-number text-sm font-bold">01</span>
        <h2 class="text-lg font-bold mt-2 mb-1 group-hover:text-[#1c4a39]">Compare the format</h2>
        <p class="text-sm text-[#5a6962] leading-relaxed">Indoor or outdoor. Traditional or infrared. Start with the decision that shapes every other cost.</p>
      </a>
      <a href="/guides/outdoor-sauna-cost/" class="home-step pt-4 group">
        <span class="home-step-number text-sm font-bold">02</span>
        <h2 class="text-lg font-bold mt-2 mb-1 group-hover:text-[#1c4a39]">Build the real budget</h2>
        <p class="text-sm text-[#5a6962] leading-relaxed">Include freight, foundation, electrical work, permits, assembly, and the sauna itself.</p>
      </a>
      <a href="/sauna-planner/?ref=homepage&campaign=planner_first_10&placement=homepage_path" class="home-step pt-4 group" data-track-event="planner_cta_clicked" data-cta-position="homepage_path">
        <span class="home-step-number text-sm font-bold">03</span>
        <h2 class="text-lg font-bold mt-2 mb-1 group-hover:text-[#1c4a39]">Prepare the project</h2>
        <p class="text-sm text-[#5a6962] leading-relaxed">Turn the shortlist into dimensions, site questions, and a brief you can take to installers.</p>
      </a>
    </div>
  </section>

  <LeadMagnetSignup variant="home" />

  <section class="max-w-7xl mx-auto px-6 md:px-8 py-14 md:py-20">
    <div class="max-w-2xl mb-8 md:mb-10">
      <h2 class="display-type text-3xl md:text-5xl leading-tight mb-3">Three practical starting points.</h2>
      <p class="text-[#5a6962] leading-relaxed">A premium plug-in cabin, a traditional outdoor barrel, and a lower-cost infrared option. Read the limits before you choose.</p>
    </div>

    <div class="grid lg:grid-cols-[1.35fr_0.9fr] gap-6 items-stretch">
      <article class="home-feature home-feature-muted overflow-hidden grid md:grid-cols-[0.95fr_1.05fr]">
        <div class="bg-white p-6 md:p-8 flex items-center justify-center">
          <img src={featuredPick.image} alt={featuredPick.name} class="w-full max-h-[340px] object-contain" loading="lazy" width="800" height="600" />
        </div>
        <div class="p-6 md:p-8 flex flex-col">
          <span class="text-xs font-bold text-[#1c4a39] mb-4">{featuredPick.tag}</span>
          <h3 class="display-type text-2xl md:text-3xl leading-tight mb-3">{featuredPick.name}</h3>
          <p class="text-sm text-[#5a6962] leading-relaxed mb-4 flex-grow">{featuredPick.blurb}</p>
          <p class="text-xs text-[#5a6962] mb-4">Rating: {featuredPick.rating}</p>
          <SunHomeButton product={featuredPick.sunHomeProduct} label="See Sun Home Equinox" />
        </div>
      </article>

      <div class="home-feature overflow-hidden divide-y divide-[#d4ddd7]">
        {secondaryPicks.map(pick => (
          <article class="grid sm:grid-cols-[0.8fr_1.2fr] min-h-[250px]">
            <div class="bg-[#eef2ef] min-h-[180px] sm:min-h-full">
              <img src={pick.image} alt={pick.imageAlt} class="w-full h-full object-cover" loading="lazy" width="1536" height="1024" />
            </div>
            <div class="p-6 md:p-7 flex flex-col">
              <span class="text-xs font-bold text-[#1c4a39] mb-3">{pick.tag}</span>
              <h3 class="text-xl font-bold leading-snug mb-2">{pick.name}</h3>
              <p class="text-sm text-[#5a6962] leading-relaxed mb-4 flex-grow">{pick.blurb}</p>
              <p class="text-xs text-[#5a6962] mb-1">Format: {pick.format}</p>
              <p class="text-xs text-[#6f7d76] mb-4">Representative setup; not the exact model.</p>
              <AmazonButton asin={pick.asin} price={pick.price} class="w-full text-center" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-[#d4ddd7] bg-[#e8f0eb]">
    <div class="max-w-7xl mx-auto px-6 md:px-8 py-14 md:py-18">
      <h2 class="display-type text-3xl md:text-4xl mb-8">New buyer guides for 2026.</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <a href="/guides/best-infrared-sauna-of-2026/" class="home-photo-link home-feature overflow-hidden group">
          <div class="aspect-[16/9] overflow-hidden">
            <img src="/images/lifestyle/sauna-interior-forest-view.jpg" alt="Sauna benches facing a forest view" class="w-full h-full object-cover" loading="lazy" width="1200" height="800" />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 group-hover:text-[#1c4a39]">Best Infrared Sauna of 2026</h3>
            <p class="text-sm text-[#5a6962] leading-relaxed">Premium full-spectrum cabins, budget plug-ins, and red light combinations compared by buyer fit.</p>
          </div>
        </a>
        <a href="/guides/best-outdoor-sauna-of-2026/" class="home-photo-link home-feature overflow-hidden group">
          <div class="aspect-[16/9] overflow-hidden">
            <img src="/images/lifestyle/sauna-in-snow.jpg" alt="Outdoor sauna in a snowy landscape" class="w-full h-full object-cover" loading="lazy" width="1200" height="800" />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 group-hover:text-[#1c4a39]">Best Outdoor Sauna of 2026</h3>
            <p class="text-sm text-[#5a6962] leading-relaxed">Barrel kits, wood-burning bundles, and outdoor infrared options with installation context.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 md:px-8 py-14 md:py-20">
    <div class="max-w-2xl mb-9">
      <h2 class="display-type text-3xl md:text-5xl leading-tight mb-3">Use the guide that matches the decision.</h2>
      <p class="text-[#5a6962] leading-relaxed">Skip the generic research loop. Start with the purchase, planning, or comparison question in front of you.</p>
    </div>

    <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-x-8 gap-y-10">
      <div>
        <h3 class="text-lg font-bold mb-2">Choose a sauna</h3>
        {buyingGuides.map(([href, title, desc]) => (
          <a href={href} class="home-guide-link group">
            <span class="font-semibold group-hover:underline">{title}</span>
            <span class="block text-xs text-[#5a6962] mt-1 leading-relaxed">{desc}</span>
          </a>
        ))}
      </div>
      <div>
        <h3 class="text-lg font-bold mb-2">Plan the project</h3>
        {planningGuides.map(([href, title, desc]) => (
          <a href={href} class="home-guide-link group">
            <span class="font-semibold group-hover:underline">{title}</span>
            <span class="block text-xs text-[#5a6962] mt-1 leading-relaxed">{desc}</span>
          </a>
        ))}
      </div>
      <div>
        <h3 class="text-lg font-bold mb-2">Compare the tradeoffs</h3>
        {researchGuides.map(([href, title, desc]) => (
          <a href={href} class="home-guide-link group">
            <span class="font-semibold group-hover:underline">{title}</span>
            <span class="block text-xs text-[#5a6962] mt-1 leading-relaxed">{desc}</span>
          </a>
        ))}
      </div>
      <div>
        <h3 class="text-lg font-bold mb-2">Read the reviews</h3>
        {reviewGuides.map(([href, title, desc, ctaPosition]) => (
          <a href={href} class="home-guide-link group" data-track-event={ctaPosition ? "internal_offer_click" : undefined} data-cta-position={ctaPosition}>
            <span class="font-semibold group-hover:underline">{title}</span>
            <span class="block text-xs text-[#5a6962] mt-1 leading-relaxed">{desc}</span>
          </a>
        ))}
        <a href="/reviews/" class="home-action mt-5 bg-[#12372a] text-white hover:bg-[#1c4a39]">Browse reviews</a>
      </div>
    </div>
  </section>

  <section class="bg-white border-y border-[#d4ddd7]">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 items-stretch">
      <div class="min-h-[320px] lg:min-h-[460px]">
        <img src="/images/lifestyle/sauna-benches-stones.jpg" alt="Wood sauna benches and heater stones" class="w-full h-full object-cover" loading="lazy" width="1200" height="749" />
      </div>
      <div class="px-6 md:px-10 lg:px-14 py-12 md:py-16 flex flex-col justify-center">
        <h2 class="display-type text-3xl md:text-4xl leading-tight mb-4">Research should make the decision clearer.</h2>
        <p class="text-[#5a6962] leading-relaxed max-w-[58ch] mb-4">
          We compare documented specifications, installation requirements, warranty terms, retailer information, and attributable owner feedback.
        </p>
        <p class="text-sm text-[#5a6962] leading-relaxed max-w-[58ch] mb-6">
          Manufacturer claims stay labeled. Commercial relationships stay disclosed. We do not call a product tested unless firsthand evidence exists.
        </p>
        <a href="/how-we-review/" class="home-action bg-[#12372a] text-white hover:bg-[#1c4a39] w-fit">How we review</a>
      </div>
    </div>
  </section>
</Base>
