---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Subscription Confirmed | Backyard Sauna Pro"
  description="Your Backyard Sauna Pro newsletter subscription is confirmed."
  canonical="/newsletter/confirmed"
>
  <article class="max-w-2xl mx-auto text-center py-10">
    <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Confirmed</p>
    <h1 class="text-4xl font-bold text-stone-900 mb-4">You are on the list</h1>
    <p class="text-lg text-stone-700 mb-6">Start with the outdoor sauna buying checklist, then use the planning tools when you are ready to compare full project costs.</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/lead-magnets/outdoor-sauna-checklist.html" class="bg-stone-900 hover:bg-stone-700 text-white font-semibold px-5 py-3 rounded-md">Open the checklist</a>
      <a href="/sauna-planner/" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold px-5 py-3 rounded-md">Build a project brief</a>
    </div>
  </article>
  <script>
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'newsletter_signup_confirmed', {
        site_name: 'backyard_sauna_pro',
        site_hostname: window.location.hostname,
        form_id: '9452008',
        page_path: window.location.pathname,
        signup_status: 'confirmed',
      });
    }
  </script>
</Base>
