---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Check Your Email | Backyard Sauna Pro"
  description="Confirm your Backyard Sauna Pro newsletter subscription to receive the buying checklist and future buyer guidance."
  canonical="/newsletter/check-your-email"
>
  <article class="max-w-2xl mx-auto text-center py-10">
    <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">One step left</p>
    <h1 class="text-4xl font-bold text-stone-900 mb-4">Check your email to confirm</h1>
    <p class="text-lg text-stone-700 mb-6">Kit has sent a confirmation message. Open it and select the confirmation link before the address is added to the newsletter.</p>
    <div class="bg-white border border-stone-200 rounded-lg p-6 text-left mb-6">
      <h2 class="font-bold text-stone-900 mb-2">No message yet?</h2>
      <ul class="text-stone-700 space-y-2 list-disc pl-5">
        <li>Check spam, promotions, or junk folders.</li>
        <li>Allow a few minutes for delivery.</li>
        <li>Make sure the address was entered correctly, then try the form again.</li>
      </ul>
    </div>
    <a href="/lead-magnets/outdoor-sauna-checklist.html" class="inline-block bg-stone-900 hover:bg-stone-700 text-white font-semibold px-5 py-3 rounded-md">View the checklist now</a>
  </article>
</Base>
