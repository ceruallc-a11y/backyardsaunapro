---
import Base from '../../layouts/Base.astro';

const costItems = [
  ["sauna", "Sauna and heater package"],
  ["freight", "Freight, unloading, and storage"],
  ["tax", "Sales tax"],
  ["permits", "Permits, plans, and review fees"],
  ["foundation", "Foundation, drainage, and site work"],
  ["utilities", "Electrical or chimney work"],
  ["installation", "Assembly and contractor labor"],
  ["weather", "Roof and weather protection"],
  ["access", "Path, lighting, privacy, and access"],
  ["accessories", "Accessories and initial maintenance supplies"]
];
---
<Base
  title="Sauna Project Cost Calculator: Total Your Real Quotes"
  description="Total the sauna, freight, permits, foundation, electrical or chimney work, installation, weather protection, access, tax, and contingency."
  canonical="/tools/sauna-cost-calculator"
>
  <article class="max-w-3xl mx-auto">
    <header class="mb-8">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Free planning tool</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-4">Sauna Project Cost Calculator</h1>
      <p class="text-lg text-stone-700">Add your quotes and written allowances to estimate the complete installed project. Blank line items stay visible so a low subtotal does not look more complete than it is.</p>
    </header>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8 text-sm text-stone-700">
      <strong>Use real inputs:</strong> This calculator does not supply market prices. Labor, freight, permits, utilities, site conditions, products, and taxes vary. A total is only as complete as the quotes entered.
    </div>

    <form id="project-cost-form" class="bg-white border border-stone-200 rounded-xl p-5 md:p-7">
      <div class="space-y-4">
        {costItems.map(([name, label]) => (
          <label class="grid sm:grid-cols-[1fr_12rem] gap-2 sm:items-center border-b border-stone-100 pb-4">
            <span class="text-sm font-semibold text-stone-800">{label}</span>
            <span class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-500">$</span><input name={name} type="number" min="0" step="1" inputmode="decimal" placeholder="Unknown" class="w-full border border-stone-300 rounded-md pl-7 pr-3 py-2.5" /></span>
          </label>
        ))}
      </div>

      <label class="block mt-6"><span class="block text-sm font-semibold text-stone-800 mb-2">Contingency</span><select name="contingency" class="w-full sm:w-64 border border-stone-300 rounded-md px-3 py-2.5 bg-white"><option value="0">No contingency</option><option value="5">5%</option><option value="10" selected>10%</option><option value="15">15%</option><option value="20">20%</option></select></label>

      <button type="submit" class="mt-6 w-full sm:w-auto bg-stone-900 hover:bg-stone-700 text-white font-semibold px-6 py-3 rounded-md">Calculate project total</button>
    </form>

    <section id="cost-result" class="hidden mt-8 bg-stone-900 text-white rounded-xl p-6" aria-live="polite">
      <p class="text-sm text-stone-300 mb-1">Entered subtotal</p>
      <p id="cost-subtotal" class="text-2xl font-bold mb-5">$0</p>
      <p class="text-sm text-stone-300 mb-1">Contingency</p>
      <p id="cost-contingency" class="text-xl font-semibold mb-5">$0</p>
      <p class="text-sm text-amber-300 mb-1">Planning total</p>
      <p id="cost-total" class="text-4xl font-bold mb-5">$0</p>
      <div id="cost-missing" class="text-sm text-stone-300"></div>
    </section>

    <div class="mt-10 grid md:grid-cols-2 gap-4">
      <a href="/guides/outdoor-sauna-buying-checklist/" class="bg-white border border-stone-200 rounded-lg p-5 hover:border-amber-400"><strong class="block text-stone-900 mb-1">Find missing line items</strong><span class="text-sm text-stone-600">Use the verification-first buying checklist.</span></a>
      <a href="/tools/sauna-electricity-cost-calculator/" class="bg-white border border-stone-200 rounded-lg p-5 hover:border-amber-400"><strong class="block text-stone-900 mb-1">Estimate ongoing electricity</strong><span class="text-sm text-stone-600">Calculate monthly and annual heater energy cost.</span></a>
    </div>
  </article>

  <script>
    const form = document.getElementById('project-cost-form');
    const result = document.getElementById('cost-result');
    const subtotalOutput = document.getElementById('cost-subtotal');
    const contingencyOutput = document.getElementById('cost-contingency');
    const totalOutput = document.getElementById('cost-total');
    const missingOutput = document.getElementById('cost-missing');
    let started = false;

    const formatMoney = (value) => new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0,
    }).format(value);

    if (form instanceof HTMLFormElement) {
      form.addEventListener('input', () => {
        if (started) return;
        started = true;
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'calculator_started', {
            site_name: 'backyard_sauna_pro',
            site_hostname: window.location.hostname,
            calculator: 'sauna_project_cost',
            page_path: window.location.pathname,
          });
        }
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const fields = Array.from(form.querySelectorAll('input[type="number"]'));
        const subtotal = fields.reduce((sum, input) => sum + (Number(input.value) || 0), 0);
        const missing = fields.filter(input => input.value === '').map(input => input.closest('label')?.querySelector('span')?.textContent?.trim()).filter(Boolean);
        const rate = Number(data.get('contingency')) || 0;
        const contingency = subtotal * (rate / 100);
        const total = subtotal + contingency;

        if (subtotalOutput) subtotalOutput.textContent = formatMoney(subtotal);
        if (contingencyOutput) contingencyOutput.textContent = `${formatMoney(contingency)} (${rate}%)`;
        if (totalOutput) totalOutput.textContent = formatMoney(total);
        if (missingOutput) missingOutput.textContent = missing.length
          ? `Still unknown: ${missing.join(', ')}. Get quotes before treating this as a complete project total.`
          : 'All listed categories have an entry. Confirm each amount and keep a separate allowance for anything unique to the site.';
        result?.classList.remove('hidden');
        result?.scrollIntoView({ behavior: 'smooth', block: 'start' });

        if (typeof window.gtag === 'function') {
          window.gtag('event', 'calculator_completed', {
            site_name: 'backyard_sauna_pro',
            site_hostname: window.location.hostname,
            calculator: 'sauna_project_cost',
            page_path: window.location.pathname,
            missing_item_count: missing.length,
            contingency_rate: rate,
          });
        }
      });
    }
  </script>
</Base>
