---
import Base from '../layouts/Base.astro';
import AmazonButton from '../components/AmazonButton.astro';
import SelectSaunasButton from '../components/SelectSaunasButton.astro';
import SunHomeButton from '../components/SunHomeButton.astro';
import SponsoredNotice from '../components/SponsoredNotice.astro';

const picks = [
  {
    rank: 1,
    sponsor: "sun-home",
    sunHomeProduct: "equinox",
    image: "/images/sun-home/equinox.jpg",
    name: "Sun Home Equinox 2-Person Full-Spectrum Infrared",
    price: "",
    rating: "Premium",
    tag: "BEST OVERALL",
    tagColor: "bg-stone-900 text-amber-100",
    pros: ["Full-spectrum infrared (near, mid, far)", "Plug-in 120V install, no electrician", "Integrated chromotherapy and audio", "Premium kiln-dried eucalyptus build"],
    cons: ["Premium price tier", "Lower max temperature than traditional (around 165 \u00b0F)", "No rocks, no l\u00f6yly", "White-glove delivery logistics"],
    best_for: "Premium buyers who want a finished, design-forward infrared cabin for daily wellness use",
    type: "Premium Indoor Infrared",
    buyerFit: "Best for buyers shopping at the premium end who want full-spectrum infrared and a polished home setup. Not the right pick for budget shoppers, traditional Finnish-style users, or anyone wanting wood-burning or steam.",
  },
  {
    rank: 2,
    asin: "B017WJV8SO",
    name: "Almost Heaven Pinnacle 4-Person Barrel Sauna",
    price: "",
    rating: "4.5/5 ",
    tag: "BEST TRADITIONAL",
    tagColor: "bg-amber-100 text-amber-800",
    pros: ["Beautiful cedar construction", "Easy 4-6 hour assembly", "Great heat retention from barrel shape", "Works with most sauna heaters"],
    cons: ["Needs 240V heater (sold separately)", "Not for tight spaces"],
    best_for: "Homeowners who want a permanent, beautiful outdoor sauna with traditional Finnish heat",
    type: "Traditional / Barrel",
    selectSaunasCollection: "barrel-saunas"
  },
  {
    rank: 3,
    sponsor: "sun-home",
    sunHomeProduct: "luminar",
    image: "/images/sun-home/luminar.jpg",
    name: "Sun Home Luminar 2-Person Outdoor Infrared",
    price: "",
    rating: "Premium",
    tag: "BEST OUTDOOR",
    tagColor: "bg-stone-900 text-amber-100",
    pros: ["Patented aerospace-grade aluminum exterior", "Plug-in 120V install in most cases", "Native Sun Home app with remote preheat", "No annual staining or cover required"],
    cons: ["Premium price tier", "Lower max temperature than traditional", "No rocks, no l\u00f6yly", "Larger footprint than a 2-person barrel"],
    best_for: "Buyers who want a finished outdoor cabin that arrives ready to use with no foundation or electrical contractor",
    type: "Premium Outdoor Infrared",
    buyerFit: "Best for buyers who want a premium outdoor infrared cabin with a low-maintenance exterior. Not the right pick for buyers shopping on price, wanting wood-burning, or wanting traditional steam.",
  },
  {
    rank: 4,
    sponsor: "sun-home",
    sunHomeProduct: "eclipse",
    image: "/images/sun-home/eclipse.jpg",
    name: "Sun Home Eclipse 2-Person Red Light + Infrared",
    price: "",
    rating: "Premium",
    tag: "BEST RED LIGHT",
    tagColor: "bg-stone-900 text-amber-100",
    pros: ["Factory-integrated dual-tower red light (630-850nm, 1,800W)", "Native Sun Home app with guided breathwork", "Canadian red cedar interior", "Plug-in 120V install"],
    cons: ["Premium price tier", "Specific use case (RLT + infrared combined)", "Not a traditional sauna experience", "Higher cost than buying RLT + sauna separately"],
    best_for: "Buyers who want serious red light therapy and infrared in one cabin instead of two separate units",
    type: "Premium Indoor Red Light + Infrared",
    buyerFit: "Best for buyers who specifically want red light therapy integrated with their sauna in a single premium build. Not the right pick if you only want a sauna, only want a red light panel, or are budget-focused.",
  },
  {
    rank: 5,
    asin: "B00A2F99F0",
    name: "Dynamic Saunas Barcelona 1-2 Person Far Infrared",
    price: "",
    rating: "4.4/5 ",
    tag: "BEST BUDGET",
    tagColor: "bg-green-100 text-green-800",
    pros: ["Heats in just 15 minutes", "Low-EMF carbon panels", "Plugs into standard 120V outlet", "Compact fits in any room"],
    cons: ["1-2 person only", "No steam option"],
    best_for: "First-time buyers and smaller spaces",
    type: "Infrared / Indoor"
  },
  {
    rank: 6,
    asin: "B017WJV8SO",
    name: "Dundalk LeisureCraft Harmony 2-Person Sauna",
    price: "",
    rating: "4.8/5 ",
    tag: "BEST PREMIUM",
    tagColor: "bg-purple-100 text-purple-800",
    pros: ["Canadian white cedar stunning quality", "Built to last decades", "Proper Finnish sauna experience", "Excellent steam retention"],
    cons: ["Premium price", "Requires installation effort"],
    best_for: "Serious sauna users who want the real deal",
    type: "Traditional / Outdoor",
    selectSaunasCollection: "outdoor-saunas"
  },
  {
    rank: 7,
    asin: "B084GY5CHB",
    name: "SereneLife Portable Steam Sauna",
    price: "",
    rating: "4.2/5 ",
    tag: "BEST PORTABLE",
    tagColor: "bg-blue-100 text-blue-800",
    pros: ["Under $150", "Setup in minutes", "No installation", "Compact storage"],
    cons: ["Not the real sauna experience", "Limited to one person", "Shorter lifespan"],
    best_for: "Renters, travelers, or trying sauna before committing",
    type: "Portable Steam"
  }
];
---
<Base
  title="Best Backyard Saunas of 2026: Top Picks for Every Budget"
  description="Our top sauna picks for 2026. From premium infrared cabins to budget plug-ins and traditional Finnish barrels. Real picks, honest tradeoffs."
  canonical="/best-saunas"
>
  <article class="max-w-3xl mx-auto">
    <header class="mb-10">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Best Picks</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-4">
        Best Backyard Saunas of 2026
      </h1>
      <p class="text-stone-500 text-sm mb-4">Updated May 2026 · 12 min read</p>
      <p class="text-lg text-stone-600">
        We researched over 40 saunas comparing specs, real owner reviews, build quality, and long-term value. Here are the ones actually worth your money in 2026, with sponsored partner placements clearly disclosed above each card.
      </p>
    </header>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-8 text-sm text-stone-700">
      <strong>Disclosure:</strong> This page contains affiliate links. As an Amazon Associate I earn from qualifying purchases. We also work with Sun Home Saunas as a featured partner. That relationship is disclosed prominently next to every Sun Home placement below.
    </div>

    <div class="space-y-10">
      {picks.map(pick => (
        <div class={`border rounded-xl shadow-sm overflow-hidden ${pick.sponsor === 'sun-home' ? 'border-stone-300 bg-stone-50' : 'bg-white border-stone-200'}`}>
          {pick.sponsor === 'sun-home' && pick.image && (
            <div class={pick.sunHomeProduct === 'equinox' ? 'bg-white p-5' : 'overflow-hidden'}>
              <img src={pick.image} alt={pick.name} class={pick.sunHomeProduct === 'equinox' ? 'w-full h-auto object-contain max-h-72 mx-auto' : 'w-full h-auto object-cover max-h-72'} loading="lazy" width="1600" height="1067" />
            </div>
          )}
          <div class="p-6">
            {pick.sponsor === 'sun-home' && <SponsoredNotice />}
            <div class="flex items-start justify-between mb-3">
              <div>
                <span class={`text-xs font-bold px-2 py-1 rounded ${pick.tagColor}`}>#{pick.rank} {pick.tag}</span>
                <span class="ml-2 text-xs text-stone-400">{pick.type}</span>
              </div>
              <span class="text-sm font-semibold text-stone-600">{pick.rating}</span>
            </div>
            <h2 class="text-xl font-bold text-stone-900 mb-1">{pick.name}</h2>
            <p class="text-sm text-stone-500 mb-4">Best for: {pick.best_for}</p>
            {pick.buyerFit && (
              <div class="bg-white border border-stone-200 rounded-lg p-4 mb-4 text-sm text-stone-700">
                <strong class="block text-stone-900 mb-1">Who this is for</strong>
                {pick.buyerFit}
              </div>
            )}
            <div class="grid md:grid-cols-2 gap-4 mb-4">
              <div>
                <h4 class="text-xs font-bold text-green-700 uppercase mb-1">Pros</h4>
                <ul class="text-sm text-stone-600 space-y-1">
                  {pick.pros.map(p => <li> {p}</li>)}
                </ul>
              </div>
              <div>
                <h4 class="text-xs font-bold text-red-600 uppercase mb-1">Cons</h4>
                <ul class="text-sm text-stone-600 space-y-1">
                  {pick.cons.map(c => <li> {c}</li>)}
                </ul>
              </div>
            </div>
            <div class="flex flex-wrap gap-3">
              {pick.sponsor === 'sun-home' ? (
                <SunHomeButton product={pick.sunHomeProduct} label={`See Sun Home ${pick.sunHomeProduct.charAt(0).toUpperCase() + pick.sunHomeProduct.slice(1)}`} />
              ) : (
                <>
                  <AmazonButton asin={pick.asin} price={pick.price} />
                  {pick.selectSaunasCollection && <SelectSaunasButton collection={pick.selectSaunasCollection} label="Shop on Select Saunas" />}
                </>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <section class="mt-14">
      <h2 class="text-2xl font-bold mb-4 text-stone-900">How We Choose</h2>
      <p class="text-stone-600 mb-4">
        Every sauna on this list was evaluated on: build quality and materials, ease of assembly, real customer reviews (not just star ratings we read the 3-star ones), energy efficiency, warranty, and long-term durability reports.
      </p>
      <p class="text-stone-600">
        We don't test products we can't stand behind. If we wouldn't recommend it to a friend, it doesn't make the list.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold mb-4 text-stone-900">More Guides</h2>
      <ul class="space-y-2">
        <li><a href="/guides/infrared-vs-traditional-sauna/" class="text-amber-700 hover:underline">→ Infrared vs Traditional Sauna: Which Is Right for You?</a></li>
        <li><a href="/guides/best-saunas-under-2000/" class="text-amber-700 hover:underline">→ Best Backyard Saunas Under $2,000</a></li>
        <li><a href="/guides/how-to-assemble-barrel-sauna/" class="text-amber-700 hover:underline">→ How to Install a Barrel Sauna: Step-by-Step</a></li>
      </ul>
    </section>
  </article>
</Base>
