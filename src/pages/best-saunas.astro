const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Best Home Saunas of 2026",
  "datePublished": datePublished,
  "dateModified": dateModified,
  "author": { "@type": "Person", "name": "Aurec Senenoi", "url": "https://backyardsaunapro.com/about/" },
  "publisher": {
    "@type": "Organization",
    "name": "Backyard Sauna Pro",
    "logo": { "@type": "ImageObject", "url": "https://backyardsaunapro.com/images/brand/logo-icon.svg" }
  },
  "mainEntityOfPage": pageUrl
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://backyardsaunapro.com/" },
    { "@type": "ListItem", "position": 2, "name": "Best Home Saunas of 2026", "item": pageUrl }
  ]
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Best Home Saunas of 2026",
  "itemListElement": picks.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": { "@type": "Product", "name": p.name, "category": p.specs.type, "description": p.verdict }
  }))
};

const faqs = [
  { q: "Indoor or outdoor sauna: how should I decide?", a: "Start with the available site, weather exposure, delivery route, power or fuel, ventilation, drainage, permits, and the kind of heat you want. Indoor and outdoor models can use infrared or traditional heaters, so the location alone does not determine the heating format. Compare the exact model manual and local requirements before choosing." },
  { q: "What is the practical difference between infrared and traditional sauna?", a: "Infrared cabins use emitters and do not provide water-on-stones steam. Traditional saunas heat the room with a purpose-built heater and stones; whether water may be used depends on the heater instructions. Temperature, electrical load, ventilation, and session guidance vary by product, so use the selected model's current manual instead of a category-wide number." },
  { q: "Can I choose a sauna from the product price alone?", a: "No. Compare the delivered product with freight, unloading, foundation or flooring, electrical or chimney work, assembly, permits, tax, weather protection, and maintenance. A lower kit price can produce a higher completed-project cost when those items are excluded." },
  { q: "Which sauna claims should I verify before buying?", a: "Verify exact dimensions, comfortable capacity, heater and electrical requirements, delivery scope, assembly, warranty, returns, and current availability. Request model-specific documentation for EMF, red-light, performance, or therapeutic claims instead of relying on a marketplace badge or unsourced number." },
  { q: "Do home saunas require 240V?", a: "It depends on the exact heater. The Pinnacle configuration reviewed here publishes a 6kW, 240V, 30A hardwired heater, while the Dynamic Barcelona publishes 120V/15A service. Other models differ. Give the current heater manual and site plan to a qualified electrician before ordering." },
  { q: "How much space should I reserve?", a: "Use the product's current exterior dimensions, required clearances, door swing, ventilation, service access, and delivery path. Outdoor projects also need a base sized for the selected model and room for drainage and maintenance. Do not apply one generic clearance to every sauna." },
  { q: "How long will a home sauna last?", a: "We cannot support one reliable lifespan for an entire sauna category. Climate, wood, finish, heater use, ventilation, water management, installation quality, replacement-part availability, and maintenance all matter. Ask how the manufacturer supports the room, heater, controls, and replacement parts separately." },
  { q: "What maintenance should I plan for?", a: "Follow the room and heater manuals for cleaning, drying, fasteners, exterior finish, stones, ventilation, and electrical inspection. The tasks and intervals differ by product and climate. Save the manuals and warranty version that apply to the unit you receive." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<Base
  title="Best Home Saunas of 2026: A Buyer-Fit Shortlist"
  description="Compare current home sauna formats by space, electrical needs, site work, delivery, and buyer fit. Includes documented limitations and questions to verify before ordering."
  canonical="/best-saunas"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-3xl mx-auto">
    <header class="mb-8">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Best Picks</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-3">
        Best Home Saunas of 2026
      </h1>
      <p class="text-sm text-stone-500 italic mb-4">
        By <a href="/about/" class="hover:text-amber-700 underline-offset-2 hover:underline">Aurec Senenoi</a> · Updated {updated} · Retail links reviewed {availabilityReviewed}
      </p>
      <p class="text-lg text-stone-600">
        The home-sauna category covers more ground than it used to. Premium full-spectrum infrared cabins, traditional outdoor barrels, plug-in budget units, and portable tents share the same Google searches and almost nothing else. This is the decision hub. Find your buyer-path below, then jump to the category guide that fits.
      </p>
    </header>

    <AdvertiserDisclosure />

    <section id="find-your-sauna" class="bg-amber-50 border border-amber-200 rounded-xl p-6 mb-10" aria-label="Find your sauna decision tree">
      <h2 class="text-xl font-bold text-stone-900 mb-2">Find your sauna</h2>
      <p class="text-sm text-stone-700 mb-5">Six buyer paths. Pick the one that matches your situation and jump to the category guide that fits.</p>
      <ul class="grid sm:grid-cols-2 gap-4 text-sm text-stone-700">
        <li class="bg-white rounded-lg p-4 border border-amber-100">
          <p class="font-bold text-stone-900 mb-1">Small space or apartment</p>
          <p class="mb-2">Indoor plug-in cabin, infrared blanket, or 1-person unit. No 240V, no outdoor footprint.</p>
          <a href="/guides/best-1-person-sauna/" class="text-amber-700 hover:underline font-semibold">Best 1-Person Sauna &rarr;</a>
        </li>
        <li class="bg-white rounded-lg p-4 border border-amber-100">
          <p class="font-bold text-stone-900 mb-1">Family of 4 or more</p>
          <p class="mb-2">Larger barrel or cabin builds with enough bench space for the whole household plus guests.</p>
          <a href="/guides/best-4-person-sauna/" class="text-amber-700 hover:underline font-semibold">Best 4-Person Sauna &rarr;</a>
        </li>
        <li class="bg-white rounded-lg p-4 border border-amber-100">
          <p class="font-bold text-stone-900 mb-1">Outdoor backyard install</p>
          <p class="mb-2">Cedar barrels, cabin kits, wood-burning bundles. Built for weather and Finnish heat.</p>
          <a href="/guides/outdoor-sauna-for-sale/" class="text-amber-700 hover:underline font-semibold">Outdoor Sauna Guide &rarr;</a>
        </li>
        <li class="bg-white rounded-lg p-4 border border-amber-100">
          <p class="font-bold text-stone-900 mb-1">Budget under $3,000</p>
          <p class="mb-2">Plug-in indoor infrared cabins and entry-level portables. Honest options at this price.</p>
          <a href="/guides/best-saunas-under-2000/" class="text-amber-700 hover:underline font-semibold">Best Saunas Under $2,000 &rarr;</a>
        </li>
        <li class="bg-white rounded-lg p-4 border border-amber-100">
          <p class="font-bold text-stone-900 mb-1">Premium infrared</p>
          <p class="mb-2">Full-spectrum infrared cabins for daily wellness use, design-forward, plug-in install.</p>
          <a href="/guides/best-home-sauna/" class="text-amber-700 hover:underline font-semibold">Best Home Sauna &rarr;</a>
        </li>
        <li class="bg-white rounded-lg p-4 border border-amber-100">
          <p class="font-bold text-stone-900 mb-1">Red light therapy</p>
          <p class="mb-2">Integrated red light plus infrared cabins, or a sauna paired with a dedicated RLT panel.</p>
          <a href="/guides/best-infrared-sauna-blanket/" class="text-amber-700 hover:underline font-semibold">Infrared &amp; RLT Options &rarr;</a>
        </li>
      </ul>
    </section>

    <h2 class="text-2xl font-bold text-stone-900 mt-10 mb-4">Top picks at a glance</h2>
    <div class="overflow-x-auto mb-8">
      <table class="text-sm w-full border border-stone-200 rounded-lg [&_td]:align-top [&_th]:align-top">
        <thead class="bg-stone-100 text-stone-700">
          <tr class="text-left">
            <th class="p-2">Product</th>
            <th class="p-2">Category winner</th>
            <th class="p-2">Type</th>
            <th class="p-2">Capacity</th>
            <th class="p-2">Max temp</th>
            <th class="p-2">Electrical</th>
            <th class="p-2">Project-price check</th>
            <th class="p-2">Best for</th>
            <th class="p-2">Avoid if</th>
          </tr>
        </thead>
        <tbody class="text-stone-700">
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">Sun Home Equinox</td><td class="p-2">Best Overall Infrared</td><td class="p-2">Premium full-spectrum</td><td class="p-2">2</td><td class="p-2">~165 °F</td><td class="p-2">120V</td><td class="p-2">$7k-$10k</td><td class="p-2">Daily wellness use</td><td class="p-2">Want löyly</td></tr>
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">AH Pinnacle 4P</td><td class="p-2">Traditional shortlist</td><td class="p-2">Cedar barrel</td><td class="p-2">Up to 4</td><td class="p-2">Check heater manual</td><td class="p-2">240V/30A listed</td><td class="p-2">Price full project</td><td class="p-2">Outdoor barrel kit</td><td class="p-2">Need turnkey scope</td></tr>
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">Sun Home Luminar</td><td class="p-2">Best Outdoor Infrared</td><td class="p-2">Premium outdoor infrared</td><td class="p-2">2</td><td class="p-2">~140 °F</td><td class="p-2">120V</td><td class="p-2">$8k-$12k</td><td class="p-2">Finished outdoor cabin</td><td class="p-2">Want löyly</td></tr>
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">Sun Home Eclipse</td><td class="p-2">Best Red Light + Infrared</td><td class="p-2">RLT + infrared</td><td class="p-2">2</td><td class="p-2">~165 °F</td><td class="p-2">120V</td><td class="p-2">$8k-$11k</td><td class="p-2">Integrated RLT</td><td class="p-2">Only want one</td></tr>
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">Dynamic Barcelona</td><td class="p-2">Compact infrared shortlist</td><td class="p-2">Far-infrared</td><td class="p-2">1-2 published</td><td class="p-2">Not published on source checked</td><td class="p-2">120V/15A</td><td class="p-2">Check current seller</td><td class="p-2">Small indoor footprint</td><td class="p-2">Want stones and steam</td></tr>
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">Dundalk LeisureCraft</td><td class="p-2">Outdoor collection shortlist</td><td class="p-2">Multiple outdoor formats</td><td class="p-2">Varies</td><td class="p-2">Varies by heater</td><td class="p-2">Varies by heater</td><td class="p-2">Get exact-model quote</td><td class="p-2">Compare outdoor formats</td><td class="p-2">Need one fixed spec</td></tr>
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">SereneLife Portable</td><td class="p-2">Portable steam shortlist</td><td class="p-2">Steam tent</td><td class="p-2">1</td><td class="p-2">122 F listed</td><td class="p-2">120V</td><td class="p-2">Check current seller</td><td class="p-2">Foldable setup</td><td class="p-2">Want a cabin</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-stone-900 mt-10 mb-4">How we choose</h2>
    <p class="text-stone-700 mb-4">This is a desk-researched buyer-fit shortlist, not a hands-on test or a universal ranking. For non-partner products, we checked current manufacturer materials, manuals, warranty language, and live retailer pages where available. We prioritized documented dimensions, electrical requirements, delivery and installation scope, limitations, and the questions a buyer still needs answered. Pricing, stock, configurations, and warranty terms can change, so recheck the exact listing and documents before ordering.</p>
    <p class="text-stone-700 mb-8">Sun Home appears in three slots because Sun Home actually wins those categories: Equinox for premium indoor infrared, Eclipse for integrated red-light and infrared, Luminar for outdoor infrared. We do not co-elevate them with traditional picks and we do not stack them into categories that do not fit.</p>

    <div class="bg-stone-900 text-white rounded-xl p-6 mb-10">
      <h2 class="text-xl font-bold text-white mb-2">Not sure which format fits the project?</h2>
      <p class="text-sm text-stone-200 mb-4">Build a private project brief with your space, budget, heat preference, electrical readiness, delivery constraints, and timeline. Nothing is submitted unless you choose manual review.</p>
      <a href="/sauna-planner/?utm_source=best_saunas&utm_medium=site&utm_campaign=planner_first_10&utm_content=best_saunas_before_products" class="inline-flex min-h-11 items-center rounded-md bg-amber-400 px-5 py-3 font-semibold text-stone-900 hover:bg-amber-500" data-track-event="planner_cta_clicked" data-cta-position="best_saunas_before_products">Build your sauna brief</a>
    </div>

    {picks.map(p => <ProductCard {...p} />)}

    <h2 class="text-2xl font-bold text-stone-900 mt-10 mb-4">FAQ</h2>
