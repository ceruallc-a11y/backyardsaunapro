const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Best Home Saunas of 2026",
  "datePublished": datePublished,
  "dateModified": dateModified,
  "author": { "@type": "Person", "name": "Aurec Senenoi", "url": "https://backyardsaunapro.com/about/" },
  "publisher": {
    "@type": "Organization",
    "name": "Backyard Sauna Pro",
    "logo": { "@type": "ImageObject", "url": "https://backyardsaunapro.com/images/brand/logo-icon.svg" }
  },
  "mainEntityOfPage": pageUrl
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://backyardsaunapro.com/" },
    { "@type": "ListItem", "position": 2, "name": "Best Home Saunas of 2026", "item": pageUrl }
  ]
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Best Home Saunas of 2026",
  "itemListElement": picks.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": { "@type": "Product", "name": p.name, "category": p.specs.type, "description": p.verdict }
  }))
};

const faqs = [
  { q: "Indoor vs outdoor sauna, which should I buy?", a: "Indoor saunas (typically infrared cabins) plug into 120V, install in a basement or spare room, and avoid weather concerns. Outdoor saunas (typically traditional barrel or cabin builds) need a foundation pad, often a 240V circuit, and deliver the higher heat and löyly that infrared cannot. If you have outdoor space and want real Finnish heat, go outdoor traditional. If space is tight and you want daily wellness sessions, go indoor infrared." },
  { q: "Infrared vs traditional sauna, what is the difference?", a: "Infrared saunas heat your body directly with infrared light at ambient temperatures of 120-150 °F. Traditional saunas heat the air to 170-195 °F with a rock-and-element heater and let you throw water on rocks for steam. Infrared sessions run 30-45 minutes and feel gentler. Traditional sessions run 10-20 minutes and feel intense. Neither is objectively better." },
  { q: "What is the best sauna under $3,000?", a: "Under $3,000, your strongest options are a plug-in indoor infrared cabin like the Dynamic Saunas Barcelona or a budget outdoor barrel kit. Premium full-spectrum infrared and premium outdoor cabins do not fit this budget. If you cannot run 240V, infrared is the right call. If you have outdoor space and a friend with an electrician's license, a budget barrel sauna becomes viable." },
  { q: "What should I skip when buying a sauna?", a: "Skip any cabin that does not publish EMF ratings, skip cedar premiums on infrared cabins that never exceed 140 °F (cedar matters at traditional temperatures), skip strip-LED 'red light' marketing that is not backed by published irradiance numbers, and skip extended warranties on portable units where the failure point is usually the zipper anyway." },
  { q: "Do I need 240V for a home sauna?", a: "For traditional saunas, almost always yes (typically 30A for 6kW, 40A for 8kW). For infrared cabins under 2kW, no, a standard 120V outlet works. Portable tent-style units run 120V. If running 240V is a dealbreaker, that narrows your decision tree to infrared or portable." },
  { q: "How much space does a home sauna need?", a: "Plan for the cabin footprint plus 12 in of clearance on all sides for airflow, plus full door swing clearance. A 2-person infrared needs about 4 ft x 4 ft of floor space. A 4-person outdoor barrel needs about 7 ft x 7 ft of pad, plus access for assembly. See our space planning guide for full breakdowns." },
  { q: "How long do home saunas last?", a: "Quality cedar barrel saunas with normal maintenance last 15-20 years. Premium infrared cabins are designed for similar lifespans, though the category is too young in the market for clean longevity data. Budget plug-in infrared cabins typically run 7-12 years before electronics need replacement. Portable units run 2-4 years with regular use." },
  { q: "What maintenance does a home sauna need?", a: "Indoor infrared cabins need a wipe-down after sessions and the occasional vacuum. Outdoor cedar barrels need a band re-tighten in the first 30 days, exterior treatment every 1-2 years, and a heater rock replacement every 2-3 years. Wood-burning units add chimney cleaning and ash management. None of it is heavy work; it is just real work." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<Base
  title="Best Home Saunas of 2026: Top Picks for Every Budget"
  description="Our top home sauna picks for 2026. Premium infrared, traditional barrels, budget plug-ins, and portables. Real picks, honest tradeoffs, decision tree to find your fit."
  canonical="/best-saunas"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-3xl mx-auto">
    <header class="mb-8">
      <p class="text-sm text-amber-700 font-semibold uppercase tracking-wide mb-2">Best Picks</p>
      <h1 class="text-4xl font-bold text-stone-900 leading-tight mb-3">
        Best Home Saunas of 2026
      </h1>
      <p class="text-sm text-stone-500 italic mb-4">
        By <a href="/about/" class="hover:text-amber-700 underline-offset-2 hover:underline">Aurec Senenoi</a> · Updated {updated} · Price checked {priceChecked}
      </p>
      <p class="text-lg text-stone-600">
        The home-sauna category covers more ground than it used to. Premium full-spectrum infrared cabins, traditional outdoor barrels, plug-in budget units, and portable tents share the same Google searches and almost nothing else. This is the decision hub. Find your buyer-path below, then jump to the category guide that fits.
      </p>
    </header>

    <AdvertiserDisclosure />

    <section class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8" aria-label="Find your sauna decision tree">
      <h2 class="font-bold text-stone-800 mb-3">Find your sauna</h2>
      <p class="text-sm text-stone-700 mb-4">Pick the path that matches your situation. Each leads to the right category guide.</p>
      <ul class="space-y-3 text-sm text-stone-700">
        <li>
          <strong>I want an outdoor sauna with real Finnish heat.</strong> Go to <a href="/guides/best-outdoor-sauna-of-2026/" class="text-amber-700 hover:underline font-semibold">Best Outdoor Sauna of 2026</a>. Cedar barrels, wood-burning bundles, and premium outdoor infrared all live there.
        </li>
        <li>
          <strong>I want an indoor infrared cabin for daily wellness sessions.</strong> Go to <a href="/guides/best-infrared-sauna-of-2026/" class="text-amber-700 hover:underline font-semibold">Best Infrared Sauna of 2026</a>. Premium full-spectrum, red light, budget plug-ins, and portables all live there.
        </li>
        <li>
          <strong>I want infrared (lower heat, longer sessions) vs traditional (high heat, löyly).</strong> Start with our <a href="/guides/infrared-vs-traditional-sauna/" class="text-amber-700 hover:underline font-semibold">infrared vs traditional comparison</a>.
        </li>
        <li>
          <strong>I have under $3,000 to spend.</strong> See <a href="/guides/best-saunas-under-2000/" class="text-amber-700 hover:underline font-semibold">Best Saunas Under $2,000</a> for plug-in options, or <a href="/guides/best-saunas-under-5000/" class="text-amber-700 hover:underline font-semibold">Best Saunas Under $5,000</a> for a budget outdoor barrel build.
        </li>
        <li>
          <strong>I rent, travel, or just want to try a sauna without a real install.</strong> See <a href="/guides/best-portable-sauna/" class="text-amber-700 hover:underline font-semibold">Best Portable Sauna</a>.
        </li>
      </ul>
    </section>

    <h2 class="text-2xl font-bold text-stone-900 mt-10 mb-4">Top picks at a glance</h2>
    <div class="overflow-x-auto mb-8">
      <table class="text-sm w-full border border-stone-200 rounded-lg">
        <thead class="bg-stone-100 text-stone-700">
          <tr class="text-left">
            <th class="p-2">Product</th>
            <th class="p-2">Category winner</th>
            <th class="p-2">Type</th>
            <th class="p-2">Capacity</th>
            <th class="p-2">Max temp</th>
            <th class="p-2">Electrical</th>
            <th class="p-2">Typical installed</th>
            <th class="p-2">Best for</th>
            <th class="p-2">Avoid if</th>
          </tr>
        </thead>
        <tbody class="text-stone-700">
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">Sun Home Equinox</td><td class="p-2">Best Overall Infrared</td><td class="p-2">Premium full-spectrum</td><td class="p-2">2</td><td class="p-2">~165 °F</td><td class="p-2">120V</td><td class="p-2">$7k-$10k</td><td class="p-2">Daily wellness use</td><td class="p-2">Want löyly</td></tr>
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">AH Pinnacle 4P</td><td class="p-2">Best Traditional</td><td class="p-2">Cedar barrel</td><td class="p-2">4</td><td class="p-2">~190 °F</td><td class="p-2">240V/30A</td><td class="p-2">$4k-$6k</td><td class="p-2">Real Finnish heat</td><td class="p-2">No 240V access</td></tr>
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">Sun Home Luminar</td><td class="p-2">Best Outdoor Infrared</td><td class="p-2">Premium outdoor infrared</td><td class="p-2">2</td><td class="p-2">~140 °F</td><td class="p-2">120V</td><td class="p-2">$8k-$12k</td><td class="p-2">Finished outdoor cabin</td><td class="p-2">Want löyly</td></tr>
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">Sun Home Eclipse</td><td class="p-2">Best Red Light + Infrared</td><td class="p-2">RLT + infrared</td><td class="p-2">2</td><td class="p-2">~165 °F</td><td class="p-2">120V</td><td class="p-2">$8k-$11k</td><td class="p-2">Integrated RLT</td><td class="p-2">Only want one</td></tr>
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">Dynamic Barcelona</td><td class="p-2">Best Budget</td><td class="p-2">Far-only infrared</td><td class="p-2">1-2</td><td class="p-2">~140 °F</td><td class="p-2">120V</td><td class="p-2">$1.2k-$1.5k</td><td class="p-2">First-time buyers</td><td class="p-2">Want full-spectrum</td></tr>
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">Dundalk Harmony</td><td class="p-2">Best Premium Traditional</td><td class="p-2">Cedar outdoor</td><td class="p-2">2</td><td class="p-2">~195 °F</td><td class="p-2">240V</td><td class="p-2">$6k-$9k</td><td class="p-2">Premium traditional</td><td class="p-2">Want plug-and-play</td></tr>
          <tr class="border-t border-stone-200"><td class="p-2 font-semibold">SereneLife Portable</td><td class="p-2">Best Portable</td><td class="p-2">Tent-style</td><td class="p-2">1</td><td class="p-2">~150 °F</td><td class="p-2">120V</td><td class="p-2">Under $200</td><td class="p-2">Travel, trial</td><td class="p-2">Want real cabin</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-stone-900 mt-10 mb-4">How we choose</h2>
    <p class="text-stone-700 mb-4">Every sauna on this list was evaluated on build quality and materials, ease of assembly, real customer reviews (we read the three-star ones), energy efficiency, warranty, and long-term durability reports. We do not recommend products we would not stand behind.</p>
    <p class="text-stone-700 mb-8">Sun Home appears in three slots because Sun Home actually wins those categories: Equinox for premium indoor infrared, Eclipse for integrated red-light and infrared, Luminar for outdoor infrared. We do not co-elevate them with traditional picks and we do not stack them into categories that do not fit.</p>

    {picks.map(p => <ProductCard {...p} />)}

    <h2 class="text-2xl font-bold text-stone-900 mt-10 mb-4">FAQ</h2>
    <div class="space-y-3 mb-8">
      {faqs.map(f => (
        <details class="border border-stone-200 rounded-lg p-4 bg-white">
          <summary class="font-bold text-stone-900 cursor-pointer">{f.q}</summary>
          <p class="text-stone-700 mt-2 text-sm">{f.a}</p>
        </details>
      ))}
    </div>

    <section class="mt-10">
      <h2 class="text-2xl font-bold mb-4 text-stone-900">More guides</h2>
      <ul class="space-y-2">
        <li><a href="/guides/best-outdoor-sauna-of-2026/" class="text-amber-700 hover:underline">Best Outdoor Sauna of 2026</a></li>
        <li><a href="/guides/best-infrared-sauna-of-2026/" class="text-amber-700 hover:underline">Best Infrared Sauna of 2026</a></li>
        <li><a href="/guides/infrared-vs-traditional-sauna/" class="text-amber-700 hover:underline">Infrared vs Traditional Sauna</a></li>
        <li><a href="/guides/best-saunas-under-2000/" class="text-amber-700 hover:underline">Best Saunas Under $2,000</a></li>
        <li><a href="/guides/how-to-assemble-barrel-sauna/" class="text-amber-700 hover:underline">How to Install a Barrel Sauna</a></li>
      </ul>
    </section>
  </article>
</Base>
