---
import Base from '../layouts/Base.astro';
import AdvertiserDisclosure from '../components/AdvertiserDisclosure.astro';
import ProductCard from '../components/ProductCard.astro';

const updated = "May 15, 2026";
const priceChecked = "May 15, 2026";
const datePublished = "2026-01-15";
