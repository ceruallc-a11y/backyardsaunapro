---
import AmazonButton from './AmazonButton.astro';
import SelectSaunasButton from './SelectSaunasButton.astro';
import SunHomeButton from './SunHomeButton.astro';

export interface Specs {
  type?: string;
  capacity?: string;
  heatSource?: string;
  maxTemp?: string;
  electrical?: string;
  dimensions?: string;
  warranty?: string;
  priceBand?: string;
}

export interface Props {
  rank?: number;
  tag: string;
  tagColor?: string;
  name: string;
  image?: string;
  imageAlt?: string;
  imageContain?: boolean;
  verdict: string;
  bestFor: string;
  avoidIf: string;
  specs: Specs;
  whyItWon: string;
  tradeoffs: string[];
  ownerComplaints?: string[];
  installationNotes?: string;
  sponsor?: 'sun-home' | null;
  sunHomeProduct?: string;
  sunHomeLabel?: string;
  asin?: string;
  selectSaunasCollection?: string;
  selectSaunasLabel?: string;
}

const {
  rank,
  tag,
  tagColor = 'bg-amber-100 text-amber-800',
  name,
  image,
  imageAlt,
  imageContain = false,
  verdict,
  bestFor,
  avoidIf,
  specs,
  whyItWon,
  tradeoffs,
  ownerComplaints = [],
  installationNotes,
  sponsor,
  sunHomeProduct,
  sunHomeLabel,
  asin,
  selectSaunasCollection,
  selectSaunasLabel = 'Shop on Select Saunas',
} = Astro.props;

const isSunHome = sponsor === 'sun-home';
const wrapperClass = isSunHome
  ? 'border border-stone-300 rounded-xl overflow-hidden bg-stone-50 mb-8'
  : 'border border-stone-200 rounded-xl overflow-hidden bg-white mb-8';

const specRows: [string, string | undefined][] = [
  ['Type', specs.type],
  ['Capacity', specs.capacity],
  ['Heat source', specs.heatSource],
  ['Max temp', specs.maxTemp],
  ['Electrical', specs.electrical],
  ['Dimensions', specs.dimensions],
  ['Warranty', specs.warranty],
  ['Price band', specs.priceBand],
];
---
<div class={wrapperClass}>
  {image && (
    <div class={imageContain ? 'bg-white p-5' : 'overflow-hidden'}>
      <img
        src={image}
        alt={imageAlt || name}
        class={imageContain ? 'w-full h-auto object-contain max-h-80 mx-auto' : 'w-full h-auto object-cover max-h-80'}
        loading="lazy"
        width="1600"
        height="1067"
      />
    </div>
  )}
  <div class="p-6">
    <div class="flex items-center gap-2 mb-2">
      <span class={`text-xs font-semibold px-2 py-0.5 rounded-full uppercase tracking-wide ${tagColor}`}>
        {rank ? `#${rank} ${tag}` : tag}
      </span>
      {specs.type && <span class="text-xs text-stone-400">{specs.type}</span>}
    </div>
    <h3 class="text-2xl font-bold text-stone-900 mb-2">{name}</h3>
    <p class="text-stone-700 mb-4"><strong class="text-stone-900">Verdict:</strong> {verdict}</p>

    <div class="grid md:grid-cols-2 gap-4 mb-5">
      <div class="bg-white border border-stone-200 rounded-lg p-4 text-sm text-stone-700">
        <strong class="block text-stone-900 mb-1">Best for</strong>
        {bestFor}
      </div>
      <div class="bg-white border border-stone-200 rounded-lg p-4 text-sm text-stone-700">
        <strong class="block text-stone-900 mb-1">Avoid if</strong>
        {avoidIf}
      </div>
    </div>

    <div class="mb-5">
      <h4 class="text-sm font-bold text-stone-900 mb-2">Key specs</h4>
      <div class="overflow-x-auto">
        <table class="text-sm w-full">
          <tbody class="text-stone-700">
            {specRows.filter(([, v]) => v).map(([label, value]) => (
              <tr class="border-b border-stone-100 last:border-0">
                <td class="py-1.5 pr-4 text-stone-500 w-40">{label}</td>
                <td class="py-1.5">{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mb-4">
      <h4 class="text-sm font-bold text-green-700 mb-1">Why it won</h4>
      <p class="text-sm text-stone-700">{whyItWon}</p>
    </div>

    <div class="mb-4">
      <h4 class="text-sm font-bold text-amber-700 mb-1">Tradeoffs</h4>
      <ul class="text-sm text-stone-700 list-disc pl-5 space-y-1">
        {tradeoffs.map(t => <li>{t}</li>)}
      </ul>
    </div>

    {ownerComplaints.length > 0 && (
      <div class="mb-4">
        <h4 class="text-sm font-bold text-red-600 mb-1">Owner-complaint patterns</h4>
        <ul class="text-sm text-stone-700 list-disc pl-5 space-y-1">
          {ownerComplaints.map(c => <li>{c}</li>)}
        </ul>
      </div>
    )}

    {installationNotes && (
      <div class="mb-5">
        <h4 class="text-sm font-bold text-blue-700 mb-1">Installation notes</h4>
        <p class="text-sm text-stone-700">{installationNotes}</p>
      </div>
    )}

    <div class="flex flex-wrap gap-3">
      {isSunHome && sunHomeProduct ? (
        <SunHomeButton product={sunHomeProduct} label={sunHomeLabel || `See Sun Home ${sunHomeProduct.charAt(0).toUpperCase() + sunHomeProduct.slice(1)}`} />
      ) : (
        <>
          {asin && <AmazonButton asin={asin} />}
          {selectSaunasCollection && <SelectSaunasButton collection={selectSaunasCollection} label={selectSaunasLabel} />}
        </>
      )}
    </div>
  </div>
</div>
