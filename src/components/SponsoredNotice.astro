---
// SponsoredNotice.astro
// FTC 16 CFR Part 255 material-connection disclosure for paid placements.
// Editorial-typography treatment (italic, small, gray) satisfies the
// 'clear and conspicuous' requirement while reading as in-line note
// rather than a commercial badge. Must appear adjacent to the recommendation
// it discloses; do not move to footer or rely on page-level disclosure alone.
const { brand = "Sun Home Saunas" } = Astro.props;
---
<p class="text-xs italic text-stone-500 mb-3">{brand} is a paid Backyard Sauna Pro partner.</p>
