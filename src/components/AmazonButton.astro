---
export interface Props {
  asin?: string;
  search?: string;
  href?: string;
  slug?: string;
  label?: string;
  price?: string;
  variant?: "primary" | "outline" | "small" | "default";
  ctaPosition?: string;
  class?: string;
}
const {
  asin,
  search,
  href,
  slug,
  label = "Check Price on Amazon",
  price: _price,
  variant = "default",
  ctaPosition = variant === "default" ? "featured" : "product_card",
  class: extraClass = "",
} = Astro.props;

const tag = "backyardsauna-20";
// Derive slug from page URL when not explicitly provided.
const pathname = Astro.url?.pathname ?? "/";
const derivedSlug =
  slug ??
  (pathname
    .replace(/\/+$/, "")
    .split("/")
    .filter(Boolean)
    .pop() ?? "home");
const ascsubtag = `bsp_${derivedSlug}`;

// These older cabin/tent ASINs have produced unavailable or mismatched product
// pages. Search links preserve attribution while showing current matching stock.
const availabilitySearches: Record<string, string> = {
  B000R2PTHG: "Almost Heaven Allegheny barrel sauna",
  B003YH9DXG: "Dynamic Saunas Andora 1 person infrared sauna",
  B003Z11AXM: "Almost Heaven 6 person barrel sauna",
  B00A2F99F0: "Dynamic Saunas Barcelona 1-2 person infrared sauna",
  B017WJV8SO: "Almost Heaven Pinnacle 4 person barrel sauna",
  B07RLPBK5V: "Dynamic Saunas Lugano 3 person infrared sauna",
  B07T9WBMSG: "portable infrared sauna cabin",
  B084FCQHBG: "Radiant Saunas 2 person infrared sauna",
  B084GY5CHB: "SereneLife full size portable steam sauna",
  B0DPG3R7PR: "outdoor barrel sauna wood stove kit",
};
const availabilitySearch = asin ? availabilitySearches[asin] : undefined;
const effectiveLabel = availabilitySearch ? "Compare Current Amazon Listings" : label;

let url: string;
if (availabilitySearch) {
  url = `https://www.amazon.com/s?k=${encodeURIComponent(availabilitySearch)}&tag=${tag}&ascsubtag=${ascsubtag}`;
} else if (asin) {
  url = `https://www.amazon.com/dp/${asin}?tag=${tag}&ascsubtag=${ascsubtag}`;
} else if (search) {
  url = `https://www.amazon.com/s?k=${encodeURIComponent(search)}&tag=${tag}&ascsubtag=${ascsubtag}`;
} else if (href) {
  // Strip any pre-existing tag, then add our tag + ascsubtag.
  let base = href.replace(/([?&])tag=[^&]*/g, "$1").replace(/[?&]$/, "");
  const sep = base.includes("?") ? "&" : "?";
  url = `${base}${sep}tag=${tag}&ascsubtag=${ascsubtag}`;
} else {
  url = `https://www.amazon.com/?tag=${tag}&ascsubtag=${ascsubtag}`;
}

const styles: Record<string, string> = {
  default:
    "inline-block bg-amber-400 hover:bg-amber-500 text-stone-900 font-semibold px-6 py-3 rounded-lg transition-colors shadow",
  primary:
    "inline-block bg-amber-500 hover:bg-amber-600 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm",
  outline:
    "inline-block border border-amber-400 text-amber-700 font-semibold px-4 py-2 rounded-lg text-sm hover:bg-amber-50 transition-colors",
  small:
    "inline-block bg-amber-500 hover:bg-amber-600 text-white font-semibold px-4 py-2 rounded-lg transition-colors text-sm",
};
const cls = `${styles[variant] ?? styles.default} ${extraClass}`.trim();
const arrow = variant === "default" ? " \u2192" : "";
---
<a
  href={url}
  target="_blank"
  rel="nofollow noopener sponsored"
  class={cls}
  data-cta-position={ctaPosition}
  data-product-id={asin || search || derivedSlug}
  data-link-mode={availabilitySearch ? "availability_search" : asin ? "exact_product" : search ? "search" : "external"}
>
  {effectiveLabel}{arrow}
</a>
