---
// AdvertiserDisclosure.astro
// Forbes Advisor-style: ultra-subtle grey link, top-right of article.
// Above-the-fold placement preserves FTC 16 CFR Part 255 clear-and-conspicuous
// requirement while staying out of the editorial visual hierarchy.
const { brand = "Sun Home Saunas", variant = "default" } = Astro.props;
const isHero = variant === "hero";
---

<div class:list={["not-prose flex", isHero ? "justify-start mb-5" : "justify-end mb-1 -mt-2"]}>
  <details class="group inline-block text-right relative">
    <summary
      class:list={[
        "cursor-pointer text-[11px] list-none select-none transition-colors",
        isHero ? "text-white/70 hover:text-white" : "uppercase tracking-wide text-stone-300 hover:text-stone-500",
      ]}
    >
      Advertiser Disclosure
    </summary>
    <div
      class:list={[
        "absolute mt-1 w-72 z-10 text-left text-[11px] leading-snug text-stone-600 border border-stone-200 bg-white rounded-md p-2.5 shadow-sm",
        isHero ? "left-0" : "right-0",
      ]}
    >
      Backyard Sauna Pro writers and editors independently select all products. If you click through links we provide, we may earn a commission.
    </div>
  </details>
</div>
