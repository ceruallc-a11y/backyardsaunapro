---
// NewsletterSignup.astro
// Footer-mounted email capture, Kit form ID: 9452008 (UID b7d6fe4c1e)
---

<section class="newsletter-cta text-stone-100 pb-9 mb-8 border-b border-white/10">
  <div class="grid lg:grid-cols-[0.9fr_1.1fr] lg:items-end gap-6 lg:gap-14">
    <div class="flex-1">
      <p class="text-sm font-semibold text-[#e6a23a] mb-2">Plan before you purchase</p>
      <h2 class="display-type text-2xl md:text-3xl text-white leading-tight mb-2">Get the outdoor sauna buying checklist.</h2>
      <p class="text-sm text-white/70 max-w-[56ch]">A verification-first check for the site, foundation, heater, permits, freight, warranty, and full project budget.</p>
    </div>
    <div>
      <form action="https://app.kit.com/forms/9452008/subscriptions" method="post" data-sv-form="9452008" data-uid="b7d6fe4c1e" data-format="inline" data-version="5" data-form-location="footer" class="kit-form grid sm:grid-cols-[1fr_auto] gap-3 items-end">
        <div>
          <label for="footer-checklist-email" class="block text-xs font-semibold text-white/80 mb-2">Email address</label>
          <input id="footer-checklist-email" type="email" name="email_address" placeholder="you@example.com" required class="kit-email-input w-full min-h-12 px-4 py-3 rounded-md border border-white/25 bg-white/10 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-[#e6a23a]" />
        </div>
        <button type="submit" class="kit-submit-btn min-h-12 bg-[#e6a23a] hover:bg-[#f0b253] text-[#0b211a] font-bold px-5 py-3 rounded-md whitespace-nowrap">Send checklist</button>
      </form>
      <p class="kit-fine-print text-xs text-white/50 mt-2">Checklist plus occasional buyer guidance. Unsubscribe anytime.</p>
    </div>
  </div>
</section>
